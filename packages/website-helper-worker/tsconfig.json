{
  "include": ["src"],
  "exclude": ["node_modules", "dist"],
  "compilerOptions": {
    /* Environment: Cloudflare Workers (workerd), bundled by wrangler/esbuild. */
    "target": "es2024",
    "lib": ["es2024"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "resolveJsonModule": true,

    /* Emit is wrangler's job. */
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true,

    /* Interop */
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,

    /* Type checking */
    "strict": true,
    "skipLibCheck": true
  }
}
