---
/**
 * Renders one Envelop content entry (the current docs or an older major)
 * inside the Envelop docs chrome, with the MDX components the content uses.
 */
import Callout from '~hive/components/mdx/Callout.astro';
import Card from '~hive/components/mdx/Card.astro';
import CardsBase from '~hive/components/mdx/Cards.astro';
import CodeBlock from '~hive/components/mdx/CodeBlock.astro';
import File from '~hive/components/mdx/File.astro';
import FileTreeBase from '~hive/components/mdx/Files.astro';
import Folder from '~hive/components/mdx/Folder.astro';
import PackageManagerTabs from '~hive/components/mdx/PackageManagerTabs.astro';
import Steps from '~hive/components/mdx/Steps.astro';
import PackageManagerTab from '~hive/components/mdx/Tab.astro';
import Tab from '~hive/components/mdx/Tab.astro';
import Table from '~hive/components/mdx/Table.astro';
import TabsBase from '~hive/components/mdx/Tabs.astro';
import { getHeadingHtmlBySlug } from '~hive/lib/docs-markdown';
import { render } from 'astro:content';
import type { DocsNav } from '../../docs/nav';
import EnvelopDocsLayout from '../layouts/EnvelopDocsLayout.astro';
import { withBase } from '../lib/base-path';
import {
  CURRENT_VERSION,
  ENVELOP_REPO_URL,
  LEGACY_VERSIONS,
  type LegacyVersion,
} from '../lib/site';
import VersionSwitch from './VersionSwitch.astro';

interface Props {
  /** Mount-relative root of the section: /docs, /v3, /v2. */
  docsBase: string;
  entry: {
    body?: string;
    data: { description?: string; sidebarTitle?: string; title?: string };
    filePath?: string;
    id: string;
  };
  /** Path of the source file in the Yoga repo, for the "edit this page" link. */
  githubPath: string;
  /** Older major this page documents; shows the legacy banner. */
  legacyVersion?: LegacyVersion;
  nav: DocsNav;
  searchSection: string;
  /** Title suffix; defaults to the product name. */
  section?: string;
  /** Excluded from search: older majors. */
  searchable?: boolean;
  /** Entry id relative to the section (the collection id minus any version prefix). */
  sectionId: string;
}

const {
  docsBase,
  entry,
  githubPath,
  legacyVersion,
  nav,
  searchSection,
  searchable = true,
  section = 'Envelop',
  sectionId,
} = Astro.props;

const Tabs = Object.assign(TabsBase, { Tab });
const Cards = Object.assign(CardsBase, { Card });
const FileTree = Object.assign(FileTreeBase, { File, Folder });

const { Content, headings: renderedHeadings } = await render(entry as never);
const headingHtmlBySlug = getHeadingHtmlBySlug(entry.body ?? '', renderedHeadings);
const headings = renderedHeadings.map(heading => ({
  ...heading,
  html: headingHtmlBySlug.get(heading.slug) ?? heading.text,
}));
const slug = sectionId.replace(/(^|\/)index$/, '').replace(/\.(md|mdx)$/, '');
const currentPath = `${docsBase}${slug ? `/${slug}` : ''}`;
const { data } = entry;
const baseTitle =
  data.title ?? data.sidebarTitle ?? (sectionId.split('/').at(-1) ?? sectionId).replace(/-/g, ' ');
const description = legacyVersion
  ? `Envelop ${legacyVersion} documentation (superseded by ${CURRENT_VERSION}): ${data.description || baseTitle}`
  : data.description || `${baseTitle} — Envelop documentation.`;
// Each major's migration guide ships with the docs of the major it targets.
const migrationHref = withBase(
  legacyVersion === 'v2'
    ? '/v3/guides/migrating-from-v2-to-v3'
    : '/docs/guides/migrating-from-v3-to-v4',
);
---

<EnvelopDocsLayout
  currentPath={currentPath}
  description={description}
  docsBase={docsBase}
  githubUrl={`${ENVELOP_REPO_URL}/blob/main/${githubPath}`}
  headings={headings}
  longPage={(entry.body?.length ?? 0) > 60_000}
  navItems={nav.items}
  navTree={nav.tree}
  searchSection={searchSection}
  section={section}
  title={baseTitle}
>
  <VersionSwitch
    current={legacyVersion ?? CURRENT_VERSION}
    versions={[CURRENT_VERSION, ...LEGACY_VERSIONS]}
  />
  {
    legacyVersion && (
      <Callout
        title={`This is the documentation for the old Envelop ${legacyVersion}`}
        type="warning"
      >
        We recommend upgrading to the latest Envelop {CURRENT_VERSION}.{' '}
        <a href={migrationHref}>
          Migrate to Envelop {legacyVersion === 'v2' ? 'v3' : CURRENT_VERSION}
        </a>
        .
      </Callout>
    )
  }
  <div data-pagefind-ignore={searchable ? undefined : 'all'}>
    <Content
      components={{
        Callout,
        Cards,
        Card,
        FileTree,
        PackageManagerTab,
        PackageManagerTabs,
        Steps,
        Tabs,
        pre: CodeBlock,
        table: Table,
      }}
    />
  </div>
</EnvelopDocsLayout>
