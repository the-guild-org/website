---
import { getCollection, type CollectionEntry } from 'astro:content';
import EnvelopDocsPage from '../../../../envelop/components/EnvelopDocsPage.astro';
import { getEnvelopDocsNav } from '../../../../envelop/lib/docs-nav';

type Entry = CollectionEntry<'envelopDocs'>;

export async function getStaticPaths() {
  const entries = await getCollection('envelopDocs');
  return entries.map(entry => ({
    params: { slug: entry.id.replace(/(^|\/)index$/, '').replace(/\.(md|mdx)$/, '') || undefined },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: Entry };
const extension = entry.filePath?.match(/\.mdx?$/)?.[0] ?? '.mdx';
---

<EnvelopDocsPage
  docsBase="/docs"
  entry={entry}
  githubPath={`envelop-website/content/docs/${entry.id}${extension}`}
  nav={await getEnvelopDocsNav()}
  searchSection="Documentation"
  sectionId={entry.id}
/>
