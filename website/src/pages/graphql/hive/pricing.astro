<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <BaseHead
      description="Honest pricing plans for GraphQL Federation and other GraphQL APIs, supporting developers to enterprise with Open-Source schema registry, analytics, and gateway solutions"
      title="Hive Platform Pricing | Hive"
    />
  </head>
  <body class="text-green-1000 bg-white font-sans [color-scheme:light]">
    <SiteNavigation />
    <main class="text-green-1000 light mx-auto max-w-360 overflow-hidden">
      <!-- Hero -->
      <div class="bg-beige-100 relative isolate flex max-w-360 flex-col gap-6 overflow-hidden rounded-3xl px-4 py-6 sm:py-12 md:gap-8 lg:py-24 mx-4 max-sm:mt-2 md:mx-6">
        <div class="pointer-events-none absolute inset-0 overflow-hidden">
          <svg class="pointer-events-none absolute left-[-46px] top-[-20px] size-[200px] rotate-180 md:left-[-60px] md:top-[-188px] md:size-auto" height="432" preserveAspectRatio="xMidYMid meet" viewBox="0 0 432 432" width="432" xmlns="http://www.w3.org/2000/svg">
            <path d="M.75 431v.25h90.24V160.868c0-38.596 31.282-69.878 69.878-69.878H431.25V.75H191.864a47.017 47.017 0 0 0-33.23 13.771l-68.07 68.071-7.972 7.971-68.07 68.071A47.018 47.018 0 0 0 .75 191.864V431Z" fill="url(#pricing-hero-arch-a)" stroke="url(#pricing-hero-arch-b)" stroke-width=".5"></path>
          </svg>
          <svg class="pointer-events-none absolute bottom-0 right-[-53px] size-[200px] md:-bottom-32 md:size-auto lg:bottom-[-188px] lg:right-0" height="432" preserveAspectRatio="xMidYMid meet" viewBox="0 0 432 432" width="432" xmlns="http://www.w3.org/2000/svg">
            <path d="M.75 431v.25h90.24V160.868c0-38.596 31.282-69.878 69.878-69.878H431.25V.75H191.864a47.017 47.017 0 0 0-33.23 13.771l-68.07 68.071-7.972 7.971-68.07 68.071A47.018 47.018 0 0 0 .75 191.864V431Z" fill="url(#pricing-hero-arch-a)" stroke="url(#pricing-hero-arch-b)" stroke-width=".5"></path>
          </svg>
          <svg class="absolute -z-10" height="432" viewBox="0 0 432 432" width="432">
            <defs>
              <linearGradient gradientUnits="userSpaceOnUse" id="pricing-hero-arch-a" x1="48.5" x2="302.5" y1="53.5" y2="341"><stop stop-color="#fff" stop-opacity=".3"></stop><stop offset="1" stop-color="#fff" stop-opacity="1"></stop></linearGradient>
              <linearGradient gradientUnits="userSpaceOnUse" id="pricing-hero-arch-b" x1="1" x2="431" y1="1" y2="431"><stop stop-color="#fff" stop-opacity=".1"></stop><stop offset="1" stop-color="#fff" stop-opacity=".4"></stop></linearGradient>
            </defs>
          </svg>
        </div>
        <h1 class="group text-4xl leading-[1.2] md:text-[4rem] md:leading-[1.1875] tracking-[-0.64px] text-green-1000 z-0 mx-auto max-w-3xl text-center">Honest pricing plans for your API management</h1>
        <p class="z-0 mx-auto max-w-[80%] text-center leading-6 text-green-800">From hobbyists to enterprises — enjoy all features and usage-based pricing.</p>
      </div>

      <!-- Pricing: slider + plan cards -->
      <section class="py-12 sm:py-20 mx-4 md:mx-6">
        <div class="mx-auto box-border w-full max-w-[1200px]">
          <h3 class="group text-4xl leading-[1.2] md:text-5xl md:leading-[1.16667] tracking-[-0.48px] max-md:text-[32px]/10 max-sm:tracking-[-.16px]">Operations: learn more about usage-based pricing</h3>
          <p class="mt-6 text-green-800">Hive Console is completely free to use. We charge only for operations collected and processed.</p>

          <div class="relative isolate block select-none rounded-3xl border border-green-400 p-4 [counter-set:ops_calc(var(--ops))] sm:p-8 mt-6 lg:mt-12" id="pricing-slider-root" style="--ops:1">
            <div aria-hidden="true" class="text-green-1000 flex flex-wrap items-center font-medium md:h-12 md:w-[calc(100%-260px)]">
              <div class="w-full text-2xl">How many operations per month do you need?</div>
            </div>
            <div class="text-green-1000 flex flex-wrap items-center font-medium md:h-12 md:w-[calc(100%-260px)] text-lg">
              <div>
                <div class="flex w-full whitespace-pre rounded-[40px] bg-blue-300 px-3 py-1 tabular-nums leading-8 duration-[calc(clamp(0,var(--ops)-1,1)*350ms)] before:tracking-[-0.12em] before:content-[''_counter(ops)_'_'] motion-safe:transition-all">M</div>
              </div>
              <div class="whitespace-pre [@media(width<900px)]:hidden"> operations per month </div>
            </div>
            <div class="text-green-1000 flex items-center gap-5 pt-4 text-sm">
              <span class="font-medium">1M</span>
              <div class="hive-slider relative h-10 flex-1 select-none @container" id="operations-slider-wrap">
                <input
                  aria-label="How many operations per month do you need?"
                  class="h-10 w-full opacity-0 hover:cursor-grab active:cursor-grabbing"
                  id="operations-range"
                  max="1000"
                  min="1"
                  step="1"
                  tabindex="0"
                  type="range"
                  value="1"
                />
                <div class="bg-beige-300 pointer-events-none absolute top-[calc(50%-4px)] h-2 w-full rounded-lg [clip-path:inset(0_0_0_0_round_8px)] after:absolute after:inset-0 after:left-[-120%] after:w-[120%] after:translate-x-[calc(var(--val)*1cqi)] after:bg-blue-600"></div>
                <div class="pointer-events-none absolute left-0 top-0 z-20 flex size-10 select-none items-center justify-center rounded-full bg-blue-600 text-center" id="operations-thumb" style="transform: translateX(calc(var(--val) * (100cqi - 100%) / 100))">
                  <img alt="" height="24" src={codeIconWhite} width="24" />
                </div>
              </div>
              <span class="font-medium">1B</span>
            </div>

            <div class="mt-3 max-w-[600px]" hidden id="enterprise-hint">
              <div class="font-bold">Consider using our Enterprise plan.</div>
              For volumes over 300M operations per month, our Enterprise plan is cheaper, with bulk discounts, dedicated support, and custom SLAs. It also makes scaling past 1 billion operations much more cost-effective.
            </div>

            <div class="relative mt-6 md:absolute md:right-8 md:top-8 md:mt-0">
              <button class="relative flex items-center justify-center gap-2 text-nowrap rounded-lg px-6 py-3 font-medium leading-6 text-green-1000 bg-transparent focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-green-800 sm:w-fit" id="operations-info-button" type="button">
                <span class="absolute inset-0 rounded-lg border border-green-800"></span>
                <svg fill="currentColor" height="24" viewBox="0 0 24 24" width="24"><path d="M3.9 17.85V5.7A2.7 2.7 0 0 1 6.6 3h12.6a.9.9 0 0 1 .9.9v16.2a.9.9 0 0 1-.9.9H7.05a3.15 3.15 0 0 1-3.15-3.15Zm14.4 1.35v-2.7H7.05a1.35 1.35 0 1 0 0 2.7H18.3ZM5.7 15.003c.422-.2.883-.304 1.35-.303H18.3V4.8H6.6a.9.9 0 0 0-.9.9v9.303Z"></path></svg>
                Learn about operations
              </button>
              <div class="border-beige-400 bg-beige-100 text-green-1000 absolute bottom-full left-1/2 z-50 mb-2 md:min-w-[300px] max-w-[328px] -translate-x-1/2 overflow-visible rounded-2xl border px-4 py-3 shadow-md sm:max-w-[420px]" hidden id="operations-popover">
                Every GraphQL request that is processed by your GraphQL API and reported to Hive Console. If your server receives 1M GraphQL requests, all of them will be reported to Hive (assuming no sampling).
              </div>
            </div>
          </div>

          <div class="nextra-scrollbar -mx-4 -mb-6 flex flex-col items-stretch gap-6 px-4 py-6 sm:flex-row sm:overflow-auto sm:*:min-w-[380px] md:-mx-6 md:px-6" id="plans-scrollview">
            <!-- Hobby -->
            <div aria-hidden="true" class="fixed inset-0 z-40 bg-black/30 backdrop-blur-2xl transition-opacity duration-500 sm:hidden pointer-events-none opacity-0 data-[collapsed=false]:pointer-events-auto data-[collapsed=false]:opacity-100" data-backdrop-for="Hobby" data-collapsed="true"></div>
            <article class="plan-card relative isolate rounded-3xl bg-white shadow-[inset_0_0_0_1px_var(--color-green-400)] duration-200 before:absolute before:inset-0 before:-z-10 before:rounded-3xl before:bg-[linear-gradient(#fff,#fff),linear-gradient(to_bottom,#68A8B6,#DEDACF,#E1FF00)] before:p-1 before:opacity-0 before:transition-[opacity,top,height] before:content-[''] before:[background-clip:content-box,padding-box] before:duration-[50ms,25ms,25ms] sm:mt-13 sm:before:-top-10 data-[highlighted=true]:before:opacity-100 data-[collapsed=false]:before:opacity-100 max-sm:transition-[width,height,border-radius] max-sm:duration-700 max-sm:ease-in-out data-[collapsed=false]:max-sm:fixed data-[collapsed=false]:max-sm:inset-2 data-[collapsed=false]:max-sm:z-50 data-[collapsed=false]:max-sm:m-0 data-[collapsed=false]:max-sm:h-[calc(100vh-16px)] data-[collapsed=false]:max-sm:bg-white data-[highlighted=true]:sm:before:-top-13 data-[highlighted=true]:sm:before:h-[calc(100%+52px)] data-[highlighted=true]:sm:before:pt-12.5 data-[highlighted=true]:sm:before:delay-29 data-[highlighted=true]:sm:before:duration-[150ms,75ms,75ms]" data-collapsed="true" data-highlighted="true" data-plan="Hobby">
              <div class="p-4 max-sm:pb-0 sm:p-8 nextra-scrollbar data-[collapsed=false]:h-full data-[collapsed=false]:max-sm:overflow-auto" data-collapsed="true">
                <div aria-hidden="true" class="absolute -top-9 left-0 w-full text-center font-medium text-white transition-opacity max-sm:hidden opacity-0 data-[highlighted=true]:opacity-100" data-highlighted="true" data-recommended-label>Recommended</div>
                <header class="relative text-green-800">
                  <div class="flex flex-row items-center gap-2">
                    <h2 class="text-2xl font-medium">Hobby</h2>
                  </div>
                  <p class="mt-2">For personal or small projects</p>
                  <button aria-label="Close" class="absolute right-0 top-1 text-green-800 transition-opacity duration-700 ease-in-out sm:hidden hidden data-[collapsed=false]:block" data-close-card type="button">
                    <svg fill="none" height="15" viewBox="0 0 15 15" width="15" xmlns="http://www.w3.org/2000/svg" class="size-5"><path clip-rule="evenodd" d="M11.7816 4.03157C12.0062 3.80702 12.0062 3.44295 11.7816 3.2184C11.5571 2.99385 11.193 2.99385 10.9685 3.2184L7.50005 6.68682L4.03164 3.2184C3.80708 2.99385 3.44301 2.99385 3.21846 3.2184C2.99391 3.44295 2.99391 3.80702 3.21846 4.03157L6.68688 7.49999L3.21846 10.9684C2.99391 11.193 2.99391 11.557 3.21846 11.7816C3.44301 12.0061 3.80708 12.0061 4.03164 11.7816L7.50005 8.31316L10.9685 11.7816C11.193 12.0061 11.5571 12.0061 11.7816 11.7816C12.0062 11.557 12.0062 11.193 11.7816 10.9684L8.31322 7.49999L11.7816 4.03157Z" fill-rule="evenodd"></path></svg>
                  </button>
                </header>
                <div class="mt-4 h-6 text-[#4F6C6A] max-sm:h-0"></div>
                <div class="text-5xl/14 font-medium tracking-[-0.48px]">Free forever</div>
                <div class="mt-4 flex *:grow">
                  <a class="relative flex items-center justify-center gap-2 text-nowrap rounded-lg px-6 py-3 font-medium leading-6 text-green-1000 bg-transparent focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-green-800 sm:w-fit" href={withBase(appUrl)}>
                    <span class="absolute inset-0 rounded-lg border border-green-800"></span>
                    Get started for free
                  </a>
                </div>

                <ul class="text-green-800 sm:mt-6 sm:block sm:h-auto! sm:opacity-100! max-sm:overflow-hidden max-sm:transition-[max-height,opacity] max-sm:duration-500 max-sm:max-h-0 max-sm:opacity-0 data-[collapsed=false]:max-sm:max-h-[1200px] data-[collapsed=false]:max-sm:opacity-100" data-collapsed="true" data-open="false">
                  <li class="border-beige-200 flex flex-col px-1 py-2 text-sm text-[#4F6C6A] not-last:border-b">
                    <span class="relative inline-block">
                      <span class="hive-focus -mx-1 -my-0.5 rounded-sm px-1 py-0.5 text-left cursor-help tooltip-trigger" tabindex="0">
                        <strong class="flex h-6 items-center gap-2 font-bold [&>svg]:size-4 [&>svg]:text-green-600"><svg fill="currentColor" height="16" viewBox="0 0 16 16" width="16"><path d="M1.33337 7.99997C1.33337 7.42331 1.40671 6.86398 1.54404 6.33064C1.91235 6.35 2.27884 6.26714 2.603 6.09122C2.92716 5.9153 3.19636 5.65317 3.38084 5.3338C3.56533 5.01444 3.65791 4.65028 3.64836 4.28159C3.6388 3.91289 3.52748 3.55402 3.32671 3.24464C4.13277 2.45168 5.12728 1.87677 6.21671 1.57397C6.38403 1.90296 6.63913 2.17922 6.95376 2.37218C7.26839 2.56514 7.63028 2.66728 7.99937 2.66728C8.36846 2.66728 8.73035 2.56514 9.04499 2.37218C9.35962 2.17922 9.61471 1.90296 9.78204 1.57397C10.8715 1.87677 11.866 2.45168 12.672 3.24464C12.471 3.55408 12.3596 3.91309 12.3499 4.28195C12.3403 4.65082 12.4329 5.01515 12.6175 5.33465C12.8021 5.65415 13.0715 5.91635 13.3958 6.09225C13.7202 6.26815 14.0869 6.35089 14.4554 6.33131C14.5927 6.86464 14.666 7.42331 14.666 7.99997C14.666 8.57597 14.5927 9.13531 14.4554 9.66864C14.0869 9.64906 13.7202 9.7318 13.3958 9.9077C13.0715 10.0836 12.8021 10.3458 12.6175 10.6653C12.4329 10.9848 12.3403 11.3491 12.3499 11.718C12.3596 12.0869 12.471 12.4459 12.672 12.7553C11.8659 13.548 10.8714 14.1227 9.78204 14.4253C9.61471 14.0963 9.35962 13.8201 9.04499 13.6271C8.73035 13.4341 8.36846 13.332 7.99937 13.332C7.63028 13.332 7.26839 13.4341 6.95376 13.6271C6.63913 13.8201 6.38403 14.0963 6.21671 14.4253C5.12735 14.1227 4.13285 13.548 3.32671 12.7553C3.52771 12.4459 3.63919 12.0869 3.64882 11.718C3.65845 11.3491 3.56584 10.9848 3.38125 10.6653C3.19666 10.3458 2.92728 10.0836 2.60291 9.9077C2.27855 9.7318 1.91184 9.64906 1.54337 9.66864C1.40671 9.13531 1.33337 8.57597 1.33337 7.99997ZM4.53604 9.99998C4.95604 10.7273 5.07604 11.564 4.91204 12.3493C5.18449 12.5431 5.47271 12.7098 5.77671 12.8493C6.38805 12.3022 7.17966 11.9998 8.00004 12C8.84004 12 9.62537 12.314 10.2234 12.8493C10.5274 12.7098 10.8156 12.5431 11.088 12.3493C10.9201 11.5466 11.054 10.7102 11.464