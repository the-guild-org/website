                        <span class="mt-2 flex gap-2 leading-6"><svg fill="currentColor" height="16" viewBox="0 0 16 16" width="16" class="my-1 size-4 text-green-600"><path d="M6.66674 10.1134L12.7947 3.98602L13.7374 4.92869L6.66674 11.9994L2.42407 7.75669L3.36674 6.81402L6.66674 10.1134Z"></path></svg>1M operations per month</span>
                      </span>
                      <span class="tooltip-bubble bg-green-1000 absolute left-0 top-full z-20 mt-1 rounded-sm px-2 py-[3px] text-sm font-normal text-white shadow-sm whitespace-nowrap hidden" role="tooltip">
                        GraphQL operations reported to Hive Console
                        <svg class="text-green-1000 absolute -top-1 left-4 rotate-180" fill="currentColor" height="5" viewBox="0 0 8 4" width="10"><path d="M5.06066 2.93934C4.47487 3.52513 3.52513 3.52513 2.93934 2.93934L-6.03983e-07 -6.99382e-07L8 0L5.06066 2.93934Z"></path></svg>
                      </span>
                    </span>
                  </li>
                  <li class="border-beige-200 flex flex-col px-1 py-2 text-sm text-[#4F6C6A] not-last:border-b">
                    <span class="relative inline-block">
