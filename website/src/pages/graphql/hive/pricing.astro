  '<svg class="text-positive-dark mx-auto size-6" fill="currentColor" height="20" viewBox="0 0 20 20" width="20"><path clip-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" fill-rule="evenodd"></path></svg>';
const NO_SVG =
  '<svg class="text-critical-dark mx-auto size-6" fill="currentColor" height="20" viewBox="0 0 20 20" width="20"><path clip-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" fill-rule="evenodd"></path></svg>';

const cellHtml = (value: Cell) => (value === "yes" ? YES_SVG : value === "no" ? NO_SVG : value);

const pricingTiers = [
  { cta: "Get started for free", ctaVariant: "tertiary" as const, href: appUrl, name: "Hobby" },
  { cta: "Try free for 30 days", ctaVariant: "primary" as const, href: appUrl, name: "Pro" },
  { cta: "Shape your business", ctaVariant: "primary" as const, href: contactUrl, name: "Enterprise" },
];

const smallCtaBase =
  "relative flex items-center justify-center gap-2 text-nowrap rounded-lg px-3 py-2 text-sm font-medium leading-6 text-green-1000";
const smallCtaVariant = {
  primary: "bg-primary hover:bg-green-800 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-green-800",
  tertiary: "bg-transparent focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-green-800",
} as const;
