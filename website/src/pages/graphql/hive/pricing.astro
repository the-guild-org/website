                    <strong class="flex h-6 items-center gap-2 font-bold [&>svg]:size-4 [&>svg]:text-green-600"><svg fill="currentColor" height="16" viewBox="0 0 16 16" width="16"><path d="M7.33333 4.66671H8.66667V11.3334H7.33333V4.66671ZM10 7.33337H11.3333V11.3334H10V7.33337ZM4.66667 8.66671H6V11.3334H4.66667V8.66671ZM10 2.66671H3.33333V13.3334H12.6667V5.33337H10V2.66671ZM2 1.99471C2 1.62937 2.298 1.33337 2.666 1.33337H10.6667L14 4.66671V13.9954C14.0006 14.0829 13.984 14.1697 13.951 14.2509C13.9181 14.332 13.8695 14.4058 13.808 14.4682C13.7466 14.5305 13.6734 14.5801 13.5928 14.6142C13.5121 14.6482 13.4255 14.6661 13.338 14.6667H2.662C2.48692 14.6655 2.31934 14.5954 2.19548 14.4717C2.07161 14.348 2.0014 14.1805 2 14.0054V1.99471Z"></path></svg>Customized Billing</strong>
                    <span class="mt-2 flex gap-2 leading-6"><svg fill="currentColor" height="16" viewBox="0 0 16 16" width="16" class="my-1 size-4 text-green-600"><path d="M6.66674 10.1134L12.7947 3.98602L13.7374 4.92869L6.66674 11.9994L2.42407 7.75669L3.36674 6.81402L6.66674 10.1134Z"></path></svg>Flexible billing options tailored to enterprise procurement processes</span>
                  </li>
                </ul>

                <button aria-expanded="false" class="show-features-btn border-beige-200 text-green-1000 relative h-12 w-full gap-2 pt-4 text-center font-bold transition-opacity aria-expanded:border-t sm:hidden sm:border-t">
                  <span class="absolute inset-0 flex items-center justify-center transition-opacity duration-200 [[aria-expanded=false]>&]:delay-700 [[aria-expanded=true]>&]:opacity-0">
                    Show key features
                    <svg fill="none" height="15" viewBox="0 0 15 15" width="15" xmlns="http://www.w3.org/2000/svg" class="size-6"><path clip-rule="evenodd" d="M3.13523 6.15803C3.3241 5.95657 3.64052 5.94637 3.84197 6.13523L7.5 9.56464L11.158 6.13523C11.3595 5.94637 11.6759 5.95657 11.8648 6.15803C12.0536 6.35949 12.0434 6.67591 11.842 6.86477L7.84197 10.6148C7.64964 10.7951 7.35036 10.7951 7.15803 10.6148L3.15803 6.86477C2.95657 6.67591 2.94637 6.35949 3.13523 6.15803Z" fill-rule="evenodd"></path></svg>
                  </span>
                  <span class="absolute inset-0 flex items-center justify-center transition-opacity duration-200 [[aria-expanded=false]>&]:opacity-0 [[aria-expanded=true]>&]:delay-1000">
                    Hide key features
                    <svg fill="none" height="15" viewBox="0 0 15 15" width="15" xmlns="http://www.w3.org/2000/svg" class="size-6 rotate-180"><path clip-rule="evenodd" d="M3.13523 6.15803C3.3241 5.95657 3.64052 5.94637 3.84197 6.13523L7.5 9.56464L11.158 6.13523C11.3595 5.94637 11.6759 5.95657 11.8648 6.15803C12.0536 6.35949 12.0434 6.67591 11.842 6.86477L7.84197 10.6148C7.64964 10.7951 7.35036 10.7951 7.15803 10.6148L3.15803 6.86477C2.95657 6.67591 2.94637 6.35949 3.13523 6.15803Z" fill-rule="evenodd"></path></svg>
                  </span>
                </button>
              </div>
            </article>
          </div>
        </div>
      </section>

      <!-- All plans include every feature -->
      <section class="bg-blueish-green rounded-3xl px-4 py-12 text-center md:p-24 mx-4 md:mx-6">
        <h2 class="group flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-white text-4xl leading-[1.2] md:text-5xl md:leading-[1.16667] tracking-[-0.48px]">
          All plans include
          <span class="text-green-1000 inline-block rounded-2xl bg-linear-to-r from-blue-300 to-blue-500 px-3 py-2">every feature</span>
        </h2>
        <p class="mt-8 font-medium text-white/80">We do not gate any features. All our plans are fully-featured, with access to the community. We only charge a premium for support.</p>
      </section>

      <!-- Plans comparison table -->
      <section class="relative p-4 py-12 md:px-6 lg:py-24 xl:px-[120px]">
        <h3 class="group text-pretty text-center max-md:text-[32px]/10 max-md:tracking-[-.16px] text-4xl leading-[1.2] md:text-5xl md:leading-[1.16667] tracking-[-0.48px]">
          Hive Console allows you to do so much more.
          <br class="max-xl:hidden" /> On&nbsp;your&nbsp;own&nbsp;terms.
        </h3>
        <p class="mb-8 mt-4 text-center md:mb-16">Part of the Hive ecosystem, Hive Console is a fully-fledged solution that you can easily tailor to your&nbsp;needs.</p>

        <!-- Mobile plan switcher -->
        <div class="nested-sticky relative" data-nested-sticky data-offset-bottom="482" data-offset-top="64" data-z-index="10">
          <div style="height:0;width:100%"></div>
          <div>
            <div class="bg-beige-100 before:bg-beige-100 before:border-b-beige-400 relative top-0 z-10 w-full rounded-2xl p-2 duration-100 ease-(--hive-ease-overshoot-a-bit) before:absolute before:inset-0 before:opacity-0 before:transition md:hidden [[data-sticky]>&:before]:scale-x-125 [[data-sticky]>&:before]:border-b [[data-sticky]>&:before]:opacity-100 [[data-sticky]>&:before]:shadow-xs">
              <div class="relative flex w-full">
                {pricingTiers.map((tier, i) => (
                  <button class:list={["hive-focus bg-beige-100 flex-1 rounded-xl px-3 py-2 text-center text-sm/5 font-medium transition hover:z-10 hover:ring-3 hover:ring-inset focus:z-10", i === 0 && "bg-white"]} data-plan-tab={tier.name} type="button">{tier.name}</button>
                ))}
              </div>
              <div class="relative mt-3 h-9">
                {pricingTiers.map((tier, i) => (
                  <div aria-hidden={i !== 0} class:list={["absolute inset-0 z-10 flex items-center justify-center rounded-lg *:w-full! aria-hidden:pointer-events-none aria-hidden:z-0", i === 0 && "bg-beige-100"]} data-plan-tab-cta={tier.name}>
                    <a class={`${smallCtaBase} ${smallCtaVariant[tier.ctaVariant]}`} href={withBase(tier.href)}>
                      <span class="absolute inset-0 rounded-lg border border-green-800"></span>
                      {tier.cta}
                    </a>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>

        <div class="md:nextra-scrollbar md:-mx-6 md:overflow-x-auto md:px-6">
          <!-- Desktop sticky header -->
          <div class="nested-sticky relative" data-nested-sticky data-offset-bottom="90" data-offset-top="80" data-z-index="10">
            <div style="height:0;width:100%"></div>
            <div>
              <div aria-hidden="true" class="bg-beige-100 [[data-sticky]>&]:border-beige-200 relative flex items-center rounded-3xl border border-transparent *:text-left max-md:hidden md:*:w-1/4 [[data-sticky]>&]:rounded-t-none [[data-sticky]>&]:shadow-xs">
                <div class="z-10 flex rounded-l-3xl p-6 pr-[0.5px] text-xl/6 font-normal lg:w-[28%]">
                  <span class="border-beige-400 w-full border-r">Features</span>
                </div>
                {pricingTiers.map((tier, i) => (
                  <div class="py-6 last:rounded-r-3xl last:pr-6 lg:w-[23%] lg:last:w-[26%]">
                    <div class="border-beige-400 flex w-full items-center justify-between px-6 pr-0 sm:[@media(width<1400px)]:[&>a]:hidden">
                      <div class="mr-auto text-xl/6 font-medium">{tier.name}</div>
                      <a class={`${smallCtaBase} ${smallCtaVariant[tier.ctaVariant]}`} href={withBase(tier.href)}>
                        <span class="absolute inset-0 rounded-lg border border-green-800"></span>
                        {tier.cta}
                      </a>
                      {i < pricingTiers.length - 1 && (
                        <div class="border-beige-400 h-full w-6 select-none border-r">&nbsp;</div>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <table class="overflow-x-auto nextra-scrollbar rounded-2xl border border-(--border) [--border:var(--color-green-200)] [--highlight-bg:var(--color-green-100)] table w-full border-separate border-spacing-0 border-none">
            <thead class="sr-only">
              <tr>
                <th>Features</th>
                {pricingTiers.map((tier) => <th>{tier.name}</th>)}
              </tr>
            </thead>
            {comparisonSections.map((section) => (
              <tbody>
                <tr class="subheader">
                  <td class="pb-6 pt-8" colspan="4">
                    <div class="flex items-center text-[32px]/10 max-md:text-[20px]/6 max-md:font-medium [&>svg]:m-[6.67px] [&>svg]:mr-[10.67px] [&>svg]:size-[26.67px] [&>svg]:text-green-600">
                      <Fragment set:html={section.icon} />
                      {section.title}
                    </div>
                    <p class="mt-2 text-green-800">{section.description}</p>
                  </td>
                </tr>
                {section.rows.map((row) => (
                  <tr>
                    <td class:list={[CELL_CLASS, row.featureClass]} set:html={row.feature} />
                    {row.values.map((value, i) => (
                      <td aria-hidden={i !== 0} class:list={[CELL_CLASS, i !== 0 && "max-md:hidden"]} data-plan-column={pricingTiers[i].name} set:html={cellHtml(value)} />
                    ))}
                  </tr>
                ))}
              </tbody>
            ))}
          </table>
        </div>
      </section>

      <CompanyTestimonials class="mx-4 mt-6 md:mx-6" />

      <FrequentlyAskedQuestions class="mx-4 md:mx-6" />

      <GetYourAPIGameRightSection class="mx-4 sm:mb-6 md:mx-6" />
    </main>

    <SiteFooter />

    <script>
      // ---- Pricing slider: live operations count, Pro price, plan highlight, scroll-into-view ----
      const sliderRoot = document.querySelector<HTMLElement>("#pricing-slider-root");
      const range = document.querySelector<HTMLInputElement>("#operations-range");
      const sliderWrap = document.querySelector<HTMLElement>("#operations-slider-wrap");
      const enterpriseHint = document.querySelector<HTMLElement>("#enterprise-hint");
      const proPriceValue = document.querySelector<HTMLElement>("#pro-price-value");
      const scrollview = document.querySelector<HTMLElement>("#plans-scrollview");
      const cards = [...document.querySelectorAll<HTMLElement>(".plan-card")];
      const recommendedLabels = [...document.querySelectorAll<HTMLElement>("[data-recommended-label]")];
      const backdrops = [...document.querySelectorAll<HTMLElement>("[data-backdrop-for]")];

      let highlightedPlan = "Hobby";

      const setVal = (value: number) => {
        const ratio = (value - 1) / (1000 - 1);
        sliderWrap?.style.setProperty("--val", String(Math.round(ratio * 100)));
      };

      const setHighlighted = (plan: string) => {
        cards.forEach((card) => card.dataset.highlighted = String(card.dataset.plan === plan));
        recommendedLabels.forEach((label) => {
          const card = label.closest(".plan-card") as HTMLElement | null;
          const isHighlighted = card?.dataset.plan === plan;
          label.dataset.highlighted = String(isHighlighted);
          label.setAttribute("aria-hidden", String(!isHighlighted));
        });
      };

      const scrollCardIntoView = (plan: string) => {
        if (!scrollview) return;
        const card = scrollview.querySelector<HTMLElement>(`[data-plan="${plan}"]`);
        if (!card) return;

        const { left, right } = card.getBoundingClientRect();
        const containerRect = scrollview.getBoundingClientRect();
        const { scrollLeft } = scrollview;
        const padding = Number.parseInt(globalThis.getComputedStyle(scrollview).paddingLeft || "0", 10);

        const cardLeftRelativeToContainer = left - containerRect.left;
        const cardRightRelativeToContainer = right - containerRect.left;

        if (cardLeftRelativeToContainer >= padding && cardRightRelativeToContainer <= containerRect.width - padding) {
          return;
        }

        let targetScrollLeft = scrollLeft;
        if (cardLeftRelativeToContainer < padding) {
          targetScrollLeft = scrollLeft - (padding - cardLeftRelativeToContainer);
        } else if (cardRightRelativeToContainer > containerRect.width - padding) {
          targetScrollLeft = scrollLeft + (cardRightRelativeToContainer - (containerRect.width - padding));
        }

        scrollview.scrollTo({ behavior: "smooth", left: targetScrollLeft });
      };

      const onSliderInput = () => {
        if (!range || !sliderRoot) return;
        const value = Number(range.value);
        sliderRoot.style.setProperty("--ops", String(value));
        setVal(value);

        if (proPriceValue) {
          proPriceValue.innerHTML = `$${20 + (value - 1) * 10}<span class="text-base/normal text-green-800"> / month</span>`;
        }

        const newPlan = value === 1 ? "Hobby" : value <= 300 ? "Pro" : "Enterprise";
        if (enterpriseHint) enterpriseHint.hidden = newPlan !== "Enterprise";

        if (newPlan !== highlightedPlan) {
          highlightedPlan = newPlan;
          setHighlighted(newPlan);
          scrollCardIntoView(newPlan);
        }
      };

      range?.addEventListener("input", onSliderInput);
      setVal(1);

      // ---- Operations info popover (hover + click, matching the React component's semantics) ----
      const infoButton = document.querySelector<HTMLButtonElement>("#operations-info-button");
      const infoPopover = document.querySelector<HTMLElement>("#operations-popover");
      infoButton?.addEventListener("click", () => {
        if (infoPopover) infoPopover.hidden = !infoPopover.hidden;
      });
      infoButton?.addEventListener("mouseenter", () => {
        if (infoPopover) infoPopover.hidden = false;
      });
      infoButton?.addEventListener("mouseleave", () => {
        if (infoPopover) infoPopover.hidden = true;
      });

      // ---- Feature tooltips (hover/focus, CSS-driven via a class toggle) ----
      document.querySelectorAll<HTMLElement>(".tooltip-trigger").forEach((trigger) => {
        const bubble = trigger.parentElement?.querySelector<HTMLElement>(".tooltip-bubble");
        if (!bubble) return;
        const show = () => (bubble.hidden = false);
        const hide = () => (bubble.hidden = true);
        trigger.addEventListener("mouseenter", show);
        trigger.addEventListener("mouseleave", hide);
        trigger.addEventListener("focus", show);
        trigger.addEventListener("blur", hide);
      });

      // ---- Mobile plan card expand/collapse ----
      document.querySelectorAll<HTMLButtonElement>(".show-features-btn").forEach((button) => {
        const card = button.closest(".plan-card") as HTMLElement | null;
        if (!card) return;
        const plan = card.dataset.plan;
        const list = card.querySelector<HTMLElement>("ul");
        const contentWrap = card.querySelector<HTMLElement>(":scope > div");
        const closeButton = card.querySelector<HTMLButtonElement>("[data-close-card]");
        const backdrop = backdrops.find((b) => b.dataset.backdropFor === plan);

        const setCollapsed = (collapsed: boolean) => {
          card.dataset.collapsed = String(collapsed);
          contentWrap && (contentWrap.dataset.collapsed = String(collapsed));
          list && (list.dataset.collapsed = String(collapsed));
          list?.setAttribute("data-open", String(!collapsed));
          backdrop && (backdrop.dataset.collapsed = String(collapsed));
          button.setAttribute("aria-expanded", String(!collapsed));
          document.body.classList.toggle("max-sm:overflow-hidden", !collapsed);
        };

        button.addEventListener("click", () => setCollapsed(card.dataset.collapsed !== "true"));
        closeButton?.addEventListener("click", () => setCollapsed(true));
        backdrop?.addEventListener("click", () => setCollapsed(true));

        window.addEventListener("resize", () => {
          if (window.innerWidth > 640 && card.dataset.collapsed === "false") setCollapsed(true);
        });
        window.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && card.dataset.collapsed === "false") setCollapsed(true);
        });
      });

      // ---- Comparison table: mobile plan switcher ----
      const planTabs = [...document.querySelectorAll<HTMLButtonElement>("[data-plan-tab]")];
      const planTabCtas = [...document.querySelectorAll<HTMLElement>("[data-plan-tab-cta]")];
      const tableCells = [...document.querySelectorAll<HTMLElement>("[data-plan-column]")];

      const selectPlanTab = (plan: string) => {
        planTabs.forEach((tab) => tab.classList.toggle("bg-white", tab.dataset.planTab === plan));
        planTabCtas.forEach((cta) => cta.setAttribute("aria-hidden", String(cta.dataset.planTabCta !== plan)));
        tableCells.forEach((cell) => {
          const isActive = cell.dataset.planColumn === plan;
          cell.classList.toggle("max-md:hidden", !isActive);
          cell.setAttribute("aria-hidden", String(!isActive));
        });
      };

      planTabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          if (tab.dataset.planTab) selectPlanTab(tab.dataset.planTab);
        });
      });

      // ---- Nested sticky headers (ported from the React NestedSticky component) ----
      interface StickyOptions {
        offsetBottom: number;
        offsetTop: number;
        zIndex: number;
      }

      function initNestedSticky(container: HTMLElement, { offsetBottom, offsetTop, zIndex }: StickyOptions) {
        const placeholder = container.firstElementChild as HTMLElement | null;
        const sticky = container.lastElementChild as HTMLElement | null;
        const parent = container.parentElement;
        if (!placeholder || !sticky || !parent) return;

        let width = 0;
        let height = 0;
        let rafId: number | null = null;
        type State = "absolute" | "fixed" | "relative";
        let state: State = "relative";
        let prevState: State = "relative";

        const measureDimensions = () => {
          const rect = sticky.getBoundingClientRect();
          width = rect.width;
          height = rect.height;
          sticky.style.zIndex = String(zIndex);
        };

        const updateStyles = () => {
          placeholder.style.height = state === "relative" ? "0" : `${height}px`;
          if (state === "fixed") {
            sticky.style.position = "fixed";
            sticky.style.top = `${offsetTop}px`;
            sticky.style.width = `${width}px`;
            sticky.dataset["sticky"] = "fixed";
          } else if (state === "absolute") {
            const containerRect = container.getBoundingClientRect();
            const stickyRect = sticky.getBoundingClientRect();
            const relativeTop = stickyRect.top - containerRect.top;
            sticky.style.position = "absolute";
            sticky.style.top = `${relativeTop}px`;
            sticky.style.width = `${width}px`;
            sticky.dataset["sticky"] = "absolute";
          } else {
            sticky.style.position = "relative";
            sticky.style.top = "";
            sticky.style.width = "";
            delete sticky.dataset["sticky"];
          }
        };

        const handleScroll = () => {
          if (rafId) cancelAnimationFrame(rafId);
          rafId = requestAnimationFrame(() => {
            const containerRect = container.getBoundingClientRect();
            const parentRect = parent.getBoundingClientRect();
            const shouldBeFixed = containerRect.top < offsetTop;
            const nearBottom = parentRect.bottom < offsetTop + height + offsetBottom + 10;
            state = shouldBeFixed && nearBottom ? "absolute" : shouldBeFixed ? "fixed" : "relative";
            if (state !== prevState) {
              prevState = state;
              updateStyles();
            }
          });
        };

        const handleResize = () => {
          width = placeholder.getBoundingClientRect().width;
          updateStyles();
          handleScroll();
        };

        measureDimensions();
        handleScroll();
        window.addEventListener("resize", handleResize, { passive: true });
        window.addEventListener("scroll", handleScroll, { passive: true });
      }

      document.querySelectorAll<HTMLElement>("[data-nested-sticky]").forEach((el) => {
        initNestedSticky(el, {
          offsetBottom: Number(el.dataset.offsetBottom),
          offsetTop: Number(el.dataset.offsetTop),
          zIndex: Number(el.dataset.zIndex),
        });
      });

      // ---- Contact links open Crisp chat if available ----
      document.querySelectorAll<HTMLAnchorElement>("[data-contact-link]").forEach((link) => {
        link.addEventListener("click", (event) => {
          const crisp = (globalThis as typeof globalThis & {
            $crisp?: { push(args: unknown[]): void };
          }).$crisp;
          if (crisp) {
            crisp.push(["do", "chat:open"]);
            event.preventDefault();
          }
        });
      });
    </script>

    <style>
      @property --val {
        syntax: "<integer>";
        initial-value: 0;
        inherits: true;
      }

      .hive-slider div,
      .hive-slider div:after {
        transition: transform var(--hive-ease-overshoot-far, ease) 500ms;
      }

      @container (width >= 512px) {
        .hive-slider div,
        .hive-slider div:after {
          transition: transform var(--hive-ease-overshoot-a-bit, ease) 500ms;
        }
      }
    </style>
  </body>
