---
import BaseHead from '~hive/components/BaseHead.astro';
import FrequentlyAskedQuestions from '~hive/components/FrequentlyAskedQuestions.astro';
import GetYourAPIGameRightSection from '~hive/components/GetYourAPIGameRightSection.astro';
import CommunitySection from '~hive/components/landing/CommunitySection.astro';
import CompanyLogo from '~hive/components/landing/CompanyLogo.astro';
import CompanyTestimonials from '~hive/components/landing/CompanyTestimonials.astro';
import EcosystemIllustration from '~hive/components/landing/EcosystemIllustration.astro';
import FeatureTabs from '~hive/components/landing/FeatureTabs.astro';
import TeamSection from '~hive/components/landing/TeamSection.astro';
import ToolsAndLibraries from '~hive/components/landing/ToolsAndLibraries.astro';
import SiteFooter from '~hive/components/SiteFooter.astro';
import SiteNavigation from '~hive/components/SiteNavigation.astro';
import { withBase } from '~hive/lib/base-path';
import '~hive/styles/global.css';

const appUrl = 'https://app.graphql-hive.com';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <BaseHead
      description="Fully Open-Source schema registry, analytics and gateway for GraphQL federation and other GraphQL APIs"
      title="Open-Source GraphQL Federation Platform"
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: 'Hive',
        alternateName: 'GraphQL Hive',
        applicationCategory: 'DeveloperApplication',
        operatingSystem: 'Web',
        url: 'https://the-guild.dev/graphql/hive',
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
        publisher: { '@type': 'Organization', name: 'The Guild', url: 'https://the-guild.dev/' },
      })}
    />
  </head>
  <body class="text-green-1000 bg-white font-sans [color-scheme:light]">
    <SiteNavigation />
    <main class="text-green-1000 light mx-auto max-w-360 overflow-hidden">
      <!-- Hero -->
      <div
        class="bg-green-1000 relative isolate mx-4 flex max-w-360 flex-col gap-6 overflow-hidden rounded-3xl px-4 py-6 max-sm:mt-2 sm:pt-12 sm:pb-28 md:mx-6 md:gap-8 lg:pt-24 lg:pb-[168px]"
      >
        <div class="pointer-events-none absolute inset-0 overflow-hidden">
          <svg
            class="pointer-events-none absolute top-[-20px] left-[-46px] size-[200px] rotate-180 md:top-[-76px] md:left-[-186px] md:size-auto"
            height="432"
            preserveAspectRatio="xMidYMid meet"
            viewBox="0 0 432 432"
            width="432"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M.75 431v.25h90.24V160.868c0-38.596 31.282-69.878 69.878-69.878H431.25V.75H191.864a47.017 47.017 0 0 0-33.23 13.771l-68.07 68.071-7.972 7.971-68.07 68.071A47.018 47.018 0 0 0 .75 191.864V431Z"
              fill="url(#hero-arch-a)"
              stroke="url(#hero-arch-b)"
              stroke-width=".5"></path>
          </svg>
          <svg
            class="pointer-events-none absolute right-[-53px] bottom-0 size-[200px] md:-bottom-32 md:size-auto lg:right-[-72px] lg:bottom-0"
            height="432"
            preserveAspectRatio="xMidYMid meet"
            viewBox="0 0 432 432"
            width="432"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M.75 431v.25h90.24V160.868c0-38.596 31.282-69.878 69.878-69.878H431.25V.75H191.864a47.017 47.017 0 0 0-33.23 13.771l-68.07 68.071-7.972 7.971-68.07 68.071A47.018 47.018 0 0 0 .75 191.864V431Z"
              fill="url(#hero-arch-a)"
              stroke="url(#hero-arch-b)"
              stroke-width=".5"></path>
          </svg>
          <svg class="absolute -z-10" height="432" viewBox="0 0 432 432" width="432">
            <defs>
              <linearGradient
                gradientUnits="userSpaceOnUse"
                id="hero-arch-a"
                x1="48.5"
                x2="302.5"
                y1="53.5"
                y2="341"
                ><stop stop-color="#fff" stop-opacity=".1"></stop><stop
                  offset="1"
                  stop-color="#fff"
                  stop-opacity=".3"></stop></linearGradient
              >
              <linearGradient
                gradientUnits="userSpaceOnUse"
                id="hero-arch-b"
                x1="1"
                x2="431"
                y1="1"
                y2="431"
                ><stop stop-color="#fff" stop-opacity=".1"></stop><stop
                  offset="1"
                  stop-color="#fff"
                  stop-opacity=".4"></stop></linearGradient
              >
            </defs>
          </svg>
        </div>

        <h1
          class="group mx-auto max-w-3xl text-center text-4xl leading-[1.2] tracking-[-0.64px] text-balance text-white md:text-[4rem] md:leading-[1.1875]"
        >
          Open-Source GraphQL Federation Platform
        </h1>
        <p class="mx-auto w-lg max-w-[80%] text-center leading-6 text-white/80">
          Fully open-source schema registry, analytics, metrics and{' '}
          <a
            class="hive-focus underline decoration-white/30 underline-offset-2 hover:decoration-white/80"
            href={withBase('/gateway')}
            title="Learn more about Hive Gateway">gateway</a
          >
          {' '}for{' '}
          <a
            class="hive-focus underline decoration-white/30 underline-offset-2 hover:decoration-white/80"
            href={withBase('/federation')}
            title="Visit our guide to learn more about GraphQL federation">GraphQL federation</a
          >
          {' '}and other GraphQL APIs.
        </p>
        <ul
          class="relative z-10 mx-auto flex list-none flex-col gap-x-6 gap-y-2 text-sm leading-[21px] font-medium text-white md:flex-row [&>li]:flex [&>li]:items-center [&>li]:gap-2"
        >
          <li>
            <svg class="text-blue-400" fill="none" height="20" viewBox="0 0 20 20" width="20"
              ><path
                d="M16.667 5 7.5 14.167 3.333 10"
                stroke="currentColor"
                stroke-linecap="square"
                stroke-linejoin="round"
                stroke-width="1.5"></path></svg
            >MIT licensed
          </li>
          <li>
            <svg class="text-blue-400" fill="none" height="20" viewBox="0 0 20 20" width="20"
              ><path
                d="M16.667 5 7.5 14.167 3.333 10"
                stroke="currentColor"
                stroke-linecap="square"
                stroke-linejoin="round"
                stroke-width="1.5"></path></svg
            >No vendor-lock
          </li>
          <li>
            <svg class="text-blue-400" fill="none" height="20" viewBox="0 0 20 20" width="20"
              ><path
                d="M16.667 5 7.5 14.167 3.333 10"
                stroke="currentColor"
                stroke-linecap="square"
                stroke-linejoin="round"
                stroke-width="1.5"></path></svg
            >Managed and self-hosted
          </li>
        </ul>
        <div class="relative z-10 flex flex-col justify-center gap-2 px-0.5 sm:flex-row sm:gap-4">
          <a
            class="text-green-1000 bg-primary relative flex items-center justify-center gap-2 rounded-lg px-6 py-3 leading-6 font-medium text-nowrap hover:bg-white focus-visible:outline-4 focus-visible:outline-offset-0 focus-visible:outline-white/40 sm:w-fit"
            href={withBase(appUrl)}
          >
            <span class="absolute inset-0 rounded-lg border border-green-800"></span>
            Get started for free
          </a>
          <a
            class="text-green-1000 relative flex items-center justify-center gap-2 rounded-lg bg-green-300 px-6 py-3 leading-6 font-medium text-nowrap hover:bg-green-200 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-green-300/40 sm:w-fit"
            href={withBase('/docs')}
          >
            <span class="absolute inset-0 rounded-lg border border-green-800"></span>
            Documentation
          </a>
        </div>

        <div class="pointer-events-none absolute inset-0 overflow-hidden">
          <svg
            class="firefox-highlight-fix pointer-events-none absolute top-[-22px] right-0 overflow-visible"
            fill="#86B6C1"
            height="674"
            viewBox="0 0 895 674"
            width="895"
            xmlns="http://www.w3.org/2000/svg"
          >
            <g filter="url(#hero-highlight-blur)"
              ><path
                d="M350 280.534C350 296.208 356.24 311.261 367.33 322.351L453.447 408.468L463.532 418.553L549.649 504.67C560.739 515.76 575.792 522 591.466 522L894 522L894 408.468L552.251 408.468C503.249 408.468 463.532 368.751 463.532 319.749L463.532 -22L350 -22L350 280.534Z"
              ></path></g
            >
            <defs
              ><filter
                color-interpolation-filters="sRGB"
                filterUnits="userSpaceOnUse"
                height="1244"
                id="hero-highlight-blur"
                width="1244"
                x="-3.05176e-05"
                y="-372"
                ><feFlood flood-opacity="0" result="BackgroundImageFix"></feFlood><feBlend
                  in="SourceGraphic"
                  in2="BackgroundImageFix"
                  mode="normal"
                  result="shape"></feBlend><feGaussianBlur
                  result="effect1_foregroundBlur"
                  stdDeviation="175"></feGaussianBlur></filter
              ></defs
            >
          </svg>
        </div>
      </div>

      <FeatureTabs class="relative mt-6 sm:-mt-18" />

      <!-- Trusted by -->
      <div class="mx-auto my-8 max-w-[80%] text-center md:my-16 lg:my-24">
        <p class="text-base text-blue-800">
          Trusted by global enterprises and fast-moving startups
        </p>
        <div
          class="text-blue-1000 mt-6 grid grid-cols-2 flex-row flex-wrap place-items-center items-center justify-center gap-x-16 gap-y-6 sm:flex"
        >
          <a
            class="hover:bg-beige-100 -mx-3 -my-2 rounded-lg px-3 py-2"
            href={withBase('/case-studies/trivago')}
          >
            <CompanyLogo class="translate-y-[5px]" height={32} slug="trivago" title="Trivago" />
          </a>
          <CompanyLogo class="translate-y-[5px]" height={32} slug="meetup" title="Meetup" />
          <CompanyLogo height={22} slug="linktree" title="Linktree" />
          <CompanyLogo height={28} slug="karrot" title="Karrot" />
          <CompanyLogo height={32} slug="aligent" title="Aligent" />
          <a
            class="hover:bg-beige-100 -mx-3 -my-2 rounded-lg px-3 py-2"
            href={withBase('/case-studies/hemnet')}
          >
            <CompanyLogo height={32} slug="hemnet" title="Hemnet" />
          </a>
          <a
            class="hover:bg-beige-100 -mx-3 -my-2 rounded-lg px-3 py-2"
            href={withBase('/case-studies/sound-xyz')}
          >
            <CompanyLogo height={32} slug="sound-xyz" title="SoundXYZ" />
          </a>
        </div>
      </div>

      <!-- Ecosystem management -->
      <section
        class="bg-green-1000 relative isolate rounded-3xl p-8 px-4 pb-[180px] text-white max-sm:rounded-none sm:mx-4 sm:pb-[128px] md:mx-6 md:p-[72px] md:pr-8 md:pb-[128px] lg:pb-[72px]"
      >
        <div
          class="relative mx-auto flex w-[1392px] max-w-full flex-col gap-x-4 gap-y-6 md:gap-x-6 md:gap-y-12 lg:flex-row"
        >
          <div class="flex flex-col gap-12 lg:w-[488px]">
            <h2 class="group text-[40px] leading-[1.2] tracking-[-0.2px]">
              360° GraphQL API Management
            </h2>
            <ul class="mx-auto flex list-none flex-col gap-y-4 text-white/80 lg:gap-y-6">
              <li class="flex items-start gap-4">
                <svg
                  class="mt-0.5 shrink-0 text-blue-400"
                  fill="none"
                  height="20"
                  viewBox="0 0 20 20"
                  width="20"
                  ><path
                    d="M16.667 5 7.5 14.167 3.333 10"
                    stroke="currentColor"
                    stroke-linecap="square"
                    stroke-linejoin="round"
                    stroke-width="1.5"></path></svg
                >
                <div class="text-white">
                  A complete ecosystem covering all your dev and production needs.
                </div>
              </li>
              <li class="flex items-start gap-4">
                <svg
                  class="mt-0.5 shrink-0 text-blue-400"
                  fill="none"
                  height="20"
                  viewBox="0 0 20 20"
                  width="20"
                  ><path
                    d="M16.667 5 7.5 14.167 3.333 10"
                    stroke="currentColor"
                    stroke-linecap="square"
                    stroke-linejoin="round"
                    stroke-width="1.5"></path></svg
                >
                <div>
                  <div class="font-medium text-white">Apollo Federation v1 and v2</div>
                  <div>
                    Best in class <a
                      class="hive-focus -mx-1 -my-0.5 rounded-sm px-1 py-0.5 underline hover:text-blue-500"
                      href="https://the-guild.dev/graphql/hive/federation-gateway-audit"
                      target="_blank"
                      rel="noreferrer">compatibility with Apollo Federation spec</a
                    >
                  </div>
                </div>
              </li>
              <li class="flex items-start gap-4">
                <svg
                  class="mt-0.5 shrink-0 text-blue-400"
                  fill="none"
                  height="20"
                  viewBox="0 0 20 20"
                  width="20"
                  ><path
                    d="M16.667 5 7.5 14.167 3.333 10"
                    stroke="currentColor"
                    stroke-linecap="square"
                    stroke-linejoin="round"
                    stroke-width="1.5"></path></svg
                >
                <div>
                  <div class="font-medium text-white">
                    Powerful and flexible <a
                      class="hive-focus -mx-1 -my-0.5 rounded-sm px-1 py-0.5 underline hover:text-blue-500"
                      href={withBase('/gateway')}>GraphQL Gateway (Router)</a
                    >
                  </div>
                  <div>
                    GraphQL Subscriptions support and built-in security features (RBAC, JWT,
                    Persisted Operations)
                  </div>
                </div>
              </li>
              <li class="flex items-start gap-4">
                <svg
                  class="mt-0.5 shrink-0 text-blue-400"
                  fill="none"
                  height="20"
                  viewBox="0 0 20 20"
                  width="20"
                  ><path
                    d="M16.667 5 7.5 14.167 3.333 10"
                    stroke="currentColor"
                    stroke-linecap="square"
                    stroke-linejoin="round"
                    stroke-width="1.5"></path></svg
                >
                <div>
                  <span class="font-medium text-white">No vendor-lock</span> — dive into our full GraphQL
                  ecosystem, or&nbsp;build your own stack, connecting{' '}
                  <a
                    class="hive-focus -mx-1 -my-0.5 rounded-sm px-1 py-0.5 underline hover:text-blue-500"
                    href={withBase('/federation')}>GraphQL federation</a
                  >,{' '}
                  <a
                    class="hive-focus -mx-1 -my-0.5 rounded-sm px-1 py-0.5 underline hover:text-blue-500"
                    href={withBase('/gateway')}>Hive Gateway</a
                  >,{' '}
                  <a
                    class="hive-focus -mx-1 -my-0.5 rounded-sm px-1 py-0.5 underline hover:text-blue-500"
                    href="https://the-guild.dev/graphql/mesh"
                    target="_blank"
                    rel="noreferrer">GraphQL Mesh</a
                  > and more.
                </div>
              </li>
              <li class="flex items-start gap-4">
                <svg
                  class="mt-0.5 shrink-0 text-blue-400"
                  fill="none"
                  height="20"
                  viewBox="0 0 20 20"
                  width="20"
                  ><path
                    d="M16.667 5 7.5 14.167 3.333 10"
                    stroke="currentColor"
                    stroke-linecap="square"
                    stroke-linejoin="round"
                    stroke-width="1.5"></path></svg
                >
                <div>
                  <div class="font-medium text-white">
                    Drop-in replacement for Apollo GraphOS (Apollo Studio)
                  </div>
                  <div>100% on-prem and open-source</div>
                </div>
              </li>
            </ul>
            <div
              class="bottom-0 flex w-full gap-x-4 gap-y-2 max-lg:absolute max-lg:translate-y-[calc(100%+40px)] max-sm:flex-col lg:flex-col"
            >
              <a
                class="text-green-1000 bg-primary relative flex items-center justify-center gap-2 rounded-lg px-6 py-3 leading-6 font-medium text-nowrap hover:bg-white focus-visible:outline-4 focus-visible:outline-offset-0 focus-visible:outline-white/40 sm:w-fit"
                href={withBase('/federation')}
                title="Learn what GraphQL Federation is and when to use it."
              >
                <span class="absolute inset-0 rounded-lg border border-green-800"></span>
                Learn GraphQL Federation
                <svg fill="currentColor" height="24" viewBox="0 0 24 24" width="24"
                  ><path
                    d="m15.755 11.1-4.828-4.828L12.2 5l7 7-7 7-1.273-1.272 4.828-4.828H4.8v-1.8h10.955Z"
                  ></path></svg
                >
              </a>
              <a
                class="text-green-1000 relative flex items-center justify-center gap-2 rounded-lg bg-green-300 px-6 py-3 leading-6 font-medium text-nowrap hover:bg-green-200 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-green-300/40 sm:w-fit"
                href={withBase('/docs/use-cases/apollo-graphos')}
              >
                <span class="absolute inset-0 rounded-lg border border-green-800"></span>
                <svg fill="currentColor" height="24" viewBox="0 0 24 24" width="24"
                  ><path
                    d="M3.9 17.85V5.7A2.7 2.7 0 0 1 6.6 3h12.6a.9.9 0 0 1 .9.9v16.2a.9.9 0 0 1-.9.9H7.05a3.15 3.15 0 0 1-3.15-3.15Zm14.4 1.35v-2.7H7.05a1.35 1.35 0 1 0 0 2.7H18.3ZM5.7 15.003c.422-.2.883-.304 1.35-.303H18.3V4.8H6.6a.9.9 0 0 0-.9.9v9.303Z"
                  ></path></svg
                >
                Migrate from Apollo GraphOS
              </a>
            </div>
          </div>
          <EcosystemIllustration class="flex-1" />
        </div>
        <div
          class="pointer-events-none absolute inset-0 overflow-hidden"
          style="mask-image: linear-gradient(to right, transparent 20%, black); -webkit-mask-image: linear-gradient(to right, transparent 20%, black);"
        >
          <svg
            class="firefox-highlight-fix pointer-events-none absolute top-[-22px] right-0 overflow-visible"
            fill="#86B6C1"
            height="674"
            viewBox="0 0 895 674"
            width="895"
            xmlns="http://www.w3.org/2000/svg"
          >
            <g filter="url(#eco-highlight-blur)"
              ><path
                d="M350 280.534C350 296.208 356.24 311.261 367.33 322.351L453.447 408.468L463.532 418.553L549.649 504.67C560.739 515.76 575.792 522 591.466 522L894 522L894 408.468L552.251 408.468C503.249 408.468 463.532 368.751 463.532 319.749L463.532 -22L350 -22L350 280.534Z"
              ></path></g
            >
            <defs
              ><filter
                color-interpolation-filters="sRGB"
                filterUnits="userSpaceOnUse"
                height="1244"
                id="eco-highlight-blur"
                width="1244"
                x="-3.05176e-05"
                y="-372"
                ><feFlood flood-opacity="0" result="BackgroundImageFix"></feFlood><feBlend
                  in="SourceGraphic"
                  in2="BackgroundImageFix"
                  mode="normal"
                  result="shape"></feBlend><feGaussianBlur
                  result="effect1_foregroundBlur"
                  stdDeviation="175"></feGaussianBlur></filter
              ></defs
            >
          </svg>
        </div>
      </section>

      <!-- Stats -->
      <section class="mt-6 p-6 sm:py-20 md:mt-0 md:py-24 xl:px-[120px]">
        <h2
          class="group text-center text-4xl leading-[1.2] tracking-[-0.48px] md:text-5xl md:leading-[1.16667]"
        >
          Living and Breathing GraphQL Federation
        </h2>
        <div
          class="mx-auto mt-8 grid grid-cols-1 gap-2 sm:grid-cols-2 sm:gap-6 lg:mt-16 lg:grid-cols-4"
        >
          <div
            class="flex items-end justify-between gap-4 rounded-3xl border border-green-400 p-8 lg:flex-col lg:items-start lg:p-12"
          >
            <div
              class="group text-green-1000 min-w-[120px] text-4xl text-[48px] leading-[1.2] tracking-[-0.64px] md:text-[4rem] md:leading-[1.1875] lg:text-6xl"
            >
              <span data-stat data-decimal="true" data-value="7" aria-live="polite">0</span>K
            </div>
            <div class="mb-3 font-medium max-md:text-right sm:mb-3 md:mb-2 lg:mb-0">
              GitHub commits
            </div>
          </div>
          <div
            class="flex items-end justify-between gap-4 rounded-3xl border border-green-400 p-8 lg:flex-col lg:items-start lg:p-12"
          >
            <div
              class="group text-green-1000 min-w-[120px] text-4xl text-[48px] leading-[1.2] tracking-[-0.64px] md:text-[4rem] md:leading-[1.1875] lg:text-6xl"
            >
              <span data-stat data-decimal="true" data-value="9.6" aria-live="polite">0</span>K
            </div>
            <div class="mb-3 font-medium max-md:text-right sm:mb-3 md:mb-2 lg:mb-0">
              Active developers
            </div>
          </div>
          <div
            class="flex items-end justify-between gap-4 rounded-3xl border border-green-400 p-8 lg:flex-col lg:items-start lg:p-12"
          >
            <div
              class="group text-green-1000 min-w-[120px] text-4xl text-[48px] leading-[1.2] tracking-[-0.64px] md:text-[4rem] md:leading-[1.1875] lg:text-6xl"
            >
              <span data-stat data-value="730" aria-live="polite">0</span>K
            </div>
            <div class="mb-3 font-medium max-md:text-right sm:mb-3 md:mb-2 lg:mb-0">
              Registered schemas
            </div>
          </div>
          <div
            class="flex items-end justify-between gap-4 rounded-3xl border border-green-400 p-8 lg:flex-col lg:items-start lg:p-12"
          >
            <div
              class="group text-green-1000 min-w-[120px] text-4xl text-[48px] leading-[1.2] tracking-[-0.64px] md:text-[4rem] md:leading-[1.1875] lg:text-6xl"
            >
              <span data-stat data-value="350" aria-live="polite">0</span>B
            </div>
            <div class="mb-3 font-medium max-md:text-right sm:mb-3 md:mb-2 lg:mb-0">
              Collected operations
            </div>
          </div>
        </div>
      </section>

      <!-- Ultimate performance cards -->
      <section class="px-4 py-6 sm:py-12 md:px-6 xl:px-30">
        <h2
          class="group text-center text-4xl leading-[1.2] tracking-[-0.48px] text-balance md:text-5xl md:leading-[1.16667]"
        >
          GraphQL Federation for the Ultimate Performance
        </h2>
        <ul class="mt-6 flex flex-row flex-wrap justify-center gap-2 md:mt-16 md:gap-6">
          <li class="bg-beige-100 flex-1 rounded-2xl p-6 md:rounded-3xl md:p-12">
            <div
              class="w-fit rounded-lg bg-[linear-gradient(135deg,#68A8B6,#3B736A)] p-[9px] text-white"
            >
