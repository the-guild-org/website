---
import Callout from '~hive/components/mdx/Callout.astro';
import CodeBlock from '~hive/components/mdx/CodeBlock.astro';
import Image from '~hive/components/mdx/Image.astro';
import PackageManagerTabs from '~hive/components/mdx/PackageManagerTabs.astro';
import PackageManagerTab from '~hive/components/mdx/Tab.astro';
import Table from '~hive/components/mdx/Table.astro';
import ProductUpdateLayout from '~hive/layouts/ProductUpdateLayout.astro';
import { getHeadingHtmlBySlug } from '~hive/lib/docs-markdown';
import { getCollection, render, type CollectionEntry } from 'astro:content';

type ProductUpdate = CollectionEntry<'productUpdates'>;

export async function getStaticPaths() {
  const entries = await getCollection('productUpdates');

  return entries.map(entry => ({
    params: {
      slug: entry.id.replace(/\/index$/, '').replace(/\.(md|mdx)$/, ''),
    },
    props: { entry },
  }));
}

function dateString(value: unknown) {
  return value instanceof Date ? value.toISOString().slice(0, 10) : String(value);
}

const { entry } = Astro.props as { entry: ProductUpdate };
const { Content, headings: renderedHeadings } = await render(entry);
const headingHtmlBySlug = getHeadingHtmlBySlug(entry.body ?? '', renderedHeadings);
const headings = renderedHeadings.map(heading => ({
  ...heading,
  html: headingHtmlBySlug.get(heading.slug) ?? heading.text,
}));
const data = entry.data as {
  authors: (string | { name: string })[];
  canonical?: string;
  date: Date | string;
  description: string;
  title: string;
};
---

<ProductUpdateLayout
  authors={data.authors}
  canonical={data.canonical}
  date={dateString(data.date)}
  description={data.description}
  headings={headings}
  title={data.title}
>
  <Content
    components={{
      Callout,
      Image,
      MdxImage: Image,
      PackageManagerTab,
      PackageManagerTabs,
      pre: CodeBlock,
      table: Table,
    }}
  />
</ProductUpdateLayout>
