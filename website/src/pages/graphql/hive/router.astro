---
/**
 * Hive Router landing page: the blue hero leading with the performance claim,
 * the numbers from the open benchmark and audit, why-Rust highlights, a
 * copy-paste quick start, a compact federation-compatibility banner pointing
 * at the live audit, the extensibility cards, and the shared ecosystem, FAQ
 * and closing sections.
 */
import BaseHead from '~hive/components/BaseHead.astro';
import ExploreMainProductCards from '~hive/components/ExploreMainProductCards.astro';
import FrequentlyAskedQuestions from '~hive/components/FrequentlyAskedQuestions.astro';
import { type BenchmarkDatum } from '~hive/components/gateway/FederationCompatibleBenchmarksSection.astro';
import LetsGetAdvancedSection, {
  type AdvancedCard,
} from '~hive/components/gateway/LetsGetAdvancedSection.astro';
import GetYourAPIGameRightList from '~hive/components/GetYourAPIGameRightList.astro';
import HeroButton from '~hive/components/landing/HeroButton.astro';
import SiteFooter from '~hive/components/SiteFooter.astro';
import SiteNavigation from '~hive/components/SiteNavigation.astro';
import { withBase } from '~hive/lib/base-path';
import '~hive/styles/global.css';
import checkIconRaw from '~hive/design-system/icons/check.svg?raw';
import hiveRouterIconRaw from '~hive/design-system/icons/hive-router.svg?raw';
import { Code } from 'astro:components';

const withAttrs = (svg: string, attrs: string) => svg.replace('<svg', `<svg ${attrs}`);
const routerMark = (attrs: string) =>
  withAttrs(hiveRouterIconRaw, attrs).replace('fill="currentColor"', '');

const REPO_URL = 'https://github.com/graphql-hive/router';
const BENCHMARK_URL = 'https://the-guild.dev/graphql/hive/federation-gateway-performance';
const AUDIT_URL = 'https://the-guild.dev/graphql/hive/federation-gateway-audit';

const checkmarks = [
  'MIT licensed, no license tiers',
  'Drop-in for Apollo Router',
  'Extensible in Rust or any language',
];

// The audit results feed the stat tile and the compatibility banner further down.
let auditData: BenchmarkDatum[] = [];
try {
  const res = await fetch(`${AUDIT_URL}/data.json`);
  if (res.ok) auditData = await res.json();
} catch {
  // Offline build: the tile and the banner's score are left out rather than showing a number
  // we cannot back.
}
const routerAudit = auditData.find(row => row.name === 'Hive Router');
const audit = routerAudit && {
  cases: routerAudit.cases.passed + routerAudit.cases.failed,
  suites: routerAudit.suites.passed + routerAudit.suites.failed,
  passed: routerAudit.cases.passed,
  percent: Math.floor(
    (routerAudit.cases.passed / (routerAudit.cases.passed + routerAudit.cases.failed)) * 100,
  ),
};
const auditTile = audit
  ? [
      {
        href: AUDIT_URL,
        label: `Federation audit, ${audit.passed}/${audit.cases} test cases passed`,
        value: `${audit.percent}%`,
      },
    ]
  : [];

// Benchmark figures: constant load, 50 VUs, 4 vCPU. Hive Router leads every gateway on all of
// them, and the throughput ratio is against Apollo Router in the same run.
const stats: { href: string; label: string; value: string }[] = [
  ...auditTile,
  {
    href: BENCHMARK_URL,
    label: 'the throughput of Apollo Router',
    value: '5×',
  },
  { href: BENCHMARK_URL, label: 'p95 latency at 50 concurrent users', value: '~48 ms' },
  { href: BENCHMARK_URL, label: 'peak memory under load', value: '~49 MB' },
];

const highlights: { description: string; href: string; title: string }[] = [
  {
    title: 'Built in Rust, no garbage collection',
    description:
      'Arena allocation, zero-copy JSON and no garbage collector. Latency stays flat under load.',
    href: '/blog/welcome-hive-router',
  },
  {
    title: 'Full Apollo Federation compatibility',
    description:
      'Point it at your existing supergraph. Every release is checked against our open Federation audit, and features up to progressive @override are supported.',
    href: '/docs/router/compatibility',
  },
  {
    title: 'Observability built in',
    description:
      'OpenTelemetry traces, Prometheus metrics, structured logs and health probes. Send them to Hive Console, Grafana, Datadog or any compatible backend.',
    href: '/docs/router/observability/tracing',
  },
  {
    title: 'Security at the edge of your graph',
    description:
      'JWT authentication, authorization directives, demand control, persisted documents, CSRF and CORS protection. One YAML file configures all of it.',
    href: '/docs/router/security/jwt-authentication',
  },
  {
    title: 'Federated subscriptions',
    description:
      'Real-time data over Server-Sent Events, WebSockets or multipart HTTP. Entities are resolved across subgraphs for subscription events too.',
    href: '/docs/router/subscriptions',
  },
  {
    title: 'Works with any registry',
    description:
      'Load the supergraph from a file, Hive Console or Apollo GraphOS and reload it on change. Hive Console is optional.',
    href: '/docs/router/configuration/supergraph',
  },
];

const quickStart = [
  {
    title: 'Install',
    copy: 'Downloads the binary for Linux or macOS. For containers, pull ghcr.io/graphql-hive/router.',
    code: 'curl -o- https://raw.githubusercontent.com/graphql-hive/router/main/install.sh | sh',
    lang: 'sh',
  },
  {
    title: 'Point it at your supergraph',
    copy: 'This is the whole config for a local file. Hive Console and Apollo GraphOS work as sources too.',
    code: `supergraph:
  source: file
  path: ./supergraph.graphql`,
    lang: 'yaml',
  },
  {
    title: 'Run it',
    copy: 'Serves your supergraph on port 4000.',
    code: './hive_router',
    lang: 'sh',
  },
] as const;

const advancedCards: AdvancedCard[] = [
  {
    ctaHref: '/docs/router/customizations/plugin-system',
    description:
      'Plugins written in Rust and compiled into the router, with hooks into the HTTP, GraphQL, query planning and execution stages.',
    heading: 'Rust Plugin System',
    icon: '<svg fill="currentColor" height="24" viewBox="0 0 24 24" width="24"><path d="M8.68601 3.99988L11.293 1.39288C11.4805 1.20541 11.7348 1.1001 12 1.1001C12.2652 1.1001 12.5195 1.20541 12.707 1.39288L15.314 3.99988H19C19.2652 3.99988 19.5196 4.10524 19.7071 4.29278C19.8946 4.48031 20 4.73467 20 4.99988V8.68588L22.607 11.2929C22.7945 11.4804 22.8998 11.7347 22.8998 11.9999C22.8998 12.265 22.7945 12.5194 22.607 12.7069L20 15.3139V18.9999C20 19.2651 19.8946 19.5195 19.7071 19.707C19.5196 19.8945 19.2652 19.9999 19 19.9999H15.314L12.707 22.6069C12.5195 22.7944 12.2652 22.8997 12 22.8997C11.7348 22.8997 11.4805 22.7944 11.293 22.6069L8.68601 19.9999H5.00001C4.73479 19.9999 4.48044 19.8945 4.2929 19.707C4.10536 19.5195 4.00001 19.2651 4.00001 18.9999V15.3139L1.39301 12.7069C1.20554 12.5194 1.10022 12.265 1.10022 11.9999C1.10022 11.7347 1.20554 11.4804 1.39301 11.2929L4.00001 8.68588V4.99988C4.00001 4.73467 4.10536 4.48031 4.2929 4.29278C4.48044 4.10524 4.73479 3.99988 5.00001 3.99988H8.68601ZM6.00001 5.99988V9.51488L3.51501 11.9999L6.00001 14.4849V17.9999H9.51501L12 20.4849L14.485 17.9999H18V14.4849L20.485 11.9999L18 9.51488V5.99988H14.485L12 3.51488L9.51501 5.99988H6.00001ZM12 15.9999C10.9391 15.9999 9.92173 15.5785 9.17158 14.8283C8.42143 14.0782 8.00001 13.0608 8.00001 11.9999C8.00001 10.939 8.42143 9.9216 9.17158 9.17146C9.92173 8.42131 10.9391 7.99988 12 7.99988C13.0609 7.99988 14.0783 8.42131 14.8284 9.17146C15.5786 9.9216 16 10.939 16 11.9999C16 13.0608 15.5786 14.0782 14.8284 14.8283C14.0783 15.5785 13.0609 15.9999 12 15.9999ZM12 13.9999C12.5304 13.9999 13.0391 13.7892 13.4142 13.4141C13.7893 13.039 14 12.5303 14 11.9999C14 11.4695 13.7893 10.9607 13.4142 10.5857C13.0391 10.2106 12.5304 9.99988 12 9.99988C11.4696 9.99988 10.9609 10.2106 10.5858 10.5857C10.2107 10.9607 10 11.4695 10 11.9999C10 12.5303 10.2107 13.039 10.5858 13.4141C10.9609 13.7892 11.4696 13.9999 12 13.9999Z"></path></svg>',
    order: 'max-sm:order-10',
  },
  {
    ctaHref: '/docs/router/customizations/coprocessors',
    description:
      'External HTTP services in any language. The router calls them at the same stages, no Rust required.',
    heading: 'Coprocessors',
    icon: '<svg fill="currentColor" height="24" viewBox="0 0 24 24" width="24"><path d="M12.172 10.9999L7.515 6.34293L8.929 4.92993L15.999 11.9999L8.929 19.0709L7.515 17.6569L12.17 12.9999H3V10.9999H12.172ZM18 18.9999V4.99993H20V18.9999H18Z"></path></svg>',
  },
  {
    ctaHref: '/docs/router/guides/dynamic-subgraph-routing',
    description:
      'Route requests to a different subgraph instance per tenant, region or feature flag, and rewrite headers on the way through. A one-line expression in YAML, no code.',
    heading: 'Dynamic Routing',
    icon: '<svg fill="currentColor" height="24" viewBox="0 0 24 24" width="24"><path d="M20.083 15.2L21.285 15.921C21.3591 15.9654 21.4205 16.0283 21.4631 16.1035C21.5058 16.1787 21.5282 16.2636 21.5282 16.35C21.5282 16.4365 21.5058 16.5214 21.4631 16.5966C21.4205 16.6718 21.3591 16.7347 21.285 16.779L12.515 22.041C12.3594 22.1345 12.1814 22.1839 12 22.1839C11.8185 22.1839 11.6405 22.1345 11.485 22.041L2.71498 16.779C2.64082 16.7347 2.57944 16.6718 2.53682 16.5966C2.4942 16.5214 2.4718 16.4365 2.4718 16.35C2.4718 16.2636 2.4942 16.1787 2.53682 16.1035C2.57944 16.0283 2.64082 15.9654 2.71498 15.921L3.91698 15.2L12 20.05L20.083 15.2ZM20.083 10.5L21.285 11.221C21.3591 11.2654 21.4205 11.3283 21.4631 11.4035C21.5058 11.4787 21.5282 11.5636 21.5282 11.65C21.5282 11.7365 21.5058 11.8214 21.4631 11.8966C21.4205 11.9718 21.3591 12.0347 21.285 12.079L12 17.649L2.71498 12.079C2.64082 12.0347 2.57944 11.9718 2.53682 11.8966C2.4942 11.8214 2.4718 11.7365 2.4718 11.65C2.4718 11.5636 2.4942 11.4787 2.53682 11.4035C2.57944 11.3283 2.64082 11.2654 2.71498 11.221L3.91698 10.5L12 15.35L20.083 10.5ZM12.514 1.30905L21.285 6.57105C21.3591 6.61544 21.4205 6.6783 21.4631 6.75348C21.5058 6.82867 21.5282 6.91362 21.5282 7.00005C21.5282 7.08647 21.5058 7.17142 21.4631 7.24661C21.4205 7.3218 21.3591 7.38465 21.285 7.42905L12 12.999L2.71498 7.43005C2.64082 7.38565 2.57944 7.3228 2.53682 7.24761C2.4942 7.17242 2.4718 7.08747 2.4718 7.00105C2.4718 6.91462 2.4942 6.82967 2.53682 6.75448C2.57944 6.6793 2.64082 6.61644 2.71498 6.57205L11.485 1.31005C11.6405 1.2166 11.8185 1.16724 12 1.16724C12.1814 1.16724 12.3594 1.2166 12.515 1.31005M12 3.33205L5.88698 7.00005L12 10.668L18.113 7.00005L12 3.33205Z"></path></svg>',
  },
  {
    ctaHref: '/docs/router/guides/performance-tuning',
    description:
      'Deduplicate in-flight requests, trip a circuit breaker on a failing subgraph, tune timeouts and connection pools per subgraph and compress traffic in both directions.',
    heading: 'Traffic Shaping',
    icon: '<svg fill="currentColor" height="24" width="24"><path d="M5.25 7.5a2.25 2.25 0 1 1 3 2.122v4.756a2.251 2.251 0 1 1-1.5 0V9.622A2.25 2.25 0 0 1 5.25 7.5Zm9.22-2.03a.75.75 0 0 1 1.06 0l.97.97.97-.97a.75.75 0 1 1 1.06 1.06l-.97.97.97.97a.75.75 0 0 1-1.06 1.06l-.97-.97-.97.97a.75.75 0 1 1-1.06-1.06l.97-.97-.97-.97a.75.75 0 0 1 0-1.06Zm2.03 5.03a.75.75 0 0 1 .75.75v3.128a2.251 2.251 0 1 1-1.5 0V11.25a.75.75 0 0 1 .75-.75Z"></path></svg>',
  },
];

// The FAQ component prefixes site-relative hrefs itself, so these stay unprefixed.
const docsLink = (href: string, text: string) =>
  `<a class="hive-focus underline decoration-blue-500 underline-offset-2" href="${href}">${text}</a>`;

const faqs: [string, string][] = [
  [
    'Hive Router or Hive Gateway, which one should I pick?',
    `Both are open source and actively maintained. Hive Router is written in Rust for high throughput and low resource usage. ${docsLink('/gateway', 'Hive Gateway')} is written in TypeScript and runs on Node.js and other (serverless) JavaScript runtimes. Gateway provides more flexibility for teams that are already familiar with TypeScript. Both can serve a supergraph from a local file or a schema registry, such as Hive Console.`,
  ],
  [
    'Can I replace Apollo Router without changing my subgraphs?',
    `Yes. Hive Router consumes a standard Apollo Federation supergraph, so you keep your subgraphs and your composition pipeline and only swap the binary, while re-using your existing supergraph from a local file or even GraphOS. See the ${docsLink('/docs/router/compatibility', 'compatibility overview')} for the directives and features covered, and the ${docsLink('/docs/router/getting-started', 'getting started guide')}.`,
  ],
  [
    'Does Hive Router support GraphQL subscriptions?',
    `Yes. Federated subscriptions are built in, over Server-Sent Events, WebSockets or multipart HTTP. The protocol between the router and each subgraph can be configured individually. ${docsLink('/docs/router/subscriptions', 'Read more.')}`,
  ],
  [
    'How do I extend the router?',
    `There are two ways to extend Hive Router. ${docsLink('/docs/router/customizations/plugin-system', 'Plugins')} are written in Rust and compiled into the router. ${docsLink('/docs/router/customizations/coprocessors', 'Coprocessors')} are external HTTP services in any language that the router calls. Both support hooking into the HTTP, GraphQL, query planning and execution stages of a request.`,
  ],
  [
    'How does Hive Router integrate with my monitoring stack?',
    `It emits OpenTelemetry traces and Prometheus metrics, which you can send to Hive Console or any compatible backend, such as Datadog or Grafana, alongside structured logs, health and readiness probes. Furthermore, schema usage metrics can be sent to a schema registry such as Hive Console or GraphOS. ${docsLink('/docs/router/observability/tracing', 'Read more.')}`,
  ],
  [
    'Do I need Hive Console to use Hive Router?',
    `No. Hive Router is a standalone binary that can load a supergraph file and other sources such as Hive Console or Apollo GraphOS. Using Hive Console is fully optional and provides additional features such as a place to manage your supergraph, publish persisted documents and collect metrics. ${docsLink('/docs/router/configuration/supergraph', 'Read more.')}`,
  ],
  [
    'Are all Hive Router features open source?',
    `Yes. Hive Router is MIT licensed. Every feature ships in the same binary, with no license tiers. ${docsLink('/docs/router', 'Read more.')}`,
  ],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <BaseHead
      description="Hive Router is the most performant GraphQL Federation router in the ecosystem: open source, written in Rust, a drop-in replacement for Apollo Router, first on every metric in the open gateway benchmark and 100% compatible in the Federation audit."
      title="Hive Router | Hive"
    />
  </head>
  <body class="text-green-1000 bg-white font-sans [color-scheme:light]">
    <SiteNavigation />
    <main class="text-green-1000 light mx-auto max-w-360 overflow-hidden">
      <!-- Hero -->
      <div class="text-green-1000 relative isolate mx-4 flex max-w-360 flex-col items-center justify-center gap-6 overflow-hidden rounded-3xl bg-blue-400 px-4 py-6 max-sm:mt-2 sm:py-12 sm:pb-28! md:mx-6 md:gap-8 lg:py-24 lg:pb-[168px]!">
        <div class="relative">
          <Fragment
            set:html={routerMark(
              `class="absolute inset-1/2 size-1/2 -translate-1/2" fill="url(#router-logo-blue)" stroke="url(#router-logo-white)" stroke-width="0.5"`,
            )}
          />
          <svg fill="none" height="96" viewBox="0 0 96 96" width="96">
            <rect fill="url(#router-logo-green)" height="96" rx="24" width="96"></rect>
            <rect
              height="95"
              rx="23.5"
              stroke="url(#router-logo-white-box)"
              width="95"
              x="0.5"
              y="0.5"
            ></rect>
          </svg>
          <svg class="size-0" viewBox="0 0 48 48">
            <linearGradient
              gradientUnits="userSpaceOnUse"
              id="router-logo-blue"
              x1="0"
              x2="48"
              y1="0"
              y2="48"
            >
              <stop stop-color="#A7D5CA"></stop>
              <stop offset="1" stop-color="#86B6C1"></stop>
            </linearGradient>
            <linearGradient
              gradientUnits="userSpaceOnUse"
              id="router-logo-white"
              x1="0"
              x2="48"
              y1="0"
              y2="48"
            >
              <stop stop-color="white" stop-opacity="0.5"></stop>
              <stop offset="1" stop-color="white" stop-opacity="0.2"></stop>
            </linearGradient>
          </svg>
        </div>
        <p class="text-green-1000 -mb-2 text-center text-sm font-medium tracking-wide uppercase md:-mb-4">
          Hive Router
        </p>
        <h1 class="group mx-auto max-w-4xl text-center text-4xl leading-[1.2] tracking-[-0.64px] text-balance md:text-[4rem] md:leading-[1.1875]">
          The most performant federation router in the ecosystem
        </h1>
        <p class="mx-auto w-[640px] max-w-[80%] text-center leading-6 text-green-800">
          Open source and written in Rust. Highest throughput, lowest latency and lowest memory in
          the open Federation gateway benchmark, with a perfect score on the Federation audit.
        </p>
        <ul class="mx-auto flex list-none gap-x-6 gap-y-2 text-sm font-medium max-md:flex-col">
          {checkmarks.map(text => (
            <li class="flex items-center gap-2">
              <Fragment set:html={withAttrs(checkIconRaw, `class="text-green-800"`)} />
              {text}
            </li>
          ))}
        </ul>
        <div class="flex w-full justify-center gap-2 px-0.5 max-sm:flex-col sm:gap-4">
          <HeroButton href={withBase('/docs/router/getting-started')}>Get started</HeroButton>
          <HeroButton href={withBase('/docs/router')} variant="secondary">
            Documentation
          </HeroButton>
          <HeroButton href={REPO_URL} rel="noreferrer" target="_blank" variant="ghost">
            GitHub
          </HeroButton>
        </div>

        <!-- Hero decoration -->
        <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
          <Fragment
            set:html={routerMark(
              `class="absolute left-[-268px] top-[-8px] size-[520px] fill-[url(#router-hero-gradient)] max-lg:hidden"`,
            )}
          />
          <Fragment
            set:html={routerMark(
              `class="absolute right-[-144px] top-[-64px] size-[320px] fill-[url(#router-hero-gradient-mobile)] md:bottom-[-64px] md:right-[-268px] md:top-auto md:size-[520px] md:fill-[url(#router-hero-gradient)] lg:bottom-[-8px]"`,
            )}
          />
          <svg
            class="pointer-events-none -z-50 size-0"
            height="296"
            viewBox="0 0 192 296"
            width="192"
          >
            <defs>
              <linearGradient gradientTransform="rotate(139)" id="router-hero-gradient">
                <stop offset="11.66%" stop-color="rgba(255, 255, 255, 0.1)"></stop>
                <stop offset="74.87%" stop-color="rgba(255, 255, 255, 0.3)"></stop>
              </linearGradient>
              <linearGradient
                gradientUnits="userSpaceOnUse"
                id="router-hero-gradient-mobile"
                x1="35.3488"
                x2="224.372"
                y1="15.0697"
                y2="229.023"
              >
                <stop stop-color="white" stop-opacity="0.2"></stop>
                <stop offset="80%" stop-color="white"></stop>
              </linearGradient>
            </defs>
          </svg>
        </div>

        <svg class="size-0" viewBox="0 0 96 96">
          <defs>
            <linearGradient id="router-logo-green" x1="0%" x2="100%" y1="0%" y2="100%">
              <stop stop-color="#3B736A"></stop>
              <stop offset="1" stop-color="#15433C"></stop>
            </linearGradient>
            <linearGradient id="router-logo-white-box" x1="0%" x2="100%" y1="0%" y2="100%">
              <stop stop-color="#fff" stop-opacity="0.8"></stop>
              <stop offset="1" stop-color="#fff" stop-opacity="0.4"></stop>
            </linearGradient>
          </defs>
        </svg>
      </div>

      <!-- The numbers -->
      <section class="border-beige-400 relative mx-auto mt-6 w-312 max-w-full rounded-3xl bg-white sm:mt-[-72px] sm:max-w-[calc(100%-4rem)] sm:border md:p-6">
        <ul class="grid list-none gap-4 max-sm:px-4 sm:grid-cols-2 lg:grid-cols-4">
          {stats.map(stat => (
            <li>
              <a
                class="hive-focus hover:bg-beige-100 flex h-full flex-col gap-2 rounded-2xl bg-blue-100 p-6 transition-colors"
                href={stat.href}
                rel="noreferrer"
                target="_blank"
              >
                <strong class="text-green-1000 text-4xl leading-none font-medium tracking-[-0.48px] md:text-5xl">
                  {stat.value}
                </strong>
                <span class="text-sm/5 text-green-800">{stat.label}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-4 px-4 text-xs text-green-800 md:px-0">
          Benchmark figures are from our{' '}
          <a
            class="hive-focus underline decoration-blue-500 underline-offset-2"
            href={BENCHMARK_URL}
          >
            open Federation gateway benchmark
          </a>{' '}
          on a 4 vCPU Azure VM with 50 virtual users. Rerun it yourself: every gateway, query and
          subgraph is in the repository.
        </p>
      </section>

      <!-- Why Hive Router -->
      <section class="px-4 py-6 sm:py-12 md:px-6 lg:py-24 xl:px-[120px]">
        <header class="md:text-center md:text-balance">
          <h2 class="group text-4xl leading-[1.2] tracking-[-0.48px] md:text-5xl md:leading-[1.16667]">
            Why Hive Router
          </h2>
          <p class="mt-4 text-green-800">
            Everything a production federation router needs, in one binary, with no license tiers.
          </p>
        </header>
        <dl class="mt-8 grid gap-4 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3 lg:gap-6">
          {highlights.map(item => (
            <a
              class="hive-focus bg-beige-100 hover:bg-beige-200 group flex flex-col rounded-2xl border border-transparent p-6 transition-colors"
              href={withBase(item.href)}
            >
              <dt class="text-green-1000 text-xl leading-[1.4] font-medium">{item.title}</dt>
              <dd class="mt-3 text-sm/6 text-green-800">{item.description}</dd>
              <dd class="text-green-1000 mt-auto flex items-center gap-2 pt-4 text-sm font-medium">
                Learn more
                <svg
                  class="size-5 transition-transform group-hover:translate-x-1"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path d="m15.755 11.1-4.828-4.828L12.2 5l7 7-7 7-1.273-1.272 4.828-4.828H4.8v-1.8h10.955Z" />
                </svg>
              </dd>
            </a>
          ))}
        </dl>
      </section>

      <!-- Quick start -->
      <section class="bg-green-1000 relative isolate mx-4 overflow-hidden rounded-3xl px-4 py-6 text-white md:mx-6 md:px-8 md:py-16 xl:p-24">
        <div class="relative z-10 lg:grid lg:grid-cols-[minmax(0,380px)_minmax(0,1fr)] lg:gap-16">
          <header>
            <h2 class="group text-4xl leading-[1.2] tracking-[-0.48px] md:text-5xl md:leading-[1.16667]">
              From zero to a running supergraph in three steps
            </h2>
            <p class="mt-6 text-white/80">
              No runtime to install, nothing to compile. Bring a supergraph schema and the router
              serves it on port 4000, with a GraphQL IDE included.
            </p>
            <a
              class="text-green-1000 bg-primary relative mt-8 inline-flex items-center justify-center gap-2 rounded-lg px-6 py-3 leading-6 font-medium text-nowrap hover:bg-white focus-visible:outline-4 focus-visible:outline-offset-0 focus-visible:outline-white/40"
              href={withBase('/docs/router/getting-started')}
            >
              <span class="absolute inset-0 rounded-lg border border-green-800"></span>
              Full getting started guide
            </a>
          </header>
          <ol class="mt-8 flex list-none flex-col gap-6 lg:mt-0">
            {quickStart.map((step, i) => (
              <li class="flex gap-4">
                <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-white/10 text-sm font-medium">
                  {i + 1}
                </span>
                <div class="min-w-0 grow">
                  <h3 class="text-xl/7 font-medium">{step.title}</h3>
                  <p class="mt-1 text-sm/6 text-white/80">{step.copy}</p>
                  <div class="relative mt-3">
                    <Code
                      class="rounded-xl bg-green-900! p-4 pr-14 text-sm [&_code]:text-sm"
                      code={step.code}
                      lang={step.lang}
                      theme="github-dark"
                    />
                    <button
                      class="hive-focus absolute top-2 right-2 rounded-lg bg-green-900 p-2 text-white/70 shadow-[-12px_0_12px_var(--color-green-900)] transition-colors hover:bg-white/10 hover:text-white data-copied:text-green-300 [&>svg]:size-5 [&[data-copied]>[data-copy-icon]]:hidden [&:not([data-copied])>[data-check-icon]]:hidden"
                      aria-label="Copy to clipboard"
                      data-copy-snippet={step.code}
                      type="button"
                    >
                      <svg
                        data-copy-icon
                        aria-hidden="true"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                      >
                        <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
                        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
                      </svg>
                      <svg
                        data-check-icon
                        aria-hidden="true"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                      >
                        <path d="m20 6-11 11-5-5" />
                      </svg>
                    </button>
                  </div>
                </div>
              </li>
            ))}
          </ol>
        </div>
        <div class="pointer-events-none absolute inset-0 overflow-hidden max-lg:hidden">
          <Fragment
            set:html={routerMark(
              `class="absolute right-[-160px] bottom-[-160px] size-[560px] fill-none stroke-[url(#router-quickstart-stroke)]" stroke-width="0.4"`,
            )}
          />
          <svg class="size-0">
            <defs>
              <linearGradient
                gradientUnits="userSpaceOnUse"
                id="router-quickstart-stroke"
                x1="0"
                x2="48"
                y1="0"
                y2="48"
              >
                <stop stop-color="#fff" stop-opacity=".1"></stop>
                <stop offset="1" stop-color="#fff" stop-opacity=".5"></stop>
              </linearGradient>
            </defs>
          </svg>
        </div>
      </section>

      <!-- Federation compatibility -->
      <section class="px-4 py-6 sm:py-12 md:px-6 lg:py-24 xl:px-[120px]">
        <div class="bg-blue-100 flex flex-col gap-8 rounded-3xl p-6 md:p-12 lg:flex-row lg:items-center lg:gap-16">
          {
            // Like the stat tile, the score is only shown when the live audit data backs it.
            audit && (
              <div class="shrink-0 lg:w-1/3">
                <strong class="text-green-1000 block text-6xl leading-none font-medium tracking-[-0.96px] md:text-8xl">
                  {audit.percent}%
                </strong>
                <span class="mt-3 block text-sm/5 text-green-800">
                  {audit.passed} of {audit.cases} test cases across {audit.suites} suites
                </span>
              </div>
            )
          }
          <div>
            <h2 class="group text-4xl leading-[1.2] tracking-[-0.48px] md:text-5xl md:leading-[1.16667]">
              Compatible with Apollo Federation, checked on every release
            </h2>
            <p class="mt-4 text-green-800">
              Our open Federation audit runs the same test suite against every gateway in the
              ecosystem: entities, @interfaceObject, @requires, @provides, @override and the other
              Federation directives, plus the edge cases our users have hit in production. We run it
              continuously, so the results page is always current.
            </p>
            <div class="mt-6 flex flex-wrap gap-2 sm:gap-4">
              <a
                class="text-green-1000 hive-focus relative inline-flex items-center justify-center gap-2 rounded-lg bg-white px-6 py-3 leading-6 font-medium text-nowrap hover:bg-beige-100"
                href={AUDIT_URL}
                rel="noreferrer"
                target="_blank"
              >
                <span class="absolute inset-0 rounded-lg border border-green-800"></span>
                See the live audit results
              </a>
              <a
                class="text-green-1000 hive-focus relative inline-flex items-center justify-center gap-2 rounded-lg bg-transparent px-6 py-3 leading-6 font-medium text-nowrap"
                href={withBase('/docs/router/compatibility')}
              >
                <span class="absolute inset-0 rounded-lg border border-green-800"></span>
                Compatibility overview
              </a>
            </div>
          </div>
        </div>
      </section>

      <LetsGetAdvancedSection
        cards={advancedCards}
        description="Extend the router with your own code and decide how traffic moves through it."
        title="Make it yours"
      />
      <ExploreMainProductCards class="max-lg:mx-4 max-lg:my-8" />
      <FrequentlyAskedQuestions faqs={faqs} class="mx-4 md:mx-6" />
      <GetYourAPIGameRightList class="mx-4 sm:mb-6 md:mx-6" />
    </main>

    <SiteFooter />
    <script>
      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-snippet]')) {
        button.addEventListener('click', async () => {
          await navigator.clipboard.writeText(button.dataset.copySnippet ?? '');
          button.dataset.copied = '';
          button.ariaLabel = 'Copied';
          window.setTimeout(() => {
            delete button.dataset.copied;
            button.ariaLabel = 'Copy to clipboard';
          }, 1500);
        });
      }
    </script>
  </body>
</html>
