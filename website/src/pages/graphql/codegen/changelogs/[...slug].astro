---
/** One page per package CHANGELOG.md from the codegen repo. */
import CodeBlock from '~hive/components/mdx/CodeBlock.astro';
import Table from '~hive/components/mdx/Table.astro';
import { getHeadingHtmlBySlug } from '~hive/lib/docs-markdown';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import CodegenDocsLayout from '../../../../codegen/layouts/CodegenDocsLayout.astro';
import { getCodegenChangelogsNav } from '../../../../codegen/lib/docs-nav';
import { CODEGEN_REPO_URL } from '../../../../codegen/lib/site';

type Entry = CollectionEntry<'codegenChangelogs'>;

export async function getStaticPaths() {
  const entries = await getCollection('codegenChangelogs');
  return entries.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: Entry };
const { Content, headings: renderedHeadings } = await render(entry);
const headingHtmlBySlug = getHeadingHtmlBySlug(entry.body ?? '', renderedHeadings);
const headings = renderedHeadings.map(heading => ({
  ...heading,
  html: headingHtmlBySlug.get(heading.slug) ?? heading.text,
}));
const { items: navItems, tree: navTree } = await getCodegenChangelogsNav();
---

<CodegenDocsLayout
  currentPath={`/changelogs/${entry.id}`}
  description={entry.data.description}
  githubUrl={`${CODEGEN_REPO_URL}/blob/master/packages/${entry.id}/CHANGELOG.md`}
  headings={headings}
  longPage={(entry.body?.length ?? 0) > 60_000}
  navItems={navItems}
  navTree={navTree}
  searchSection="Changelogs"
  section="GraphQL Codegen Changelogs"
  title={entry.data.title}
>
  <!-- Release notes stay out of search: every version would match the docs' terms. -->
  <div data-pagefind-ignore="all">
    <Content components={{ pre: CodeBlock, table: Table }} />
  </div>
</CodegenDocsLayout>
