---
import { getCollection, type CollectionEntry } from 'astro:content';
import MeshDocsPage from '../../../../mesh/components/MeshDocsPage.astro';
import { getMeshDocsNav } from '../../../../mesh/lib/docs-nav';

type Entry = CollectionEntry<'meshDocs'>;

export async function getStaticPaths() {
  const entries = await getCollection('meshDocs');
  return entries.map(entry => ({
    params: { slug: entry.id.replace(/\.(md|mdx)$/, '').replace(/(^|\/)index$/, '') || undefined },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: Entry };
const extension = entry.filePath?.match(/\.mdx?$/)?.[0] ?? '.mdx';
---

<MeshDocsPage
  docsBase="/v1"
  entry={entry}
  githubPath={`website/content/v1/${entry.id}${extension}`}
  nav={await getMeshDocsNav()}
  searchSection="Documentation"
  section="GraphQL Mesh"
/>
