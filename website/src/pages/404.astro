---
// Also load-bearing: emitting dist/404.html disables Cloudflare Pages'
// SPA fallback, which otherwise serves the homepage with HTTP 200 for
// every unknown path (soft 404s).
import CommandLink from '../components/CommandLink.astro';
import { guildMark } from '../components/product-logos';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found | The Guild" description="This page does not exist.">
  <main class="flex min-h-screen flex-col items-center justify-center px-6 text-center">
    <svg
      aria-hidden="true"
      class="mb-6 size-10 text-[var(--faint)]"
      fill="currentColor"
      viewBox={guildMark.viewBox}
      xmlns="http://www.w3.org/2000/svg"
      set:html={guildMark.markup}
    />
    <div class="mb-3.5 font-mono text-xs tracking-label text-[var(--muted)] lowercase">
      ~/the-guild/404
    </div>
    <h1 class="mb-4 font-mono text-5xl font-semibold text-[var(--strong)]">
      404: page not found<span
        aria-hidden="true"
        class="ml-[.13em] inline-block h-[.82em] w-[.09em] animate-blink bg-[var(--green)] align-[-.04em] motion-reduce:animate-none"
      ></span>
    </h1>
    <p class="mb-8 max-w-[440px] text-base text-[var(--muted)]">
      The path you requested doesn't exist. It may have moved to the <a
        class="text-[var(--text)] underline decoration-[var(--line-strong)] underline-offset-2 hover:text-[var(--strong)] hover:decoration-current"
        href="/graphql/hive">Hive site</a
      >.
    </p>
    <div class="flex flex-wrap justify-center gap-2.5">
      <CommandLink href="/" primary>go home</CommandLink>
      <CommandLink href="/blog">read the blog</CommandLink>
    </div>
  </main>
</Layout>
