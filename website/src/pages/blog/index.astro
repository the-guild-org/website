---
import CommandLink from '../../components/CommandLink.astro';
import Footer from '../../components/Footer.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Layout from '../../layouts/Layout.astro';
import { getAllPosts } from '../../lib/posts';

const posts = await getAllPosts();

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Layout
  title="Blog | The Guild"
  description="Writing from The Guild on open source, GraphQL, and the craft of long-term software."
>
  <SiteHeader>
    <span class="text-[var(--muted)]">/ blog</span>
    <Fragment slot="actions"
      ><CommandLink href="/graphql/hive/blog">hive blog</CommandLink></Fragment
    >
  </SiteHeader>

  <main>
    <div class="mx-auto w-[calc(100%-24px)] max-w-shell sm:w-[calc(100%-40px)]">
      <div class="max-w-[820px] py-[64px] sm:py-[88px]">
        <div class="mb-3.5 font-mono text-[12px] tracking-[.075em] text-[var(--muted)] lowercase">
          ~/the-guild/blog
        </div>
        <h1
          class="mb-3.5 font-mono text-[clamp(30px,4.5vw,52px)] leading-[1.1] font-semibold tracking-[-.045em] text-balance text-[var(--strong)]"
        >
          The Guild blog.
        </h1>
        <p class="max-w-[700px] text-[17px] leading-[1.65] text-[var(--muted)]">
          Writing on open source, GraphQL, and the craft of long-term software. Product posts live
          on the <a
            class="text-[var(--text)] underline decoration-[var(--line-strong)] underline-offset-2 hover:text-[var(--strong)] hover:decoration-current"
            href="/graphql/hive/blog">Hive blog</a
          >.
        </p>
      </div>

      <div class="border-t border-[var(--line-strong)] pb-[90px]">
        {
          posts.map(post => (
            <a
              class="group grid grid-cols-1 gap-x-8 border-b border-[var(--line)] py-6 transition-colors hover:border-[var(--line-strong)] sm:grid-cols-[130px_1fr]"
              href={post.href}
            >
              <div class="pt-0.5 font-mono text-[13px] text-[var(--green)] tabular-nums">
                {formatDate(post.date)}
              </div>
              <div>
                <h2 class="font-mono text-[18px] font-semibold text-[var(--strong)] transition-colors group-hover:underline">
                  {post.title}
                  {post.external && ' '}
                  {post.external && (
                    <span
                      aria-hidden="true"
                      class:list={[
                        'ml-1.5 inline-block font-mono text-[13px] font-normal transition-transform group-hover:translate-x-0.5',
                        post.external === 'hive' ? 'text-[var(--hive)]' : 'text-[var(--stellate)]',
                      ]}
                    >
                      ↗
                    </span>
                  )}
                </h2>
                <p class="mt-1.5 max-w-[720px] text-[15px] text-[var(--muted)]">
                  {post.description}
                </p>
                <div class="mt-2.5 flex flex-wrap gap-x-3 gap-y-1 font-mono text-[11px] text-[var(--faint)]">
                  {post.tags.map(tag => (
                    <span>#{tag}</span>
                  ))}
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </main>

  <Footer />
</Layout>
