---
/**
 * Every session The Guild gave at GraphQLConf, one block per edition, newest
 * first. The data lives in src/lib/graphqlconf.ts; each session links to its
 * graphql.org page, which carries the recording.
 */
import CommandLink from '../components/CommandLink.astro';
import Footer from '../components/Footer.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Layout from '../layouts/Layout.astro';
import { conferences, sessionCount, sessionTypeLabel } from '../lib/graphqlconf';

const keynotes = conferences.flatMap(c => c.sessions).filter(s => s.type === 'keynote').length;
const workshops = conferences.flatMap(c => c.sessions).filter(s => s.type === 'workshop').length;
const first = conferences.at(-1)!.year;
const last = conferences[0]!.year;

const stats = [
  [String(sessionCount), 'sessions'],
  [String(conferences.length), `conferences, ${first} to ${last}`],
  [String(keynotes), 'keynotes'],
  [String(workshops), 'workshops'],
] as const;

const speakersLine = (speakers: string[]) => speakers.join(', ');
---

<Layout
  title="The Guild at GraphQLConf"
  description={`Every talk, keynote and workshop The Guild gave at GraphQLConf from ${first} to ${last}, with a link to each recording.`}
>
  <SiteHeader>
    <span class="text-[var(--faint)]">/</span>
    <span class="text-[var(--muted)]">graphqlconf</span>
    <Fragment slot="actions">
      <CommandLink href="https://graphql.org/conf/" rel="noopener noreferrer" target="_blank">
        graphql.org/conf
      </CommandLink>
    </Fragment>
  </SiteHeader>

  <main>
    <section class="border-b border-[var(--line)] py-[72px] sm:py-[112px]">
      <div class="mx-auto w-[calc(100%-24px)] max-w-shell sm:w-[calc(100%-40px)]">
        <div class="mb-4 font-mono text-xs tracking-label text-[var(--muted)]">
          ~/the-guild/graphqlconf
        </div>
        <h1 class="max-w-[900px] font-mono text-7xl font-semibold text-balance text-[var(--strong)]">
          The Guild at GraphQLConf.
        </h1>
        <p class="mt-6 max-w-[680px] text-lg leading-[1.7] text-[var(--muted)]">
          GraphQLConf is the official conference of the GraphQL Foundation. We have sponsored it and
          spoken at it every year since the first edition. This is every session, with a link to its
          recording on graphql.org.
        </p>
        <dl class="mt-10 grid max-w-[760px] grid-cols-2 gap-px overflow-hidden border border-[var(--line)] bg-[var(--line)] sm:grid-cols-4">
          {stats.map(([value, label]) => (
            <div class="bg-[var(--bg)] px-5 py-4">
              <dd class="font-mono text-3xl font-semibold text-[var(--strong)] tabular-nums">
                {value}
              </dd>
              <dt class="mt-1 font-mono text-xs text-[var(--muted)]">{label}</dt>
            </div>
          ))}
        </dl>
        <nav class="mt-8 flex flex-wrap gap-x-1 gap-y-2" aria-label="Editions">
          {conferences.map(conf => (
            <CommandLink href={`#${conf.year}`}>{conf.year}</CommandLink>
          ))}
        </nav>
      </div>
    </section>

    {conferences.map(conf => (
      <section
        class="scroll-mt-16 border-b border-[var(--line)] py-[68px] sm:py-[96px]"
        id={String(conf.year)}
      >
        <div class="mx-auto grid w-[calc(100%-24px)] max-w-shell grid-cols-1 gap-12 sm:w-[calc(100%-40px)] lg:grid-cols-[minmax(240px,.7fr)_minmax(0,1.3fr)] lg:gap-20">
          <div class="lg:sticky lg:top-24 lg:self-start">
            <div class="mb-3 font-mono text-xs tracking-label text-[var(--muted)]">
              ~/graphqlconf/{conf.year}
            </div>
            <h2 class="font-mono text-5xl font-semibold text-[var(--strong)]">
              GraphQLConf {conf.year}
            </h2>
            <p class="mt-4 text-[var(--muted)]">
              {conf.dates}
              <br />
              {conf.city}
              <br />
              {conf.role}
            </p>
            <p class="mt-2 font-mono text-xs text-[var(--faint)]">
              {conf.sessions.length} sessions
            </p>
            <div class="mt-5 flex flex-wrap gap-x-1 gap-y-2">
              <CommandLink href={conf.scheduleHref} rel="noopener noreferrer" target="_blank">
                full schedule
              </CommandLink>
              {conf.playlistHref && (
                <CommandLink href={conf.playlistHref} rel="noopener noreferrer" target="_blank">
                  youtube playlist
                </CommandLink>
              )}
              {conf.recapHref && <CommandLink href={conf.recapHref}>our recap</CommandLink>}
            </div>
          </div>

          <ul class="border-t border-[var(--line-strong)]">
            {conf.sessions.map(session => (
              <li>
                <a
                  class="group grid grid-cols-1 gap-x-8 gap-y-1 border-b border-[var(--line)] py-5 transition-colors hover:border-[var(--line-strong)] focus-visible:outline focus-visible:outline-offset-4 focus-visible:outline-[var(--green)] sm:grid-cols-[130px_1fr]"
                  href={session.href}
                  rel="noopener noreferrer"
                  target="_blank"
                >
                  <span
                    class:list={[
                      'font-mono text-xs tracking-label uppercase',
                      session.type === 'keynote' ? 'text-[var(--green)]' : 'text-[var(--faint)]',
                    ]}
                  >
                    {sessionTypeLabel(session.type)}
                  </span>
                  <span>
                    <span class="block font-medium text-[var(--strong)] group-hover:underline group-hover:decoration-[var(--line-strong)] group-hover:underline-offset-4">
                      {session.title}
                    </span>
                    <span class="mt-1 block text-sm text-[var(--muted)]">
                      {speakersLine(session.speakers)}
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))}

    <section class="py-[68px] sm:py-[96px]">
      <div class="mx-auto w-[calc(100%-24px)] max-w-shell sm:w-[calc(100%-40px)]">
        <div class="max-w-[760px] border-t border-[var(--line)] pt-6">
          <h2 class="font-mono text-2xl font-semibold tracking-[-.035em] text-[var(--strong)]">
            Meet us at the next one.
          </h2>
          <p class="mt-3 mb-5 text-[var(--muted)]">
            Come by the booth or write to us beforehand, and we'll find time to talk about your
            GraphQL setup.
          </p>
          <CommandLink href="https://the-guild.dev/contact" primary>
            contact the guild
          </CommandLink>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
