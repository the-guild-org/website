---
import { gateways, testCasesTotal, testSuitesTotal } from "./gateways-data";

const rows = [...gateways].sort((a, b) => b.okTestCases - a.okTestCases);
---

<div class="relative w-full overflow-x-auto">
  <table class="w-full caption-bottom text-sm mt-6 font-mono">
    <thead class="[&_tr]:border-b">
      <tr class="hover:bg-beige-100 border-beige-400 border-b transition-colors hover:transition-none dark:border-neutral-800 dark:hover:bg-neutral-800/25 bg-beige-100 hover:bg-beige-100 dark:bg-neutral-800/50 hover:dark:bg-neutral-800/50">
        <th class="whitespace-nowrap p-2 text-left align-middle font-medium w-[100px]">Gateway</th>
        <th class="whitespace-nowrap p-2 text-left align-middle font-medium text-center">Compatibility</th>
        <th class="whitespace-nowrap p-2 text-left align-middle font-medium text-center">Test Cases</th>
        <th class="whitespace-nowrap p-2 text-left align-middle font-medium text-center">Test Suites</th>
      </tr>
    </thead>
    <tbody class="[&_tr:last-child]:border-0">
      {
        rows.map((row) => (
          <tr class="hover:bg-beige-100 border-beige-400 border-b transition-colors hover:transition-none dark:border-neutral-800 dark:hover:bg-neutral-800/25">
            <td class="whitespace-nowrap p-2 align-middle font-medium">{row.name}</td>
            <td class="whitespace-nowrap p-2 align-middle text-center font-medium">
              {((row.okTestCases * 100) / testCasesTotal).toFixed(2)}
              <span class="text-green-800 dark:text-neutral-400">%</span>
            </td>
            <td class="whitespace-nowrap p-2 align-middle space-x-2 text-center">
              <span class="text-green-600 dark:text-green-500">✓ {row.okTestCases}</span>
              {testCasesTotal - row.okTestCases > 0 && (
                <span class="text-red-600 dark:text-red-500">✗ {testCasesTotal - row.okTestCases}</span>
              )}
            </td>
            <td class="whitespace-nowrap p-2 align-middle space-x-2 text-center">
              <span class="text-green-600 dark:text-green-500">✓ {row.okTestSuites}</span>
              {testSuitesTotal - row.okTestSuites > 0 && (
                <span class="text-red-600 dark:text-red-500">✗ {testSuitesTotal - row.okTestSuites}</span>
              )}
            </td>
          </tr>
        ))
      }
    </tbody>
    <caption class="mt-2 text-sm text-green-800 dark:text-neutral-400 text-xs">
      Results from our open-source{" "}
      <a
        class="underline"
        href="http://the-guild.dev/graphql/hive/federation-gateway-audit"
        rel="noreferrer"
        target="_blank"
        title="Open Source GraphQL federation gateways compatibility audit"
      >
        audit
      </a>
    </caption>
  </table>
</div>
