---
import { gateways } from './gateways-data';

const data = [...gateways].sort((a, b) => a.p99_9 - b.p99_9);
const max = Math.max(...data.map(d => d.p99_9));
---

<div class="my-4 space-y-5 font-mono">
  {
    data.map(d => (
      <div>
        <div class="mb-1 flex items-center justify-between text-sm">
          <span>{d.name}</span>
          <span class="text-green-800 tabular-nums dark:text-neutral-400">
            p95 {d.p95.toFixed(1)} ms | p99.9 {d.p99_9.toFixed(1)} ms
          </span>
        </div>
        <div class="border-beige-300 bg-beige-100 relative h-4 border dark:border-zinc-800 dark:bg-zinc-900">
          <div
            class="absolute top-1/2 h-full w-[4px] -translate-y-1/2 bg-sky-600"
            style={`left: ${(d.p95 / max) * 100}%`}
            title={`p95 ${d.p95}ms`}
          />
          <div
            class="absolute top-1/2 h-full w-[4px] -translate-y-1/2 bg-rose-600"
            style={`left: ${(d.p99_9 / max) * 100}%`}
            title={`p99.9 ${d.p99_9}ms`}
          />
        </div>
      </div>
    ))
  }
  <div class="text-center text-xs text-green-700 dark:text-neutral-400">
    Axis scaled to the highest p99.9 across gateways
  </div>
</div>
