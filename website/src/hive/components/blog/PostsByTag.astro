---
import type { BlogPost } from "../../lib/get-blog-posts";

import CategorySelect from "./CategorySelect.astro";
import FeaturedPosts from "./FeaturedPosts.astro";
import LatestPosts from "./LatestPosts.astro";

const TOP_10_TAGS = [
  "graphql",
  "graphql-federation",
  "codegen",
  "typescript",
  "react",
  "graphql-hive",
  "node",
  "graphql-modules",
  "angular",
  "graphql-tools",
];

interface Props {
  class?: string;
  posts: BlogPost[];
  tag?: string | null;
}

const { class: className, posts: postsProp, tag: tagProp } = Astro.props;
const tag = tagProp ?? null;

const posts = [...postsProp].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
);

let categories = TOP_10_TAGS;
if (tag && !TOP_10_TAGS.includes(tag)) {
  categories = [tag, ...TOP_10_TAGS];
}
---

<section class:list={["px-4 sm:px-6", className]}>
  <CategorySelect categories={categories} tag={tag} />
  <FeaturedPosts class="sm:mb-12 md:mt-16" posts={posts} tag={tag} />
  {
    Astro.slots.has("default") ? (
      <LatestPosts posts={posts} tag={tag}>
        <slot />
      </LatestPosts>
    ) : (
      <LatestPosts posts={posts} tag={tag} />
    )
  }
</section>
