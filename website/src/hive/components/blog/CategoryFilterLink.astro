---
import { withBase } from '../../lib/base-path';
import { prettyPrintTag } from '../../lib/pretty-print-tag';

interface Props {
  category: string | null;
  currentCategory: string | null;
}

const { category, currentCategory } = Astro.props;
const isActive = currentCategory === category;
---

<a
  class:list={[
    'hive-focus inline-block min-w-16 rounded-full border border-green-200 px-3 py-2.5 text-center outline-hidden transition duration-100 hover:border-green-800 focus-visible:ring-3 dark:border-neutral-700 dark:hover:border-neutral-500',
    isActive
      ? 'text-green-1000 bg-green-200 hover:bg-transparent! hover:text-green-800 dark:bg-neutral-800 dark:text-white dark:hover:text-white/80'
      : 'hover:bg-beige-100 hover:text-green-1000 text-green-800 dark:text-white/80 dark:hover:bg-neutral-800 dark:hover:text-white',
  ]}
  href={withBase(category ? `/blog/tag/${category}` : '/blog')}
>
  {prettyPrintTag(category || 'All')}
</a>
