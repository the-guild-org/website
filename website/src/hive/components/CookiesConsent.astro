<div
  class="fixed bottom-0 z-50 flex flex-wrap items-center justify-center gap-x-4 gap-y-3 rounded-lg border border-beige-200 bg-beige-100 p-4 text-center text-sm text-green-800 shadow-xl lg:flex-nowrap lg:justify-between lg:text-left dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-200"
  data-cookies-consent
  hidden
>
  <div>
    <p class="inline sm:block">
      This site uses cookies for analytics and improving your experience.
    </p>{" "}
    <p class="inline sm:block">
      By using our services, you consent to cookies.
    </p>
  </div>
  <div class="ml-auto flex w-auto items-center justify-end gap-4">
    <a
      class="hive-focus whitespace-nowrap rounded-sm p-1 hover:text-blue-700 hover:underline dark:hover:text-blue-100"
      href="https://the-guild.dev/graphql/hive/privacy-policy.pdf"
      rel="noopener noreferrer"
      target="_blank"
    >
      Privacy Policy
    </a>
    <button
      class="relative flex cursor-pointer items-center justify-center gap-2 text-nowrap rounded-lg bg-transparent px-4 py-2 font-medium leading-6 text-green-1000 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-green-800 dark:text-neutral-200"
      data-cookies-consent-allow
      type="button"
    >
      <span class="absolute inset-0 rounded-lg border border-green-800 dark:border-neutral-200"></span>
      Allow
    </button>
  </div>
</div>

<style>
  [data-cookies-consent]:not([hidden]) {
    animation: cookie-consent-in 300ms ease-out both;
  }

  [data-cookies-consent][data-state="closing"] {
    animation: cookie-consent-out 300ms ease-in both;
  }

  @keyframes cookie-consent-in {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }
  }

  @keyframes cookie-consent-out {
    to {
      opacity: 0;
      transform: translateY(1.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-cookies-consent]:not([hidden]),
    [data-cookies-consent][data-state="closing"] {
      animation-duration: 1ms;
    }
  }
</style>

<script>
  const storageKey = "cookies";
  const banner = document.querySelector<HTMLElement>("[data-cookies-consent]");
  const allowButton = banner?.querySelector<HTMLButtonElement>(
    "[data-cookies-consent-allow]",
  );

  if (banner && localStorage.getItem(storageKey) !== "true") {
    banner.hidden = false;
  }

  allowButton?.addEventListener("click", () => {
    if (!banner) return;
    localStorage.setItem(storageKey, "true");
    banner.dataset.state = "closing";
  });

  banner?.addEventListener("animationend", () => {
    if (banner.dataset.state === "closing") banner.hidden = true;
  });

  window.addEventListener("storage", (event) => {
    if (banner && event.key === storageKey && event.newValue === "true") {
      banner.hidden = true;
    }
  });
</script>
