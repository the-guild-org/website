<script>
  const navigation = document.querySelector<HTMLElement>('#hive-navigation');
  const container = document.querySelector<HTMLElement>('#h-navmenu-container');
  const viewport = document.querySelector<HTMLElement>('.navigation-viewport');
  const triggers = [...document.querySelectorAll<HTMLButtonElement>('[data-menu-trigger]')];
  const contents = [...document.querySelectorAll<HTMLElement>('[data-menu-content]')];
  let activeMenu: string | undefined;
  let closeTimeout: number | undefined;

  const closeMenu = () => {
    window.clearTimeout(closeTimeout);
    closeTimeout = undefined;
    activeMenu = undefined;
    triggers.forEach(trigger => trigger.setAttribute('aria-expanded', 'false'));
    viewport?.classList.add('pointer-events-none', 'opacity-0', 'scale-95');
    contents.forEach(content => content.classList.add('hidden'));
  };

  const openMenu = (trigger: HTMLButtonElement) => {
    window.clearTimeout(closeTimeout);
    closeTimeout = undefined;
    const menu = trigger.dataset.menuTrigger;
    const content = contents.find(item => item.dataset.menuContent === menu);
    if (!menu || !content || !viewport || !container) return;
    activeMenu = menu;
    triggers.forEach(item => item.setAttribute('aria-expanded', String(item === trigger)));
    contents.forEach(item => item.classList.toggle('hidden', item !== content));
    viewport.classList.remove('pointer-events-none', 'opacity-0', 'scale-95');
    const borderWidth = viewport.offsetWidth - viewport.clientWidth;
    const borderHeight = viewport.offsetHeight - viewport.clientHeight;
    viewport.style.width = `${content.offsetWidth + borderWidth}px`;
    viewport.style.height = `${content.offsetHeight + borderHeight}px`;
    const left = trigger.getBoundingClientRect().left - container.getBoundingClientRect().left - 32;
    const maxLeft =
      window.innerWidth - viewport.offsetWidth - container.getBoundingClientRect().left - 32;
    viewport.parentElement!.style.transform = `translateX(${Math.min(left, maxLeft)}px)`;
  };

  triggers.forEach(trigger => {
    trigger.addEventListener('pointerenter', () => openMenu(trigger));
    trigger.addEventListener('focus', () => openMenu(trigger));
    trigger.addEventListener('click', () =>
      activeMenu === trigger.dataset.menuTrigger ? closeMenu() : openMenu(trigger),
    );
  });
  navigation?.addEventListener('pointerenter', () => window.clearTimeout(closeTimeout));
  navigation?.addEventListener('pointerleave', event => {
    if (!(event.relatedTarget instanceof Node) || !navigation.contains(event.relatedTarget)) {
      window.clearTimeout(closeTimeout);
      closeTimeout = window.setTimeout(closeMenu, 150);
    }
  });
  // Hovering anything in the header that is not a menu trigger or the open
  // menu itself (e.g. the Pricing link) closes the menu, like Radix
  // NavigationMenu does on the React site.
  navigation?.addEventListener('pointerover', event => {
    if (!activeMenu || !(event.target instanceof Element)) return;
    if (
      event.target.closest('[data-menu-trigger]') ||
      event.target.closest('#h-navmenu-viewport')
    ) {
      window.clearTimeout(closeTimeout);
      closeTimeout = undefined;
      return;
    }
    window.clearTimeout(closeTimeout);
    closeTimeout = window.setTimeout(closeMenu, 150);
  });
  document.addEventListener('click', event => {
    if (event.target instanceof Node && !navigation?.contains(event.target)) closeMenu();
  });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape') closeMenu();
  });

  const mobileTrigger = document.querySelector<HTMLButtonElement>('.mobile-menu-trigger');
  const mobilePanel = document.querySelector<HTMLElement>('.mobile-navigation-panel');
  mobileTrigger?.addEventListener('click', () => {
    const open = mobileTrigger.getAttribute('aria-expanded') !== 'true';
    mobileTrigger.setAttribute('aria-expanded', String(open));
    mobileTrigger.classList.toggle('open', open);
    mobilePanel?.classList.toggle('hidden', !open);
  });

  const updateBorder = () =>
    navigation?.style.setProperty(
      '--border-opacity',
      navigation.dataset.docsNavigation === 'true' || scrollY > 1 ? '100%' : '0%',
    );
  updateBorder();
  addEventListener('scroll', updateBorder, { passive: true });
</script>
