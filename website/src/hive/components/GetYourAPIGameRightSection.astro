---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<section class:list={["relative overflow-hidden rounded-3xl bg-primary md:h-[308px]", className]}>
  <div class="pointer-events-none absolute inset-0 overflow-hidden">
    <svg class="absolute inset-y-0 right-0 hidden opacity-10 md:block [@media(min-width:1300px)]:opacity-100" fill="none" height="309" viewBox="0 0 538 309" width="538" xmlns="http://www.w3.org/2000/svg">
      <path d="M0 127.88c0 11.695 4.565 22.926 12.679 31.201l63.005 64.257 7.378 7.524 63.005 64.257c8.113 8.275 19.126 12.931 30.594 12.931H546.5v-84.712H147.971c-35.852 0-64.91-29.635-64.91-66.199V-97.857H0V127.88z" fill="url(#gogr-green-arch)"></path>
      <defs><linearGradient gradientUnits="userSpaceOnUse" id="gogr-green-arch" x1="273.25" x2="273.25" y1="-3.00975" y2="308.05"><stop stop-color="#55998D"></stop><stop offset="1" stop-color="#245850"></stop></linearGradient></defs>
    </svg>
    <svg class="absolute right-[607px] max-md:right-[-36px] max-md:top-[-71px] max-md:size-[200px] max-md:rotate-180 md:bottom-0" fill="none" height="284" viewBox="0 0 304 284" width="304" xmlns="http://www.w3.org/2000/svg">
      <path d="M293.962 111.972a32.561 32.561 0 019.538 23.014V303.55h-62.444V113.073c0-27.66-22.419-50.079-50.079-50.079H.5V.55h168.563a32.565 32.565 0 0123.015 9.538l48.124 48.124 5.636 5.636 48.124 48.124z" stroke="url(#gogr-stroke)"></path>
      <defs><linearGradient gradientUnits="userSpaceOnUse" id="gogr-stroke" x1="152" x2="294.5" y1="159.05" y2="5.04982"><stop stop-color="#A2C1C4" stop-opacity="0"></stop><stop offset="1" stop-color="#A2C1C4" stop-opacity="0.8"></stop></linearGradient></defs>
    </svg>
  </div>
  <div class="flex items-stretch justify-between gap-x-6 gap-y-4 p-4 max-md:flex-col sm:items-center md:h-[308px] md:px-24">
    <h2 class="group text-[40px] leading-[1.2] tracking-[-0.2px] max-sm:text-balance max-sm:text-center md:text-[56px] md:leading-[1.142586] md:tracking-[-0.56px]">Get your API game right.</h2>
    <div class="flex gap-x-4 gap-y-2 whitespace-pre max-sm:flex-col">
      <a class="relative flex items-center justify-center gap-2 text-nowrap rounded-lg px-6 py-3 font-medium leading-6 text-white bg-green-800 hover:bg-green-700 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-green-800/40 sm:w-fit" href="https://app.graphql-hive.com/">
        <span class="absolute inset-0 rounded-lg border border-green-800"></span>
        Get started for free
      </a>
      <a class="relative flex items-center justify-center gap-2 text-nowrap rounded-lg px-6 py-3 font-medium leading-6 text-green-1000 bg-transparent focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-green-800 sm:w-fit" data-contact-link href="https://the-guild.dev/contact">
        <span class="absolute inset-0 rounded-lg border border-green-800"></span>
        Talk to us
      </a>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLAnchorElement>("[data-contact-link]").forEach((link) => {
    link.addEventListener("click", (event) => {
      const crisp = (globalThis as typeof globalThis & {
        $crisp?: { push(args: unknown[]): void };
      }).$crisp;
      if (crisp) {
        crisp.push(["do", "chat:open"]);
        event.preventDefault();
      }
    });
  });
</script>
