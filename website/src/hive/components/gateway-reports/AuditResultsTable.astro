---
/**
 * The Federation compatibility audit results table and its legend. The audit
 * page shows it in full (gateway links and a report link per row); the
 * gateway and router pages show the compact form.
 */
import { auditScore, type AuditResult } from '~hive/lib/gateway-reports';
import { AUDIT_REPOSITORY } from '~hive/lib/gateway-reports-data';

interface Props {
  /** Link each gateway to its website and its section of the audit report. */
  details?: boolean;
  /** The gateway whose row is highlighted. */
  highlight?: string;
  rows: AuditResult[];
}

const { details = false, highlight: product, rows } = Astro.props;
---

<div class="hive-focus nextra-scrollbar border-beige-400 [&_:is(td,th)]:border-beige-400 [scrollbar-width:auto] overflow-x-auto rounded-2xl border max-sm:-mx-8">
  <table class="block table w-full overflow-x-auto rounded-2xl border border-none border-(--border) [--border:var(--color-green-200)] [--highlight-bg:var(--color-green-100)] max-sm:rounded-none max-sm:text-sm">
    <thead>
      <tr class="bg-(--highlight,var(--highlight-bg)) [--highlight:0] *:text-left">
        <th class="border border-(--border) p-4 pl-6 font-medium whitespace-pre first:sticky first:left-0 first:border-l-0 first:bg-(--highlight,var(--highlight-bg)) last:border-r-0 in-[thead]:border-t-0 max-sm:first:drop-shadow-2xl">
          Gateway
          <small class="block text-xs/[18px] text-green-800">Name and variant</small>
        </th>
        <th class="border border-(--border) p-4 font-medium whitespace-pre first:sticky first:left-0 first:border-l-0 first:bg-(--highlight,var(--highlight-bg)) last:border-r-0 in-[thead]:border-t-0 max-sm:first:drop-shadow-2xl sm:w-1/4">
          Compatibility
          <small class="block text-xs/[18px] text-green-800">Pass rate of test cases</small>
        </th>
        <th class="border border-(--border) p-4 font-medium whitespace-pre first:sticky first:left-0 first:border-l-0 first:bg-(--highlight,var(--highlight-bg)) last:border-r-0 in-[thead]:border-t-0 max-sm:first:drop-shadow-2xl sm:w-1/4">
          Test Cases
          <small class="block text-xs/[18px] text-green-800">All available test cases</small>
        </th>
        <th class="border border-(--border) p-4 font-medium whitespace-pre first:sticky first:left-0 first:border-l-0 first:bg-(--highlight,var(--highlight-bg)) last:border-r-0 in-[thead]:border-t-0 max-sm:first:drop-shadow-2xl sm:w-1/4">
          Test Suites
          <small class="block text-xs/[18px] text-green-800">Test cases grouped by feature</small>
        </th>
        {details && (
          <th class="border border-(--border) p-4 font-medium whitespace-pre last:border-r-0 in-[thead]:border-t-0">
            Full report
            <small class="block text-xs/[18px] text-green-800">Detailed test results</small>
          </th>
        )}
      </tr>
    </thead>
    <tbody>
      {rows.map(row => {
        const compatibility = auditScore(row);
        const highlight = row.name === product;
        return (
          <tr
            class:list={[
              '*:text-left',
              highlight ? '[--highlight:initial]' : '[--highlight:0]',
              'bg-(--highlight,var(--highlight-bg))',
            ]}
          >
            <td
              class:list={[
                'border border-(--border) p-4 first:sticky first:left-0 first:border-l-0 first:bg-(--highlight,var(--highlight-bg)) last:border-r-0 in-[tbody]:border-b-0 max-sm:first:drop-shadow-2xl',
                highlight ? 'bg-green-100!' : '',
                'pl-5 max-sm:pr-1.5',
              ]}
            >
              <div class="flex items-center gap-2.5 whitespace-nowrap">
                <div
                  class:list={[
                    'size-3 rounded-full',
                    compatibility === 100
                      ? 'bg-positive-bright'
                      : compatibility >= 75
                        ? 'bg-warning-bright'
                        : 'bg-critical-bright',
                  ]}
                />
                {details && row.website ? (
                  <a class="hive-focus underline-offset-2 hover:underline" href={row.website}>
                    {row.name}
                  </a>
                ) : (
                  row.name
                )}
              </div>
            </td>
            <td class="border border-(--border) p-4 text-sm text-green-800 last:border-r-0 in-[tbody]:border-b-0">
              {compatibility.toFixed(2)}%
            </td>
            <td class="border border-(--border) p-4 last:border-r-0 in-[tbody]:border-b-0">
              <span class="text-positive-dark inline-flex items-center gap-0.5 text-sm">
                <svg fill="currentColor" height="16" viewBox="0 0 16 16" width="16" class="size-4">
                  <path d="M6.66668 10.1134L12.7947 3.98608L13.7373 4.92875L6.66668 11.9994L2.42401 7.75675L3.36668 6.81408L6.66668 10.1134Z" />
                </svg>{' '}
                {row.cases.passed}
              </span>
              {row.cases.failed > 0 && (
                <span class="text-critical-dark ml-2 inline-flex items-center text-sm">
                  <svg
                    fill="currentColor"
                    height="16"
                    viewBox="0 0 16 16"
                    width="16"
                    class="size-4"
                  >
                    <path d="M7.99999 7.05806L11.3 3.75806L12.2427 4.70072L8.94266 8.00072L12.2427 11.3007L11.2993 12.2434L7.99932 8.94339L4.69999 12.2434L3.75732 11.3001L7.05732 8.00006L3.75732 4.70006L4.69999 3.75872L7.99999 7.05806Z" />
                  </svg>{' '}
                  {row.cases.failed}
                </span>
              )}
            </td>
            <td class="border border-(--border) p-4 last:border-r-0 in-[tbody]:border-b-0">
              <span class="text-positive-dark inline-flex items-center gap-0.5 text-sm">
                <svg fill="currentColor" height="16" viewBox="0 0 16 16" width="16" class="size-4">
                  <path d="M6.66668 10.1134L12.7947 3.98608L13.7373 4.92875L6.66668 11.9994L2.42401 7.75675L3.36668 6.81408L6.66668 10.1134Z" />
                </svg>{' '}
                {row.suites.passed}
              </span>
              {row.suites.failed > 0 && (
                <span class="text-critical-dark ml-2 inline-flex items-center text-sm">
                  <svg
                    fill="currentColor"
                    height="16"
                    viewBox="0 0 16 16"
                    width="16"
                    class="size-4"
                  >
                    <path d="M7.99999 7.05806L11.3 3.75806L12.2427 4.70072L8.94266 8.00072L12.2427 11.3007L11.2993 12.2434L7.99932 8.94339L4.69999 12.2434L3.75732 11.3001L7.05732 8.00006L3.75732 4.70006L4.69999 3.75872L7.99999 7.05806Z" />
                  </svg>{' '}
                  {row.suites.failed}
                </span>
              )}
            </td>
            {details && (
              <td class="border border-(--border) p-4 text-sm last:border-r-0 in-[tbody]:border-b-0">
                <a
                  class="hive-focus underline underline-offset-2"
                  href={`${AUDIT_REPOSITORY}/blob/main/REPORT.md${row.id ? `#${row.id}` : ''}`}
                >
                  View report<span class="sr-only"> for {row.name}</span>
                </a>
              </td>
            )}
          </tr>
        );
      })}
    </tbody>
  </table>
</div>
<div class="mt-6 flex flex-wrap gap-2 text-xs whitespace-nowrap text-green-800 sm:gap-4">
  <div class="flex gap-2 max-sm:-mx-1 max-sm:w-full sm:contents">
    <div class="flex items-center gap-1">
      <svg
        fill="currentColor"
        height="16"
        viewBox="0 0 16 16"
        width="16"
        class="text-positive-dark size-4"
      >
        <path d="M6.66668 10.1134L12.7947 3.98608L13.7373 4.92875L6.66668 11.9994L2.42401 7.75675L3.36668 6.81408L6.66668 10.1134Z"></path>
      </svg>{' '}
      Passed tests
    </div>
    <div class="flex items-center gap-1">
      <svg
        fill="currentColor"
        height="16"
        viewBox="0 0 16 16"
        width="16"
        class="text-critical-dark size-4"
      >
        <path d="M7.99999 7.05806L11.3 3.75806L12.2427 4.70072L8.94266 8.00072L12.2427 11.3007L11.2993 12.2434L7.99932 8.94339L4.69999 12.2434L3.75732 11.3001L7.05732 8.00006L3.75732 4.70006L4.69999 3.75872L7.99999 7.05806Z"></path>
      </svg>{' '}
      Failed tests
    </div>
  </div>
  <div class="flex items-center gap-2">
    <div class="bg-positive-bright size-2 rounded-full"></div>
    Perfect compatibility
  </div>
  <div class="flex items-center gap-2">
    <div class="bg-warning-bright size-2 rounded-full"></div>
    75% and higher
  </div>
  <div class="flex items-center gap-2">
    <div class="bg-critical-bright size-2 rounded-full"></div>
    Less than 75%
  </div>
</div>
