---
import { withBase } from "../../lib/base-path";
import CompanyLogo from "./CompanyLogo.astro";

import hemnetPicture from "../../documentation/src/components/company-testimonials/hemnet-picture.webp";
import karrotPicture from "../../documentation/src/components/company-testimonials/karrot-picture.webp";
import nacellePicture from "../../documentation/src/components/company-testimonials/nacelle-picture.webp";
import prodigyPicture from "../../documentation/src/components/company-testimonials/prodigy-picture.webp";
import trivagoPicture from "../../documentation/src/components/company-testimonials/trivago-picture.webp";
import wealthsimplePicture from "../../documentation/src/components/company-testimonials/wealthsimple-picture.webp";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const testimonials = [
  {
    caseStudyHref: "/case-studies/hemnet",
    company: "Hemnet",
    picture: hemnetPicture,
    slug: "hemnet",
  },
  {
    caseStudyHref: "/case-studies/trivago",
    company: "trivago",
    picture: trivagoPicture,
    slug: "trivago",
  },
  {
    caseStudyHref: "/case-studies/wealthsimple",
    company: "Wealthsimple",
    picture: wealthsimplePicture,
    slug: "wealthsimple",
  },
  {
    company: "nacelle",
    picture: nacellePicture,
    slug: "nacelle",
  },
  {
    company: "Karrot",
    picture: karrotPicture,
    slug: "karrot",
  },
  {
    company: "Prodigy",
    data: [{ description: "requests every month", numbers: ">750M" }],
    picture: prodigyPicture,
    pictureClass: "bg-[#a9e7f599]",
    slug: "prodigy",
  },
] as const;

const testimonialText: Record<string, string> = {
  Hemnet: "We expected that moving from Apollo Router to a Hive Gateway would come with a measurable performance cost, but found the Hive Gateway running with less than 30% resource usage than Apollo Router, and it was holding tens of thousands of requests per minute. The resource efficiency reflected strong engineering from the Hive team.",
  trivago: "Most GraphQL Gateway and general GraphQL discussions focus on customer-facing applications—aggregating microservices behind a single endpoint for web and mobile clients, enabling frontend teams to query exactly the data they need without multiple round trips. Trivagos use case and perspective were different.",
  Wealthsimple: "Hive enables Wealthsimple to build flexible and resilient GraphQL APIs. The GitHub integration provides feedback in a format developers are familiar with and conditional breaking changes enable us to focus our discussion on schema design rather than maintenance. Hive empowers us to confidently evolve our schemas by ensuring seamless API updates, detecting potential breaking changes, and guiding developers.",
  nacelle: "Our migration from Apollo GraphOS to Hive was incredibly straightforward. In less than a month, we had about 20 subgraphs running on Hive in production. The process was smooth, and the Hive team's friendly demeanor made it even more pleasant. Although we haven't needed direct assistance with our implementation, their openness to feedback and generally nice attitude has fostered a sense of collaboration and partnership.",
  Karrot: "We use Hive as schema registry and monitoring tool. As a schema registry, we can publish GraphQL Schema with decoupled any application code. As a monitoring tool, we can find useful metrics. For example operation latency, usage of deprecated field. The great thing about Hive Console is that it is easy to use, we have already integrated many tools like Slack or Github.",
  Prodigy: "Hive is essential to us handling more than 750M GraphQL requests every month. We ship with certainty that schema changes will not break clients. The atLeastOnceSampler is crucial to capture telemetry from less-often run operations. The schema explorer condenses hours of searching through Github for client usage down to minutes.",
};

const testimonialId = (company: string) => encodeURIComponent(company.toLowerCase()) + "-testimonial";
---

<section class:list={["bg-beige-100 text-green-1000 relative rounded-3xl px-4 py-6 md:p-10 lg:p-18", className]}>
  <h2 class="group text-4xl leading-[1.2] md:text-5xl md:leading-[1.16667] tracking-[-0.48px]">Loved by Developers, Trusted by Businesses</h2>

  <div class="flex flex-col overflow-hidden">
    <div class="lg:bg-beige-200 z-10 order-1 mt-4 flex flex-row justify-center rounded-2xl px-1 -mx-1 lg:order-first lg:my-16" role="tablist">
      {testimonials.map((testimonial, i) => (
        <button
          class="hive-focus lg:aria-selected:bg-white aria-selected:text-green-1000 lg:aria-selected:border-beige-600 flex flex-1 grow-0 items-center justify-center rounded-[15px] border-transparent p-0.5 font-medium leading-6 text-green-800 lg:grow lg:border lg:bg-transparent lg:p-4 [&[aria-selected=true]>:first-child]:bg-blue-400 cursor-pointer"
          data-testimonial-tab={testimonial.company}
          role="tab"
          type="button"
          aria-selected={i === 0 ? "true" : "false"}
        >
          <div class="size-2 rounded-full bg-blue-200 transition-colors lg:hidden"></div>
          <span class="logo-svg-wrap max-lg:sr-only text-blue-1000" style="height:32px; display:inline-flex; align-items:center;">
            <CompanyLogo height={32} slug={testimonial.slug} title={testimonial.company} />
          </span>
        </button>
      ))}
    </div>

    <div class="testimonial-scrollview no-scrollbar -m-2 -mb-10 flex snap-x snap-mandatory gap-4 overflow-auto p-2 lg:pb-10">
      {testimonials.map((testimonial) => (
        <article
          class:list={[
            "relative flex w-full shrink-0 snap-center flex-col outline-hidden gap-6 md:flex-row lg:gap-12",
            "data-hidden:lg:hidden",
            "caseStudyHref" in testimonial && testimonial.caseStudyHref ? "pb-[72px] lg:pb-0" : "max-lg:pb-8",
          ]}
          data-testimonial-panel={testimonial.company}
          tabindex={-1}
        >
          <img
            alt=""
            class:list={[
              "hidden size-[300px] shrink-0 rounded-3xl object-cover mix-blend-multiply max-lg:mt-6 md:block",
              "pictureClass" in testimonial ? testimonial.pictureClass : undefined,
            ]}
            height="300"
            src={testimonial.picture.src}
            width="300"
          />
          <div class="max-lg:mt-6 lg:relative flex flex-col" id={testimonialId(testimonial.company)}>
            <div class="logo-svg-wrap text-blue-1000 mb-6 lg:hidden" style="height:32px">
              <CompanyLogo height={32} slug={testimonial.slug} title={testimonial.company} />
            </div>
            <blockquote class:list={["sm:blockquote-beige-500 lg:text-xl xl:text-2xl xl:leading-[32px] [&_code]:font-mono [&_code]:text-[0.9em]", "data" in testimonial && testimonial.data ? "lg:text-lg" : undefined]}>
              {testimonialText[testimonial.company]}
            </blockquote>
            {"caseStudyHref" in testimonial && testimonial.caseStudyHref && (
              <a
                class="absolute bottom-0 w-full max-sm:hidden md:w-fit relative flex items-center justify-center gap-2 text-nowrap rounded-lg px-6 py-3 font-medium leading-6 text-green-1000 bg-primary hover:bg-green-800 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-green-800 mt-auto mt-0"
                href={withBase(testimonial.caseStudyHref)}
              >
                <span class="absolute inset-0 rounded-lg border border-green-800"></span>
                Read the case study
                <svg fill="currentColor" height="24" viewBox="0 0 24 24" width="24"><path d="m15.755 11.1-4.828-4.828L12.2 5l7 7-7 7-1.273-1.272 4.828-4.828H4.8v-1.8h10.955Z"></path></svg>
              </a>
            )}
          </div>
          {"data" in testimonial && testimonial.data && (
            <>
              <div class="bg-beige-600 hidden w-px md:block"></div>
              <ul class="flex gap-6 md:flex-col md:gap-12">
                {testimonial.data.map((entry) => (
                  <li>
                    <span class="block text-[40px] leading-[1.2] tracking-[-0.2px] md:text-6xl md:leading-[1.1875] md:tracking-[-0.64px]">{entry.numbers}</span>
                    <span class="mt-2">{entry.description}</span>
                  </li>
                ))}
              </ul>
            </>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .no-scrollbar {
    scrollbar-width: none;
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .logo-svg-wrap :global(svg) {
    height: 100%;
    width: auto;
  }
</style>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>("[data-testimonial-tab]");
  const panels = document.querySelectorAll<HTMLElement>("[data-testimonial-panel]");
  const scrollview = document.querySelector<HTMLElement>(".testimonial-scrollview");

  const selectTab = (company: string, { scroll }: { scroll: boolean }) => {
    tabs.forEach((tab) => tab.setAttribute("aria-selected", String(tab.dataset.testimonialTab === company)));
    if (scroll && scrollview) {
      const panel = [...panels].find((panel) => panel.dataset.testimonialPanel === company);
      if (panel) scrollview.scrollTo({ behavior: "instant", left: panel.offsetLeft });
    }
  };

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      if (tab.dataset.testimonialTab) selectTab(tab.dataset.testimonialTab, { scroll: true });
    });
  });

  let debounceTimeout: ReturnType<typeof setTimeout> | undefined;
  scrollview?.addEventListener(
    "scroll",
    () => {
      clearTimeout(debounceTimeout);
      debounceTimeout = setTimeout(() => {
        if (!scrollview) return;
        const { scrollLeft, scrollWidth } = scrollview;
        const index = Math.round((scrollLeft / scrollWidth) * panels.length);
        const company = panels[index]?.dataset.testimonialPanel;
        if (company) selectTab(company, { scroll: false });
      }, 50);
    },
    { passive: true },
  );
</script>
