---
import { withBase } from '../../lib/base-path';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const boxHeight = 66;
const halfBoxHeight = boxHeight / 2;
const stellateHeight = 96;
const gatewayHeight = 136;

const firstRow = `calc(${halfBoxHeight}px + var(--edge) + ${stellateHeight / 2}px)`;
const secondRow = `calc(${stellateHeight / 2}px + (var(--edge) / 2))`;
const thirdRow = `calc((var(--edge) / 2) + ${gatewayHeight / 2}px)`;
const fullHeight = `calc(${boxHeight}px + var(--edge) + ${stellateHeight}px + var(--edge) + ${gatewayHeight}px + var(--edge) + ${boxHeight}px)`;
---

<div
  class:list={[
    'ecosystem-container grid h-min flex-1 grid-cols-1 items-center gap-y-0 overflow-visible md:grid-cols-[auto_minmax(2rem,1fr)_min-content_minmax(2rem,1fr)_auto]',
    className,
    '[--edge:32px] sm:[--edge:48px] md:[--edge:96px]',
  ]}
  style={{ '--gateway-height': `${gatewayHeight}px`, '--stellate-height': `${stellateHeight}px` }}
>
  <svg class="absolute size-0">
    <defs>
      <linearGradient
        gradientUnits="objectBoundingBox"
        id="eco-linear-blue"
        x1="0"
        x2="100%"
        y1="0"
        y2="100%"
      >
        <stop stop-color="#8CBEB3"></stop>
        <stop offset="1" stop-color="#68A8B6"></stop>
      </linearGradient>
      <linearGradient
        gradientUnits="objectBoundingBox"
        id="eco-linear-white"
        x1="0"
        x2="100%"
        y1="0"
        y2="100%"
      >
        <stop stop-color="white" stop-opacity="0.5"></stop>
        <stop offset="1" stop-color="white" stop-opacity="0.15"></stop>
      </linearGradient>
    </defs>
  </svg>

  <!-- Col 1: Codegen (Desktop) -->
  <a class="hidden items-center justify-end md:flex" href="https://graphql-codegen.com">
    <div
      class="eco-node firefox:[backdrop-filter:blur(12px)] relative z-10 z-20 flex min-h-[96px] flex-row items-center gap-4 rounded-2xl bg-[linear-gradient(135deg,rgb(255_255_255/0.10),rgb(255_255_255/0.20))] p-4 backdrop-blur-md xl:p-[22px] [&>svg]:shrink-0"
    >
      <svg
        class="size-12"
        fill="url(#eco-linear-blue)"
        stroke="url(#eco-linear-white)"
        stroke-width="0.5px"
        viewBox="0 0 53 53"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="m42.212 16.24-5.427-5.427-7.46 7.46a3.997 3.997 0 0 1-5.652 0l-7.46-7.46-5.428 5.427 7.46 7.46a3.997 3.997 0 0 1 0 5.653l-7.46 7.46 5.427 5.427 7.46-7.46a3.997 3.997 0 0 1 5.653 0l7.46 7.46 5.428-5.427-7.46-7.46a3.997 3.997 0 0 1 0-5.653l7.46-7.46Z"
        ></path>
        <path
          d="M26.498 41.672 21.072 47.1l5.427 5.426 5.426-5.426-5.427-5.427ZM26.499.525 21.073 5.95l5.426 5.426 5.426-5.426L26.5.525ZM47.074 21.101l-5.426 5.427 5.426 5.426 5.426-5.426-5.426-5.427ZM5.926 21.1.5 26.528l5.426 5.426 5.426-5.426-5.426-5.426Z"
        ></path>
      </svg>
      <div class="flex flex-col text-left">
        <div class="font-medium text-green-100">Codegen</div>
        <div class="eco-desc mt-0.5 text-sm/5 text-green-200">GraphQL Code<br />Generation</div>
      </div>
    </div>
  </a>

  <!-- Col 2: left connecting lines (Desktop) -->
  <div
    class="hidden flex-col items-center justify-center md:flex"
    style={{ height: fullHeight, paddingBlock: `${halfBoxHeight}px` }}
  >
    <svg
      class="dash-line h-1/2 translate-x-[1.5px] translate-y-[-1.5px] overflow-visible text-green-700"
      fill="none"
      preserveAspectRatio="none"
      stroke="currentColor"
      vector-effect="non-scaling-stroke"
      viewBox="0 0 107 326"
      width="107"
    >
      <path
        d="M 150 0 H 77.659 c -13.255 0 -24 10.745 -24 24 V 303.5 c 0 13.255 -10.746 24 -24 24 H 0"
        stroke-dasharray="3 6"
        stroke-width="3"
        vector-effect="non-scaling-stroke"></path>
    </svg>
    <svg
      class="dash-line-reverse h-1/2 translate-x-[1.5px] translate-y-[1.5px] -scale-y-100 overflow-visible text-green-700"
      fill="none"
      preserveAspectRatio="none"
      stroke="currentColor"
      vector-effect="non-scaling-stroke"
      viewBox="0 0 107 326"
      width="107"
    >
      <path
        d="M 150 0 H 77.659 c -13.255 0 -24 10.745 -24 24 V 303.5 c 0 13.255 -10.746 24 -24 24 H 0"
        stroke-dasharray="3 6"
        stroke-width="3"
        vector-effect="non-scaling-stroke"></path>
    </svg>
  </div>

  <!-- Col 3: main stack -->
  <div class="flex h-full w-max flex-col items-center max-md:mx-auto">
    <div class="z-20 flex justify-center">
      <div
