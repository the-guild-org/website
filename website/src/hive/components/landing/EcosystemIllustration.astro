            height="20.46348"
            mask="url(#eco-react-mask)"
            width="23"
            x="-11.5"
            y="-10.23174"></rect>
          <defs>
            <g id="eco-react-logo-icon">
              <circle fill="#fff" r="2.05"></circle>
              <g fill="none" stroke="#fff" stroke-width="1">
                <ellipse rx="11" ry="4.2"></ellipse>
                <ellipse rx="11" ry="4.2" transform="rotate(60)"></ellipse>
                <ellipse rx="11" ry="4.2" transform="rotate(120)"></ellipse>
              </g>
            </g>
            <mask
              height="20.46348"
              id="eco-react-mask"
              maskContentUnits="userSpaceOnUse"
              maskUnits="userSpaceOnUse"
              width="23"
              x="-11.5"
              y="-10.23174"
            >
              <use href="#eco-react-logo-icon"></use>
