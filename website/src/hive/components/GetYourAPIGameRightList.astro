---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<section class:list={['bg-primary relative overflow-hidden rounded-3xl', className]}>
  <div class="pointer-events-none absolute inset-0 overflow-hidden">
    <svg
      class="absolute top-[-184px] right-0 max-md:size-[312px] max-md:-scale-y-100 max-md:rotate-90 md:bottom-0 lg:right-[696px]"
      height="409"
      viewBox="0 0 492 409"
      width="492"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M475.973 311.082C485.909 301.145 491.5 287.658 491.5 273.616L491.5 0.5L389.821 0.499999L389.821 309.081C389.821 353.676 353.676 389.821 309.081 389.821L0.500001 389.821L0.5 491.5L273.616 491.5C287.658 491.5 301.145 485.909 311.082 475.973L388.967 398.088L398.088 388.967L475.973 311.082Z"
        fill="none"
        stroke="url(#get-api-game-right-list-stroke)"></path>
      <defs>
        <linearGradient
          gradientUnits="userSpaceOnUse"
          id="get-api-game-right-list-stroke"
          x1="246"
          x2="476.625"
          y1="234.671"
          y2="483.908"
        >
          <stop stop-color="#A2C1C4" stop-opacity="0"></stop>
          <stop offset="1" stop-color="#A2C1C4" stop-opacity="0.8"></stop>
        </linearGradient>
      </defs>
    </svg>
  </div>
  <div
    class="flex items-stretch justify-between gap-x-8 gap-y-10 px-4 py-6 max-lg:flex-col md:items-center md:p-24 md:px-12 xl:px-[120px]"
  >
    <h2
      class="group text-[40px] leading-[1.2] tracking-[-0.2px] max-sm:text-center max-sm:text-[32px]/[1.25] max-sm:text-balance md:text-[56px] md:leading-[1.142586] md:tracking-[-0.56px]"
    >
      Get your
      <br class="max-lg:hidden" /> API game right.
    </h2>
    <div>
      <ul class="flex shrink-0 flex-col gap-6 font-medium md:whitespace-nowrap xl:text-xl">
        <li class="flex gap-2 md:items-center">
          <div class="h-min grow-0 rounded-full border p-[3px] max-md:mt-px">
            <svg
              class="translate-y-[0.5px]"
              fill="currentColor"
              height="16"
              viewBox="0 0 16 17"
              width="16"
              xmlns="http://www.w3.org/2000/svg"
              ><path
                d="M6.66668 10.163L12.7947 4.03564L13.7373 4.97831L6.66668 12.049L2.42401 7.80631L3.36668 6.86364L6.66668 10.163Z"
              ></path></svg
            >
          </div>
          Built by engineers to improve developer experience
        </li>
        <li class="flex gap-2 md:items-center">
          <div class="h-min grow-0 rounded-full border p-[3px] max-md:mt-px">
            <svg
              class="translate-y-[0.5px]"
              fill="currentColor"
              height="16"
              viewBox="0 0 16 17"
              width="16"
              xmlns="http://www.w3.org/2000/svg"
              ><path
                d="M6.66668 10.163L12.7947 4.03564L13.7373 4.97831L6.66668 12.049L2.42401 7.80631L3.36668 6.86364L6.66668 10.163Z"
              ></path></svg
            >
          </div>
          Driven by customers
        </li>
        <li class="flex gap-2 md:items-center">
          <div class="h-min grow-0 rounded-full border p-[3px] max-md:mt-px">
            <svg
              class="translate-y-[0.5px]"
              fill="currentColor"
              height="16"
              viewBox="0 0 16 17"
              width="16"
              xmlns="http://www.w3.org/2000/svg"
              ><path
                d="M6.66668 10.163L12.7947 4.03564L13.7373 4.97831L6.66668 12.049L2.42401 7.80631L3.36668 6.86364L6.66668 10.163Z"
              ></path></svg
            >
          </div>
          No vendor lock-in
        </li>
      </ul>
      <div class="mt-8 flex gap-x-4 gap-y-2 whitespace-pre max-sm:flex-col">
        <a
          class="relative flex items-center justify-center gap-2 rounded-lg bg-green-800 px-6 py-3 leading-6 font-medium text-nowrap text-white hover:bg-green-700 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-green-800/40 sm:w-fit"
          href="https://app.graphql-hive.com/"
        >
          <span class="absolute inset-0 rounded-lg border border-green-800"></span>
          Get started for free
        </a>
        <a
          class="text-green-1000 relative flex items-center justify-center gap-2 rounded-lg bg-transparent px-6 py-3 leading-6 font-medium text-nowrap focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-green-800 sm:w-fit"
          data-contact-link
          href="https://the-guild.dev/contact"
        >
          <span class="absolute inset-0 rounded-lg border border-green-800"></span>
          Talk to us
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-contact-link]').forEach(link => {
    link.addEventListener('click', event => {
      const crisp = (
        globalThis as typeof globalThis & {
          $crisp?: { push(args: unknown[]): void };
        }
      ).$crisp;
      if (crisp) {
        crisp.push(['do', 'chat:open']);
        event.preventDefault();
      }
    });
  });
</script>
