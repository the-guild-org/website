---
import { basePath } from '../lib/base-path';

interface Props {
  class?: string;
  faqs?: readonly (readonly [string, string])[];
  heading?: string;
}

const { class: className } = Astro.props;

const defaultFaqs = [
  [
    'What does "no vendor lock-in" mean?',
    "We value your flexibility and independent decision-making. That means we'll never try to lock you out in our ecosystem and we'll continuously add support for other tools and solutions, so that you decide what your stack should look like!",
  ],
  [
    'Can Hive Console be self-hosted?',
    'Yes, the on-premise version (identical to Hive Cloud) is free and open-source. <a class="hive-focus underline decoration-blue-500 underline-offset-2" href="/docs/schema-registry/self-hosting/get-started">Read about Self-Hosting Hive in our documentation.</a>',
  ],
  [
    'What counts as a GraphQL operation?',
    'Every GraphQL request that is processed by your GraphQL API and reported to Hive Console. If your server receives 1M GraphQL requests, all of them will be reported to Hive (assuming no sampling).',
  ],
  [
    'Are you SOC-2 Type II compliant?',
    'Hive Platfrom is fully SOC-2 Type II compliant. <a class="hive-focus underline decoration-blue-500 underline-offset-2" href="https://security.graphql-hive.com/" target="_blank" rel="noreferrer">Read more in the Trust Center.</a>',
  ],
  [
    'Do you have a GraphQL Gateway?',
    'Of course, we do! It is called Hive Gateway (previously known as GraphQL Mesh) that supports Apollo Federation and has been battle-tested by our clients for a few years now. <a class="hive-focus underline decoration-blue-500 underline-offset-2" href="/docs/gateway">Read more in our documentation.</a>',
  ],
] as const;

const faqs = Astro.props.faqs ?? defaultFaqs;
const heading = Astro.props.heading ?? 'Frequently Asked Questions';

const questionId = (question: string) =>
  `faq--${question
    .toLowerCase()
    .replaceAll(/[^a-z0-9]+/g, '-')
    .replaceAll(/(^-|-$)/g, '')}`;
---

<section
  class:list={[
    'text-green-1000 flex flex-col gap-x-6 gap-y-2 px-4 py-6 md:flex-row md:px-10 lg:gap-x-24 lg:px-[120px] lg:py-24',
    className,
  ]}
>
  <h2
    class="group basis-1/2 text-4xl leading-[1.2] tracking-[-0.48px] md:text-5xl md:leading-[1.16667]"
    id="frequently-asked-questions"
  >
    {heading}
  </h2>
  <div class="divide-beige-400 basis-1/2 divide-y max-xl:grow">
    {
      faqs.map(([question, answer]) => (
        <details
          class="group relative pb-0 open:pb-4"
          id={questionId(question)}
          itemscope
          itemtype="https://schema.org/Question"
        >
          <summary
            class="hive-focus hover:bg-beige-100/80 -mx-2 my-1 flex w-[calc(100%+1rem)] cursor-pointer list-none items-center justify-between gap-3 rounded-xl bg-white px-2 py-3 text-left font-medium transition-colors duration-100 md:my-2 md:py-4"
            itemprop="name"
          >
            <span>{question}</span>
            <svg
              class="size-5 shrink-0 transition-transform duration-150 group-open:rotate-180"
              fill="none"
              height="15"
              viewBox="0 0 15 15"
              width="15"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                clip-rule="evenodd"
                d="M3.13523 6.15803C3.3241 5.95657 3.64052 5.94637 3.84197 6.13523L7.5 9.56464L11.158 6.13523C11.3595 5.94637 11.6759 5.95657 11.8648 6.15803C12.0536 6.35949 12.0434 6.67591 11.842 6.86477L7.84197 10.6148C7.64964 10.7951 7.35036 10.7951 7.15803 10.6148L3.15803 6.86477C2.95657 6.67591 2.94637 6.35949 3.13523 6.15803Z"
                fill="currentColor"
                fill-rule="evenodd"
              />
            </svg>
          </summary>
          <div
            class="text-green-800"
            itemprop="acceptedAnswer"
            itemscope
            itemtype="https://schema.org/Answer"
          >
            <p itemprop="text" set:html={answer.replaceAll('href="/', `href="${basePath}/`)} />
          </div>
        </details>
      ))
    }
  </div>
</section>

<script>
  const openLinkedFaq = () => {
    if (!location.hash.startsWith('#faq--')) return;
    const faq = document.querySelector<HTMLDetailsElement>(location.hash);
    if (faq) faq.open = true;
  };
  openLinkedFaq();
  window.addEventListener('hashchange', openLinkedFaq);
</script>
