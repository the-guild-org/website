---
import { withBase } from "../lib/base-path";
import type { DocsNavNode } from "../lib/docs-nav";

interface Props {
  currentPath: string;
  depth?: number;
  nodes: DocsNavNode[];
}

const { currentPath, depth = 0, nodes } = Astro.props;
const linkPadding = depth === 0 ? "" : depth === 1 ? "ps-8" : depth === 2 ? "ps-11" : "ps-14";
const summaryPadding = depth === 0 ? "" : depth === 1 ? "ps-8" : depth === 2 ? "ps-11" : "ps-14";

function containsCurrentPath(node: DocsNavNode): boolean {
  if (node.type === "page") return node.href === currentPath;
  return node.href === currentPath || node.children.some(containsCurrentPath);
}
---

{
  nodes.map((node) => {
    if (node.type === "page") {
      return (
        <a
          class:list={[
            "relative mt-0.5 flex items-center gap-2 rounded-lg p-2 text-start text-fd-muted-foreground transition-colors wrap-anywhere hover:bg-fd-accent/50 hover:text-fd-accent-foreground/80 data-[active=true]:bg-fd-sidebar-active-bg data-[active=true]:text-fd-sidebar-active",
            depth > 0 && "data-[active=true]:before:absolute data-[active=true]:before:inset-y-2.5 data-[active=true]:before:start-2.5 data-[active=true]:before:w-px data-[active=true]:before:bg-fd-sidebar-active data-[active=true]:before:content-['']",
            linkPadding,
          ]}
          data-active={node.href === currentPath}
          aria-current={node.href === currentPath ? "page" : undefined}
          href={withBase(node.href)}
        >
          {node.title}
        </a>
      );
    }

    const open = containsCurrentPath(node);

    if (node.children.length === 0 && node.href) {
      return (
        <a
          class:list={["relative mt-0.5 flex items-center rounded-lg p-2 text-fd-muted-foreground hover:bg-fd-accent/50 hover:text-fd-accent-foreground/80", linkPadding]}
          data-active={currentPath === node.href}
          href={withBase(node.href)}
        >
          {node.title}
        </a>
      );
    }

    if (node.href) {
      return (
        <details class="nav-folder" open={open}>
          <summary
            class:list={["relative mt-0.5 flex w-full cursor-pointer list-none items-center gap-2 rounded-lg px-2 text-start text-fd-muted-foreground hover:bg-fd-accent/50 hover:text-fd-accent-foreground/80 data-[active=true]:bg-fd-sidebar-active-bg data-[active=true]:text-fd-sidebar-active", summaryPadding]}
            data-active={currentPath === node.href}
          >
            <a
              class="flex min-w-0 flex-1 items-center gap-2 py-2"
              data-active={currentPath === node.href}
              aria-current={currentPath === node.href ? "page" : undefined}
              href={withBase(node.href)}
            >
              {node.icon && <span class="[&_svg]:size-4 [&_svg]:shrink-0" set:html={node.icon} />}
              <span>{node.title}</span>
            </a>
            <svg class="nav-chevron size-4 shrink-0 transition-transform" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6" /></svg>
          </summary>
          <div class:list={["relative mt-0.5", depth === 0 && "before:absolute before:inset-y-1 before:start-2.5 before:w-px before:bg-fd-border before:content-['']"]}>
            <Astro.self currentPath={currentPath} depth={depth + 1} nodes={node.children} />
          </div>
        </details>
      );
    }

    return (
      <details class="nav-folder" open={open}>
        <summary class:list={["relative mt-0.5 flex w-full cursor-pointer list-none items-center gap-2 rounded-lg p-2 text-start text-fd-muted-foreground hover:bg-fd-accent/50 hover:text-fd-accent-foreground/80", summaryPadding]}>
          {node.icon && <span class="[&_svg]:size-4 [&_svg]:shrink-0" set:html={node.icon} />}
          <span>{node.title}</span>
          <svg class="nav-chevron ms-auto size-4 shrink-0 transition-transform" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6" /></svg>
        </summary>
        <div class:list={["relative mt-0.5", depth === 0 && "before:absolute before:inset-y-1 before:start-2.5 before:w-px before:bg-fd-border before:content-['']"]}>
          <Astro.self currentPath={currentPath} depth={depth + 1} nodes={node.children} />
        </div>
      </details>
    );
  })
}

<style>
  details.nav-folder[open] > summary > svg.nav-chevron {
    transform: rotate(90deg);
  }
</style>
