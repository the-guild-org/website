---
import AuditResultsTable from '~hive/components/gateway-reports/AuditResultsTable.astro';
import { withBase } from '~hive/lib/base-path';
import { AUDIT_PATH, auditResults } from '~hive/lib/gateway-reports-data';

interface Props {
  class?: string;
  /** The gateway whose row is highlighted and named in the lead-in. */
  product?: string;
}

const { class: className, product = 'Hive Gateway' } = Astro.props;
---

<section
  class:list={['text-green-1000 px-4 py-6 sm:py-12 md:px-6 lg:py-[120px] xl:px-[120px]', className]}
>
  <header class="md:text-center md:text-balance">
    <h2 class="group text-4xl leading-[1.2] tracking-[-0.56px] md:text-[56px] md:leading-[1.14286]">
      Federation-Compatible Gateway Benchmarks
    </h2>
    <p class="mt-4 mb-6 text-green-800 md:mb-16">
      See the results of our open-source audit for Apollo Federation Gateways.
    </p>
  </header>
  <div class="my-6 flex items-start gap-6 max-md:flex-col md:mt-16 md:mb-12">
    <p class="text-2xl/8 text-pretty lg:text-[32px]/10">
      Learn how {product} performs against other gateways in&nbsp;terms of correctness and
      compliance with the Apollo Federation specification
    </p>
    <a
      class="text-green-1000 relative flex items-center justify-center gap-2 rounded-lg bg-transparent px-6 py-3 leading-6 font-medium text-nowrap focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-green-800 sm:w-fit"
      href={withBase(AUDIT_PATH)}
    >
      <span class="absolute inset-0 rounded-lg border border-green-800"></span>
      Learn about our audit and methodology
    </a>
  </div>
  <AuditResultsTable highlight={product} rows={auditResults} />
</section>
