---
import { withBase } from '../../lib/base-path';
import { ADVANCED_ICONS as ICONS } from './advanced-icons';

export interface AdvancedCard {
  ctaHref: string;
  /** Button text; "Documentation" when the card links to a docs page. */
  ctaLabel?: string;
  description: string;
  heading: string;
  /** Inline SVG markup. */
  icon: string;
  /** Extra classes for the card, e.g. a mobile order. */
  order?: string;
}

interface Props {
  cards?: AdvancedCard[];
  class?: string;
  description?: string;
  title?: string;
}

const gatewayCards: AdvancedCard[] = [
  {
    ctaHref: '/mcp',
    ctaLabel: 'Learn more',
    description:
      'Turn the GraphQL operations you choose into typed tools that AI agents list and call over the Model Context Protocol. In beta.',
    heading: 'MCP Server for AI Agents',
    icon: ICONS.cog,
  },
  {
    ctaHref: '/docs/gateway/subscriptions',
    description:
      'Federated subscriptions over WebSockets, Server-Sent Events and HTTP callbacks, plus event-driven subscriptions fed by NATS, Kafka or Redis.',
    heading: 'GraphQL Subscriptions',
    icon: ICONS.arrow,
  },
  {
    ctaHref: '/docs/gateway/defer-stream',
    description:
      'Send the slow parts of a response later. Speaks the current incremental delivery format and keeps serving the legacy one.',
    heading: '@defer and @stream Support',
    icon: ICONS.layers,
  },
  {
    ctaHref: '/docs/gateway/other-features/security/demand-control',
    description:
      'Price every operation with @cost and @listSize and reject the ones over budget before they reach a subgraph.',
    heading: 'Demand Control',
    icon: ICONS.branch,
  },
  {
    ctaHref: '/docs/gateway/other-features/progressive-override',
    description:
      'Move a field from one subgraph to another for a percentage of traffic or behind a feature flag, with @override labels.',
    heading: 'Progressive Override',
    icon: ICONS.branch,
  },
  {
    ctaHref: '/docs/gateway/other-features/performance/request-batching',
    description:
      'Accept several GraphQL operations in a single HTTP request and cut the network round trips between client and gateway.',
    heading: 'Request Batching',
    icon: ICONS.layers,
  },
  {
    ctaHref: '/docs/gateway/supergraph-proxy-source',
    description:
      'Point the gateway at the subgraphs running on your machine. It composes the supergraph itself and recomposes when a schema changes.',
    heading: 'Local Subgraph Development',
    icon: ICONS.cog,
  },
  {
    ctaHref: 'https://the-guild.dev/graphql/mesh',
    description:
      'Bring OpenAPI, gRPC and other non-GraphQL sources into the supergraph with GraphQL Mesh and serve them next to your subgraphs.',
    heading: 'Beyond GraphQL Subgraphs',
    icon: ICONS.arrow,
  },
];

const {
  cards = gatewayCards,
  class: className,
  description = 'The features teams ask a gateway for once the supergraph is in production.',
  title = "Let's get advanced",
} = Astro.props;
---

<section class:list={['px-4 py-6 sm:py-12 md:px-6 lg:py-16 xl:px-24 xl:pb-24', className]}>
  <h2 class="group text-center text-4xl leading-[1.2] tracking-[-0.48px] md:text-5xl md:leading-[1.16667]">
    {title}
  </h2>
  <p class="mt-4 text-center text-pretty text-green-800">{description}</p>
  <div class="nextra-scrollbar overflow-auto max-sm:-m-4 max-sm:p-4">
    <ul class="mt-6 flex gap-6 *:flex *:flex-col *:rounded-3xl max-sm:*:w-80 max-sm:*:shrink-0 sm:grid sm:grid-cols-2 md:mt-8 md:*:p-8 lg:mt-12 xl:mt-16 xl:grid-cols-4">
      {cards.map(card => (
        <li class:list={['bg-beige-100 p-6 md:p-12', card.order]}>
          <div
            class="w-fit rounded-lg bg-[linear-gradient(135deg,#68A8B6,#3B736A)] p-[9px] text-white"
            set:html={card.icon}
          />
          <h3 class="text-green-1000 mt-4 mb-4 text-xl leading-[1.4] font-medium md:mt-6">
            {card.heading}
          </h3>
          <div class="contents">
            <p class="text-green-800">{card.description}</p>
            <div class="grow" />
            <a
              class="text-green-1000 relative mt-5! flex items-center justify-center gap-2 rounded-lg bg-transparent px-6 py-3 leading-6 font-medium text-nowrap focus-visible:ring-0 focus-visible:ring-offset-0 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-green-800 sm:w-fit xl:w-full"
              href={withBase(card.ctaHref)}
            >
              <span class="absolute inset-0 rounded-lg border border-green-800" />
              {card.ctaLabel ?? 'Documentation'}
            </a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
