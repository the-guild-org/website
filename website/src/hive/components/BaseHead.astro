---
/**
 * Shared document head: description, canonical, social/OpenGraph metadata,
 * BreadcrumbList structured data, feed and llms.txt discovery, font
 * preloads, and the page title. Included by every page's <head>.
 */
import type { ImageMetadata } from 'astro';
import { basePath, SITE_ORIGIN, HIVE_SITE_URL as SITE_URL, withBase } from '../lib/base-path';
import FontPreloads from './FontPreloads.astro';
import defaultImage from '../documentation/src/routes/opengraph-image.png';

interface Breadcrumb {
  name: string;
  path: string;
}

interface SiteIdentity {
  /** Mount path of the product, e.g. "/graphql/hive". */
  mountPath: string;
  name: string;
  /** Absolute URL of the mount point. */
  url: string;
}

interface Props {
  /** Ancestor breadcrumbs for the JSON-LD trail; the page itself is appended. */
  breadcrumbs?: Breadcrumb[];
  canonical?: string;
  description: string;
  image?: ImageMetadata | string;
  imageAlt?: string;
  /** Which docs product this head belongs to; defaults to Hive. */
  site?: SiteIdentity;
  title: string;
  type?: 'article' | 'website';
}

const TWITTER_ACCOUNT = '@TheGuildDev';

const {
  breadcrumbs = [],
  canonical,
  description,
  image = defaultImage,
  imageAlt = 'GraphQL Hive',
  site = { mountPath: basePath, name: 'Hive', url: SITE_URL },
  title,
  type = 'website',
} = Astro.props;

const SITE_NAME = site.name;
const siteUrl = site.url;
const mountPath = site.mountPath;

/** Strips the mount prefix — it is not part of logical paths. */
function stripBase(path: string) {
  // File-format output puts the landing page at <base>.html.
  if (path === `${mountPath}.html`) return '';
  return mountPath && (path === mountPath || path.startsWith(`${mountPath}/`))
    ? path.slice(mountPath.length)
    : path;
}

// Strip the .html suffix file-format output bakes into pathnames, and the
// trailing slash, so canonicals match the public URL shape and the
// generated sitemap (slash-less, no extension).
const currentPath = stripBase(Astro.url.pathname)
  .replace(/\.html$/, '')
  .replace(/\/$/, '');
const canonicalUrl = canonical ?? `${siteUrl}${currentPath}`;
// Bundled assets are emitted at the shared /_astro root of the unified
// site, so they join with the origin; anything else is a Hive-relative
// path and joins with the mounted site URL.
const imagePath = stripBase(typeof image === 'string' ? image : image.src);
const imageUrl = /^https?:\/\//.test(imagePath)
  ? imagePath
  : imagePath.startsWith('/_astro/')
    ? `${SITE_ORIGIN}${imagePath}`
    : `${siteUrl}/${imagePath.replace(/^\//, '')}`;
const imageWidth = typeof image === 'string' ? undefined : image.width;
const imageHeight = typeof image === 'string' ? undefined : image.height;

// BreadcrumbList structured data, mirroring the old site: provided ancestors
// followed by the page itself (the bare site root is named after the site).
const pageCrumbName = currentPath === '' ? SITE_NAME : (title.split('|')[0] ?? title).trim();
const breadcrumbJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [...breadcrumbs, { name: pageCrumbName, path: currentPath }].map(
    (crumb, index) => ({
      '@type': 'ListItem',
      item: /^https?:\/\//.test(crumb.path) ? crumb.path : `${siteUrl}${stripBase(crumb.path)}`,
      name: crumb.name,
      position: index + 1,
    }),
  ),
});
---

{/* Rendered here because every page head includes this component. */}
<FontPreloads />
<meta name="description" content={description} />
<link rel="canonical" href={withBase(canonicalUrl)} />
<link
  rel="alternate"
  type="text/markdown"
  href={withBase(`${siteUrl}/llms.txt`)}
  title={`${SITE_NAME} documentation for LLMs`}
/>
<link rel="sitemap" type="application/xml" href={withBase(`${siteUrl}/sitemap.xml`)} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt} />
{imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
{imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={TWITTER_ACCOUNT} />
<meta name="twitter:creator" content={TWITTER_ACCOUNT} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />
<script is:inline type="application/ld+json" set:html={breadcrumbJsonLd} />
<title>{title}</title>
