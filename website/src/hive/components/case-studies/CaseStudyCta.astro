---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<section class:list={['relative mx-auto my-24 h-[348px] w-full max-w-360 max-sm:px-4', className]}>
  <div class="flex h-full flex-col items-center justify-center gap-10">
    <h2
      class="group text-green-1000 text-4xl leading-[1.2] tracking-[-0.56px] md:text-[56px] md:leading-[1.14286] dark:text-white"
      id="get-your-api-game-right"
    >
      Get your API game right.
    </h2>
    <div class="flex gap-4">
      <a
        class="text-green-1000 relative flex items-center justify-center gap-2 rounded-lg bg-green-800 px-6 py-3 leading-6 font-medium text-nowrap text-white outline-hidden hover:bg-green-700 focus-visible:ring-0 focus-visible:ring-3 focus-visible:ring-offset-0 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-green-800/40 sm:w-fit dark:text-neutral-200 dark:text-white [&:hover>:first-child]:-inset-px [&:hover>:first-child]:rounded-[9px]"
        href="https://app.graphql-hive.com/"
        rel="noreferrer"
        target="_blank"
      >
        <span class="absolute inset-0 rounded-lg border border-green-800 dark:border-neutral-200"
        ></span>
        Get started for free
      </a>
      <a
        class="text-green-1000 text-green-1000 relative flex items-center justify-center gap-2 rounded-lg bg-transparent px-6 py-3 leading-6 font-medium text-nowrap focus-visible:ring-0 focus-visible:ring-offset-0 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-green-800 sm:w-fit dark:text-neutral-200 [&:hover>:first-child]:-inset-px [&:hover>:first-child]:rounded-[9px]"
        data-case-study-contact
        href="https://the-guild.dev/contact"
      >
        <span class="absolute inset-0 rounded-lg border border-green-800 dark:border-neutral-200"
        ></span>
        Talk to us
      </a>
    </div>
  </div>
  <div class="pointer-events-none absolute inset-0 overflow-hidden">
    <svg
      class="absolute top-6 max-sm:hidden"
      fill="none"
      height="301"
      viewBox="0 0 348 301"
      width="348"
      ><path
        d="M14.1268 159.403C5.40655 168.123 0.500031 179.959 0.500032 192.284L0.500013 299.875L89.7312 299.875L89.7312 161.118C89.7312 121.896 121.521 90.1062 160.743 90.1062L347.5 90.1061L347.5 0.87501L191.909 0.874992C179.584 0.874992 167.748 5.78152 159.028 14.5018L90.5847 82.9449L82.5699 90.9597L14.1268 159.403Z"
        stroke="url(#arch-gradient-g7x9p2)"></path></svg
    >
    <svg
      class="absolute top-6 right-0 rotate-180"
      fill="none"
      height="301"
      viewBox="0 0 348 301"
      width="348"
      ><path
        d="M14.1268 159.403C5.40655 168.123 0.500031 179.959 0.500032 192.284L0.500013 299.875L89.7312 299.875L89.7312 161.118C89.7312 121.896 121.521 90.1062 160.743 90.1062L347.5 90.1061L347.5 0.87501L191.909 0.874992C179.584 0.874992 167.748 5.78152 159.028 14.5018L90.5847 82.9449L82.5699 90.9597L14.1268 159.403Z"
        stroke="url(#arch-gradient-g7x9p2)"></path></svg
    >
    <svg class="size-0" fill="none" height="301" viewBox="0 0 348 301" width="348">
      <defs>
        <linearGradient
          gradientUnits="userSpaceOnUse"
          id="arch-gradient-g7x9p2"
          x1="186"
          x2="9.37509"
          y1="181.934"
          y2="5.30912"
        >
          <stop stop-color="#A2C1C4" stop-opacity="0"></stop>
          <stop offset="1" stop-color="#A2C1C4" stop-opacity="0.8"></stop>
        </linearGradient>
      </defs>
    </svg>
  </div>
</section>
