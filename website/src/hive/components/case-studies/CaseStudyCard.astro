---
import arrowRaw from '../../design-system/icons/arrow-icon.svg?raw';
import { withBase } from '../../lib/base-path';
import CompanyLogo from './CompanyLogo.astro';

interface Props {
  category?: string;
  class?: string;
  excerpt: string;
  href: string;
  slug: string;
}

const { category, class: className, excerpt, href, slug } = Astro.props;
---

<a
  class:list={[
    'hive-focus bg-beige-100 hover:bg-beige-200/70 hover:ring-beige-400 flex flex-col gap-6 rounded-2xl p-6 outline-hidden hover:not-focus:ring-3 focus-visible:ring-3 sm:gap-10 dark:bg-neutral-800/70 dark:ring-neutral-600 dark:hover:bg-neutral-800 dark:hover:not-focus:ring-neutral-600',
    className,
  ]}
  href={withBase(href)}
>
  <div>
    {
      category && (
        <div class="text-beige-800 mb-4 text-sm font-medium dark:text-neutral-400">{category}</div>
      )
    }
    <CompanyLogo slug={slug} />
  </div>
  <p class="text-xl">{excerpt}</p>
  <div class="mt-auto flex items-center justify-between gap-2">
    Read full story
    <Fragment set:html={arrowRaw} />
  </div>
</a>
