---
interface Props {
  defaultOpen?: boolean;
  name: string;
}

const { defaultOpen = false, name } = Astro.props;
---

<details class="fd-folder" open={defaultOpen}>
  <summary
    class="hover:bg-fd-accent hover:text-fd-accent-foreground flex w-full flex-row items-center gap-2 rounded-md px-2 py-1.5 text-sm [&_svg]:size-4"
  >
    <svg
      class="icon-closed"
      fill="none"
      height="24"
      stroke="currentColor"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      viewBox="0 0 24 24"
      width="24"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"
      ></path>
    </svg>
    <svg
      class="icon-open"
      fill="none"
      height="24"
      stroke="currentColor"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      viewBox="0 0 24 24"
      width="24"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="m6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2"
      ></path>
    </svg>
    {name}
  </summary>
  <div class="border-fd-border ms-2 flex flex-col border-l ps-2">
    <slot />
  </div>
</details>

<style>
  .fd-folder > summary {
    cursor: pointer;
    list-style: none;
  }

  .fd-folder > summary::-webkit-details-marker {
    display: none;
  }

  .fd-folder .icon-open {
    display: none;
  }

  .fd-folder[open] > summary .icon-open {
    display: block;
  }

  .fd-folder[open] > summary .icon-closed {
    display: none;
  }
</style>
