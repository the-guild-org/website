---
const { alt = "", className, src } = Astro.props;
---

<img
  alt={alt}
  class:list={["small-avatar", className]}
  height="24"
  loading="lazy"
  src={src}
  width="24"
/>

<style>
  .small-avatar {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    object-fit: cover;
  }
</style>
