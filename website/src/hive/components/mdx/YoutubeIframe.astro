---
const { src, title = "YouTube video" } = Astro.props;
---

<div class="youtube-frame">
  <iframe
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
    allowfullscreen
    loading="lazy"
    src={src}
    title={title}
  ></iframe>
</div>

<style>
  .youtube-frame {
    position: relative;
    width: 100%;
    margin: 1.5rem 0;
    padding-bottom: 56.25%;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 0.6rem;
    background: #000;
  }

  iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
