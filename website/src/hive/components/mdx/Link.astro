---
import { withBase } from "../../lib/base-path";
interface Props {
  href?: string;
  [key: string]: unknown;
}

const { href, ...props } = Astro.props;
const external = href ? /^https?:\/\//.test(href) : false;
---

<a {...props} href={withBase(href)} rel={external ? "noreferrer" : undefined} target={external ? "_blank" : undefined}>
  <slot />
</a>
