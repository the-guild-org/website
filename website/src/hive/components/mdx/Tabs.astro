---
interface Props {
  defaultIndex?: number | string;
  items?: unknown[];
}

const { defaultIndex = 0, items = [] } = Astro.props;
const labels = items.map(item =>
  typeof item === 'string' || typeof item === 'number' ? String(item) : undefined,
);
---

<div class="fd-tabs" data-default-index={defaultIndex}>
  <div
    class="fd-tabs-list mt-4 flex w-full gap-2 overflow-x-auto overflow-y-hidden pb-px shadow-[inset_0_-1px_0_var(--color-beige-400)] dark:shadow-[inset_0_-1px_0_var(--color-neutral-800)]"
    role="tablist"
  >
    {
      labels.map((label, index) => (
        <button
          aria-selected={index === Number(defaultIndex)}
          class="fd-tab-trigger text-beige-800 hover:border-beige-400 dark:text-beige-200 dark:aria-selected:text-primary -mb-px shrink-0 cursor-pointer rounded-t border-b border-transparent bg-transparent p-2 leading-5 font-medium whitespace-nowrap transition-colors hover:text-black focus-visible:outline-2 focus-visible:-outline-offset-2 aria-selected:border-current aria-selected:text-green-900 dark:hover:border-neutral-800 dark:hover:text-white"
          data-index={index}
          data-tab-label={label}
          role="tab"
          type="button"
        >
          {label}
        </button>
      ))
    }
  </div>
  <div class="tab-panels mt-5"><slot /></div>
</div>

<script>
  function initializeTabs(root: HTMLElement) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>(':scope > .fd-tabs-list > button')];
    const panels = [...root.querySelectorAll<HTMLElement>(':scope > .tab-panels > .tab-panel')];
    const show = (index: number, updateUrl = false) => {
      tabs.forEach((tab, tabIndex) => {
        const selected = tabIndex === index;
        tab.ariaSelected = String(selected);
        tab.tabIndex = selected ? 0 : -1;
      });
      panels.forEach((panel, panelIndex) => (panel.hidden = panelIndex !== index));

      if (updateUrl) {
        const label = tabs[index]?.dataset.tabLabel;
        if (label) {
          const url = new URL(window.location.href);
          url.searchParams.set('tab', label);
          window.history.replaceState(window.history.state, '', url);
        }
      }
    };
    tabs.forEach((tab, index) => tab.addEventListener('click', () => show(index, true)));

    const tabParam = new URLSearchParams(window.location.search).get('tab');
    const matchedIndex = tabParam ? tabs.findIndex(tab => tab.dataset.tabLabel === tabParam) : -1;
    show(matchedIndex !== -1 ? matchedIndex : Number(root.dataset.defaultIndex) || 0);
  }

  document.querySelectorAll<HTMLElement>('.fd-tabs').forEach(initializeTabs);
</script>
