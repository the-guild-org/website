---
/**
 * Preloads the text fonts so first paint doesn't flash the fallback font:
 * the woff2 files are otherwise only discovered after the stylesheet
 * downloads and parses. Regular covers body text, Medium and SemiBold the
 * headings. Font preloads require crossorigin even for same-origin files.
 */
import mediumWoff2 from '../documentation/src/fonts/PPNeueMontreal-Medium.woff2?url';
import regularWoff2 from '../documentation/src/fonts/PPNeueMontreal-Regular.woff2?url';
import semiBoldWoff2 from '../documentation/src/fonts/PPNeueMontreal-SemiBold.woff2?url';
---

<link rel="preload" href={regularWoff2} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={mediumWoff2} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={semiBoldWoff2} as="font" type="font/woff2" crossorigin />
