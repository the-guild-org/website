---
import { withBase } from '../lib/base-path';
import type { TocHeading } from '../lib/toc';

interface Props {
  headings: TocHeading[];
}

const { headings } = Astro.props;
---

<h2 class="text-fd-muted-foreground inline-flex items-center gap-1.5 text-sm">
  <svg
    class="size-4"
    aria-hidden="true"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"><path d="M4 6h16M4 12h16M4 18h10"></path></svg
  >
  On this page
</h2>
<div
  class="relative ms-px min-h-0 [scrollbar-width:none] overflow-auto [mask-image:linear-gradient(to_bottom,transparent,white_16px,white_calc(100%-16px),transparent)] py-3 text-sm"
>
  <div
    class="toc-thumb bg-fd-primary absolute top-(--fd-top) h-(--fd-height) w-0.5 rounded-e-sm transition-[top,height] ease-linear"
  >
  </div>
  <nav class="border-fd-foreground/10 flex flex-col border-s">
    {
      headings.map(heading => (
        <a
          class:list={[
            'toc-link text-fd-muted-foreground data-[active=true]:text-fd-primary py-1.5 text-sm wrap-anywhere transition-colors first:pt-0 last:pb-0',
            heading.depth <= 2 ? 'ps-3' : heading.depth === 3 ? 'ps-6' : 'ps-8',
          ]}
          data-toc-anchor={heading.slug}
          href={withBase(`#${heading.slug}`)}
          set:html={heading.html}
        />
      ))
    }
  </nav>
</div>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc-link')];
  const thumb = document.querySelector<HTMLElement>('.toc-thumb');
  const updateToc = () => {
    if (links.length === 0) return;
    const active =
      [...links].reverse().find(link => {
        const id = link.dataset.tocAnchor;
        if (!id) return false;
        const top = document.getElementById(id)?.getBoundingClientRect().top;
        return top !== undefined && top <= 140;
      }) ?? links[0];
    links.forEach(link => (link.dataset.active = String(link === active)));
    if (thumb) {
      thumb.style.setProperty('--fd-top', `${active.offsetTop}px`);
      thumb.style.setProperty('--fd-height', `${active.offsetHeight}px`);
    }
  };
  updateToc();
  addEventListener('scroll', updateToc, { passive: true });
</script>
