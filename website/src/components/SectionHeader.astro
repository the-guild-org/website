---
import Path from 'src/components/Path.astro';

interface Props {
  path: string;
  title: string;
}

const { path, title } = Astro.props;
---

<header class="mb-12 max-w-[820px]">
  <div class="mb-3.5 font-mono text-xs tracking-label text-[var(--muted)] lowercase">
    <Path>
      {path}
    </Path>
  </div>
  <h2 class="mb-3.5 font-mono text-5xl font-semibold text-balance text-[var(--strong)]">
    {title}
  </h2>
  <div class="max-w-[800px] text-lg text-pretty text-[var(--muted)]">
    <slot />
  </div>
</header>
