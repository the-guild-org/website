---
import Path from './Path.astro';

// Same backend as the current Guild website's Get in Touch form:
// POST https://utils.the-guild.dev/api/contact-us { name, email, notes, turnstileToken }
// (packages/website-helper-worker). CORS is limited to the-guild.dev origins,
// and the Turnstile site key to its hostnames, so submissions only succeed on
// the production domain.
---

<dialog
  id="contact-dialog"
  class="m-auto w-[min(560px,calc(100vw-32px))] border border-[var(--line-strong)] bg-[var(--bg)] p-0 text-[var(--text)] backdrop:bg-black/60 backdrop:backdrop-blur-[2px]"
>
  <div class="p-7 sm:p-9">
    <div class="mb-3.5 flex items-baseline justify-between">
      <Path> ~/the-guild/contact </Path>
      <button
        type="button"
        data-contact-close
        class="rounded-xs px-1 font-mono text-sm text-[var(--muted)] transition-colors hover:text-[var(--strong)] focus-visible:outline focus-visible:outline-offset-4 focus-visible:outline-[var(--green)]"
        aria-label="Close contact form"
      >
        [ esc ]
      </button>
    </div>

    <div data-contact-form-view>
      <h2 class="mb-2 font-mono text-2xl font-semibold text-[var(--strong)]">
        Talk to an engineer
      </h2>
      <p class="mb-6 text-base text-[var(--muted)]">
        Tell us a bit about your setup and what you're after. An engineer who maintains these tools
        will get back to you.
      </p>
      <form data-contact-form novalidate>
        <div class="flex flex-col gap-5">
          <label class="block">
            <span class="mb-1.5 block font-mono text-xs tracking-label text-[var(--muted)] lowercase">
              name *
            </span>
            <input
              name="name"
              type="text"
              required
              autocomplete="name"
              class="w-full border border-[var(--line-strong)] bg-transparent px-3 py-2 text-base text-[var(--text)] placeholder:text-[var(--faint)] focus:outline focus:outline-offset-2 focus:outline-[var(--green)]"
              placeholder="Ada Lovelace"
            />
          </label>
          <label class="block">
            <span class="mb-1.5 block font-mono text-xs tracking-label text-[var(--muted)] lowercase">
              email *
            </span>
            <input
              name="email"
              type="email"
              required
              autocomplete="email"
              class="w-full border border-[var(--line-strong)] bg-transparent px-3 py-2 text-base text-[var(--text)] placeholder:text-[var(--faint)] focus:outline focus:outline-offset-2 focus:outline-[var(--green)]"
              placeholder="you@company.com"
            />
          </label>
          <label class="block">
            <span class="mb-1.5 block font-mono text-xs tracking-label text-[var(--muted)] lowercase">
              message *
            </span>
            <textarea
              name="notes"
              required
              rows="4"
              class="w-full resize-y border border-[var(--line-strong)] bg-transparent px-3 py-2 text-base text-[var(--text)] placeholder:text-[var(--faint)] focus:outline focus:outline-offset-2 focus:outline-[var(--green)]"
              placeholder="What are you building, and how can we help?"
            ></textarea>
          </label>
        </div>
        <!-- Cloudflare Turnstile; shown only while Cloudflare asks for an interaction -->
        <div data-contact-turnstile hidden class="mt-5"></div>
        <p data-contact-error hidden class="mt-4 font-mono text-sm text-[var(--amber)]">
          Something went wrong. Please try again, or email us at{' '}
          <a
            class="underline underline-offset-2 hover:text-[var(--strong)]"
            href="mailto:contact@the-guild.dev"
          >
            contact@the-guild.dev
          </a>
          .
        </p>
        <p data-contact-invalid hidden class="mt-4 font-mono text-sm text-[var(--amber)]">
          Please fill in all fields with a valid email.
        </p>
        <p data-contact-captcha hidden class="mt-4 font-mono text-sm text-[var(--amber)]">
          We couldn't verify you're human. Please complete the check above and try again.
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-2.5">
          <button
            type="submit"
            data-contact-submit
            class="inline-flex cursor-pointer items-center rounded-xs px-0.5 py-1.5 font-mono text-sm leading-tight whitespace-nowrap text-[var(--strong)] transition-colors before:mr-[.7ch] before:text-[var(--faint)] before:content-['['] after:ml-[.7ch] after:text-[var(--faint)] after:content-[']'] hover:before:text-[var(--strong)] hover:after:text-[var(--strong)] focus-visible:outline focus-visible:outline-offset-4 focus-visible:outline-[var(--green)] disabled:cursor-wait disabled:opacity-60"
          >
            send message
          </button>
          <button
            type="button"
            data-contact-close
            class="inline-flex cursor-pointer items-center rounded-xs px-0.5 py-1.5 font-mono text-sm leading-tight whitespace-nowrap text-[var(--muted)] transition-colors before:mr-[.7ch] before:text-[var(--faint)] before:content-['['] after:ml-[.7ch] after:text-[var(--faint)] after:content-[']'] hover:text-[var(--strong)] hover:before:text-[var(--strong)] hover:after:text-[var(--strong)] focus-visible:outline focus-visible:outline-offset-4 focus-visible:outline-[var(--green)]"
          >
            cancel
          </button>
        </div>
      </form>
    </div>

    <div data-contact-success-view hidden>
      <h2 class="mb-2 font-mono text-2xl font-semibold text-[var(--green)]">Message sent</h2>
      <p class="mb-6 text-sm text-[var(--muted)]">Thank you, we'll contact you soon.</p>
      <button
        type="button"
        data-contact-close
        class="inline-flex cursor-pointer items-center rounded-xs px-0.5 py-1.5 font-mono text-sm leading-tight whitespace-nowrap text-[var(--strong)] transition-colors before:mr-[.7ch] before:text-[var(--faint)] before:content-['['] after:ml-[.7ch] after:text-[var(--faint)] after:content-[']'] hover:before:text-[var(--strong)] hover:after:text-[var(--strong)] focus-visible:outline focus-visible:outline-offset-4 focus-visible:outline-[var(--green)]"
      >
        close
      </button>
    </div>
  </div>
</dialog>

<script>
  type Turnstile = {
    render(container: HTMLElement, options: Record<string, unknown>): string;
    getResponse(widgetId: string): string | undefined;
    reset(widgetId: string): void;
  };

  const TURNSTILE_SITE_KEY = '0x4AAAAAAB-9vuIUJrCPlFK3';
  const turnstileWindow = window as typeof window & {
    turnstile?: Turnstile;
    onTurnstileLoad?: () => void;
  };

  const dialog = document.querySelector<HTMLDialogElement>('#contact-dialog')!;
  const form = dialog.querySelector<HTMLFormElement>('[data-contact-form]')!;
  const formView = dialog.querySelector<HTMLElement>('[data-contact-form-view]')!;
  const successView = dialog.querySelector<HTMLElement>('[data-contact-success-view]')!;
  const errorMessage = dialog.querySelector<HTMLElement>('[data-contact-error]')!;
  const invalidMessage = dialog.querySelector<HTMLElement>('[data-contact-invalid]')!;
  const submitButton = dialog.querySelector<HTMLButtonElement>('[data-contact-submit]')!;
  const captchaMessage = dialog.querySelector<HTMLElement>('[data-contact-captcha]')!;
  const turnstileContainer = dialog.querySelector<HTMLElement>('[data-contact-turnstile]')!;

  // The Turnstile script is loaded on the first open rather than on every page
  // view. Its token is single-use, so the widget is reset after each submit.
  let turnstileLoading: Promise<Turnstile> | undefined;
  let turnstileScript: HTMLScriptElement | undefined;
  let widgetId: string | undefined;
  let tokenWaiters: Array<(token: string) => void> = [];

  function loadTurnstile() {
    if (turnstileWindow.turnstile) return Promise.resolve(turnstileWindow.turnstile);
    if (turnstileLoading) return turnstileLoading;
    const script = document.createElement('script');
    turnstileScript = script;
    turnstileLoading = new Promise<Turnstile>((resolve, reject) => {
      turnstileWindow.onTurnstileLoad = () => resolve(turnstileWindow.turnstile!);
      script.onerror = () => {
        abandonTurnstileLoad(script);
        reject(new Error('Turnstile failed to load'));
      };
    });
    script.src =
      'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onTurnstileLoad';
    script.async = true;
    document.head.append(script);
    return turnstileLoading;
  }

  // Drops a failed or stalled load so the next attempt injects a fresh script.
  // Only the current attempt's script may clear the shared state, so a late
  // error from an abandoned script cannot reset a newer attempt.
  function abandonTurnstileLoad(script: HTMLScriptElement) {
    script.remove();
    if (turnstileScript !== script) return;
    turnstileScript = undefined;
    turnstileLoading = undefined;
  }

  async function renderTurnstile() {
    const turnstile = await loadTurnstile();
    widgetId ??= turnstile.render(turnstileContainer, {
      sitekey: TURNSTILE_SITE_KEY,
      action: 'contact',
      appearance: 'interaction-only',
      theme: document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light',
      'before-interactive-callback'() {
        turnstileContainer.hidden = false;
      },
      'after-interactive-callback'() {
        turnstileContainer.hidden = true;
      },
      callback(token: string) {
        captchaMessage.hidden = true;
        for (const resolve of tokenWaiters) resolve(token);
        tokenWaiters = [];
      },
    });
    return turnstile;
  }

  // Resolves with the current token, waiting for the widget when the visitor
  // submits before it has finished (or while it shows a challenge). The
  // deadline covers loading the script as well: a load that misses it is
  // abandoned and throws (the generic error shows, and the next submit
  // retries), while a widget still without a token resolves '' (the captcha
  // message shows).
  async function getTurnstileToken(timeoutMs = 15_000): Promise<string> {
    const timedOut = Symbol('timed out');
    let waiter: ((token: string) => void) | undefined;
    let timer: ReturnType<typeof setTimeout> | undefined;

    const acquire = (async () => {
      const turnstile = await renderTurnstile();
      const token = turnstile.getResponse(widgetId!);
      if (token) return token;
      return new Promise<string>(resolve => {
        waiter = resolve;
        tokenWaiters.push(resolve);
      });
    })();
    // A load error after the deadline has already won must not go unhandled.
    acquire.catch(() => {});
    const deadline = new Promise<typeof timedOut>(resolve => {
      timer = setTimeout(() => resolve(timedOut), timeoutMs);
    });

    try {
      const result = await Promise.race([acquire, deadline]);
      if (result !== timedOut) return result;
    } finally {
      clearTimeout(timer);
      tokenWaiters = tokenWaiters.filter(w => w !== waiter);
    }

    if (widgetId === undefined) {
      if (turnstileScript) abandonTurnstileLoad(turnstileScript);
      throw new Error('Turnstile did not load in time');
    }
    return '';
  }

  function openDialog() {
    formView.hidden = false;
    successView.hidden = true;
    errorMessage.hidden = true;
    invalidMessage.hidden = true;
    captchaMessage.hidden = true;
    dialog.showModal();
    // A load failure surfaces on submit, where getTurnstileToken retries it.
    renderTurnstile().catch(() => {});
    dialog.querySelector<HTMLInputElement>('input[name="name"]')?.focus();
  }

  for (const opener of document.querySelectorAll('[data-contact-open]')) {
    opener.addEventListener('click', event => {
      event.preventDefault();
      openDialog();
    });
  }

  // Contact links across the site point at /#talk-to-an-engineer (and the
  // old /contact redirects there, see public/_redirects), which matches no
  // element so the page stays at the top with the dialog open. #contact is
  // handled the same way: browsers permanently cached the first deploy's 301
  // to it, and it is the contact section's id — so the anchor scroll is
  // undone and the hash cleaned. In-page openers call preventDefault, so none
  // of this fires for in-page clicks; a plain link to the hash from this page
  // only changes the hash, hence the hashchange listener.
  function openFromHash() {
    if (location.hash !== '#talk-to-an-engineer' && location.hash !== '#contact') return;
    history.replaceState(null, '', location.pathname + location.search);
    openDialog();
    window.scrollTo(0, 0);
    requestAnimationFrame(() => window.scrollTo(0, 0));
  }
  openFromHash();
  window.addEventListener('hashchange', openFromHash);

  for (const closer of dialog.querySelectorAll('[data-contact-close]')) {
    closer.addEventListener('click', () => dialog.close());
  }

  // Click on the backdrop (outside the panel) closes the dialog
  dialog.addEventListener('click', event => {
    if (event.target === dialog) dialog.close();
  });

  form.addEventListener('submit', async event => {
    event.preventDefault();
    errorMessage.hidden = true;
    invalidMessage.hidden = true;
    captchaMessage.hidden = true;

    if (!form.checkValidity()) {
      invalidMessage.hidden = false;
      return;
    }

    const data = new FormData(form);
    submitButton.disabled = true;
    submitButton.textContent = 'sending…';

    try {
      const turnstileToken = await getTurnstileToken();
      if (!turnstileToken) {
        captchaMessage.hidden = false;
        return;
      }
      const response = await fetch('https://utils.the-guild.dev/api/contact-us', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: data.get('name'),
          email: data.get('email'),
          notes: data.get('notes'),
          turnstileToken,
        }),
      });
      if (response.status === 403) {
        captchaMessage.hidden = false;
        return;
      }
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      form.reset();
      formView.hidden = true;
      successView.hidden = false;
    } catch {
      errorMessage.hidden = false;
    } finally {
      if (widgetId !== undefined) turnstileWindow.turnstile?.reset(widgetId);
      submitButton.disabled = false;
      submitButton.textContent = 'send message';
    }
  });
</script>
