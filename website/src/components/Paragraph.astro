---
const sizes = {
  lg: 'text-lg',
} as const;

interface Props {
  size?: keyof typeof sizes;
}

const { size = 'lg' } = Astro.props;
---

<p
  class={`mb-3 max-w-[880px] ${sizes[size]} text-pretty text-[var(--hero-copy)] [&_strong]:font-semibold [&_strong]:text-[var(--strong)]`}
>
  <slot />
</p>
