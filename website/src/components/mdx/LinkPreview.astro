---
// Static replacement for the old site's runtime link-preview fetcher:
// renders the target as a styled card without fetching remote metadata.
interface Props {
  link: string;
}

const { link } = Astro.props;
const isExternal = link.startsWith('http');
const label = isExternal ? link.replace(/^https?:\/\//, '') : link;
---

<a
  class="group my-6 flex items-baseline justify-between gap-3 border border-[var(--line)] px-4 py-3 transition-colors hover:border-[var(--line-strong)]"
  href={link}
>
  <span
    class="font-mono text-[14px] break-all text-[var(--text)] transition-colors group-hover:text-[var(--strong)]"
    >{label}</span
  >
  <span
    aria-hidden="true"
    class="shrink-0 font-mono text-[12px] text-[var(--green)] transition-transform group-hover:translate-x-0.5"
    >{isExternal ? '↗' : '→'}</span
  >
</a>
