{
  "name": "website",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "astro check && astro build && pnpm run postbuild:hive",
    "check": "astro check",
    "check-seo": "node scripts/hive/check-seo.ts",
    "dev": "astro dev",
    "postbuild:hive": "node scripts/hive/generate-sitemap.ts && node scripts/hive/generate-redirects.ts && node scripts/hive/generate-headers.ts && pagefind --site dist/graphql/hive && node scripts/hive/verify-base-path.ts",
    "postinstall": "playwright install chromium",
    "preview": "astro preview",
    "test": "vitest run src"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.2.2",
    "@astrojs/mdx": "7.0.5",
    "@shikijs/rehype": "^3.21.0",
    "@shikijs/transformers": "^3.21.0",
    "@tailwindcss/vite": "4.1.18",
    "astro": "7.2.0",
    "npm-to-yarn": "3.0.1",
    "playwright": "1.57.0",
    "rehype-mermaid": "3.0.0",
    "sharp": "^0.35.3",
    "shiki": "^3.21.0",
    "tailwindcss": "4.1.18",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "pagefind": "1.5.2",
    "vitest": "^4.0.5"
  }
}
