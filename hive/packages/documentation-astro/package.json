{
  "name": "documentation-astro",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && bun run generate:sitemap && bun run generate:redirects && bun run generate:headers && pagefind --site dist && bun scripts/verify-base-path.ts",
    "generate:redirects": "bun scripts/generate-redirects.ts",
    "generate:headers": "bun scripts/generate-headers.ts",
    "generate:sitemap": "bun scripts/generate-sitemap.ts",
    "typecheck": "astro check",
    "postinstall": "bun playwright install chromium",
    "test:bun": "bun test src",
    "check-seo": "bun scripts/check-seo.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.2",
    "@astrojs/mdx": "7.0.5",
    "@hive/design-system": "workspace:*",
    "@shikijs/rehype": "^3.21.0",
    "@shikijs/transformers": "^3.21.0",
    "astro": "7.2.0",
    "npm-to-yarn": "3.0.1",
    "playwright": "1.57.0",
    "rehype-mermaid": "3.0.0",
    "sharp": "^0.35.3",
    "shiki": "^3.21.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@tailwindcss/vite": "4.1.18",
    "pagefind": "1.5.2",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "bun": "^1.3.0",
    "@sparticuz/chromium": "^149.0.0"
  }
}
