---
import calloutCriticalRaw from "../../../../design-system/src/icons/callout-critical.svg?raw";
import calloutInfoRaw from "../../../../design-system/src/icons/callout-info.svg?raw";
import calloutNeutralRaw from "../../../../design-system/src/icons/callout-neutral.svg?raw";
import calloutSuccessRaw from "../../../../design-system/src/icons/callout-success.svg?raw";
import calloutWarningRaw from "../../../../design-system/src/icons/callout-warning.svg?raw";

interface Props {
  class?: string;
  className?: string;
  title?: string;
  type?: "critical" | "info" | "note" | "success" | "tip" | "warning";
}

const { class: className, className: reactClassName, title, type = "info" } = Astro.props;

const icons = {
  critical: calloutCriticalRaw,
  info: calloutInfoRaw,
  note: calloutNeutralRaw,
  success: calloutSuccessRaw,
  tip: calloutNeutralRaw,
  warning: calloutWarningRaw,
};

const variants = {
  critical:
    "border-critical-500 bg-critical-100 text-critical-800 dark:border-[rgba(255,198,187,0.2)] dark:bg-[rgba(255,240,232,0.2)] dark:text-[#ffc6bb]",
  info:
    "border-info-500 bg-info-100/50 text-info-800 dark:border-info-500/25 dark:bg-info-500/3 dark:text-[#e7f7ff]",
  note:
    "border-beige-500 bg-beige-200 text-beige-900 dark:border-[rgba(109,106,99,0.4)] dark:bg-[rgba(77,75,70,0.4)] dark:text-[#dedacf]",
  success:
    "border-positive-500 bg-positive-100 text-positive-800 dark:border-[rgba(175,213,99,0.2)] dark:bg-[rgba(175,213,99,0.2)] dark:text-[#afd563]",
  tip:
    "border-beige-500 bg-beige-200 text-beige-900 dark:border-[rgba(109,106,99,0.4)] dark:bg-[rgba(77,75,70,0.4)] dark:text-[#dedacf]",
  warning:
    "border-warning-500 bg-warning-100/35 text-warning-800 dark:border-[rgba(231,222,98,0.2)] dark:bg-[rgba(251,248,203,0.2)] dark:text-[#d7cf53]",
};
---

<aside
  class:list={[
    "hive-callout mt-6 flex min-h-12 gap-2 rounded-lg border px-[13px] py-[9px]",
    variants[type],
    className,
    reactClassName,
  ]}
>
  <span class="mt-0.5 block size-6 shrink-0 [&_svg]:block [&_svg]:size-full" set:html={icons[type]} />
  <div class="min-w-0 flex-1">
    {
      title && (
        <strong class="mb-1 block font-mono text-xs uppercase tracking-[0.08em]">
          {title}
        </strong>
      )
    }
    <div class="callout-content text-current [&_a]:text-current! [&_a]:decoration-current [&_li::marker]:text-current! [&_ol]:text-current! [&_p]:text-current! [&_ul]:text-current!">
      <slot />
    </div>
  </div>
</aside>

<style>
  .callout-content > :global(:first-child) {
    margin-top: 0;
  }

  .callout-content > :global(:last-child) {
    margin-bottom: 0;
  }
</style>
