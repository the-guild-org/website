---
import organizationImage from "../../../../documentation/content/docs/schema-registry/get-started/org.png";
import projectImage from "../../../../documentation/content/docs/schema-registry/get-started/project.png";
import signupImage from "../../../../documentation/content/docs/schema-registry/get-started/signup.png";

interface Props {
  alt?: string;
  class?: string;
  className?: string;
  height?: number;
  src: string | URL | { height?: number; src: string; width?: number };
  width?: number;
  [key: string]: unknown;
}

const {
  class: className,
  className: reactClassName,
  src,
  width,
  height,
  ...props
} = Astro.props;
const legacyUrlImages = {
  "org.png": organizationImage,
  "project.png": projectImage,
  "signup.png": signupImage,
};
const urlMetadata =
  src instanceof URL
    ? legacyUrlImages[src.pathname.split("/").at(-1) as keyof typeof legacyUrlImages]
    : undefined;
const metadata =
  urlMetadata ??
  (typeof src === "object" && !(src instanceof URL) ? src : undefined);
const source = typeof src === "string" ? src : metadata?.src;
const imageWidth = width ?? metadata?.width;
const imageHeight = height ?? metadata?.height;
---

<img
  {...props}
  class:list={["docs-image", className, reactClassName]}
  src={source}
  width={imageWidth}
  height={imageHeight}
  loading="lazy"
/>
