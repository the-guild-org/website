<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <BaseHead
      description="Everything you need to scale your API infrastructure"
      title="The Ecosystem | Hive"
    />
  </head>
  <body class="text-green-1000 bg-white font-sans [color-scheme:light]">
    <SiteNavigation />
    <main class="light text-green-1000 mx-auto max-w-360 overflow-hidden px-4 [&>:not(header)]:px-4 lg:[&>:not(header)]:px-8 xl:[&>:not(header)]:px-[120px]">
      <header class="relative isolate flex max-w-360 flex-col items-center gap-6 overflow-visible rounded-3xl bg-blue-400 px-4 py-6 text-center sm:py-12 md:mx-2 md:gap-8 md:py-24 [&>h1]:max-w-[800px] [&>p]:max-w-[520px]">
        <span class="font-medium">The Ecosystem</span>
        <h1 class="group text-4xl leading-[1.2] md:text-[4rem] md:leading-[1.1875] tracking-[-0.64px]">
          Everything you need to scale your API infrastructure
        </h1>
        <p class="text-green-800">
          Enhance your GraphQL experience with advanced, modular solutions that can be adopted gradually as
          individual open source libraries or as a complete unified API platform.
        </p>

        <div class="-z-10 pointer-events-none absolute inset-0 overflow-hidden @container-[size] *:absolute">
          <svg class="-left-10 sm:max-md:-top-20 [@media(width<1128px)]:left-1/2 [@media(width<1128px)]:translate-x-[calc(-100%-40px)]" fill="none" height="228" viewBox="0 0 569 228" width="569" xmlns="http://www.w3.org/2000/svg">
