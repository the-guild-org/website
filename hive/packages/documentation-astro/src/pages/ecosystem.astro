              <a
                class="hive-focus ecosystem-nav-link outline-hidden focus-visible:ring-3 overflow-visible text-nowrap rounded-2xl px-4 py-3 font-medium text-green-800 transition hover:bg-white/10 hover:text-green-1000 focus:z-10 focus-visible:bg-white/10 focus-visible:text-green-1000 focus-visible:ring-inset sm:max-md:px-1 sm:py-5"
