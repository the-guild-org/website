        sections.map((section) => (
          <>
            <h2 class="group mb-4 mt-24 text-[32px]/[1.25] tracking-[-0.16px]" id={section.id}>
              {section.title}
            </h2>
            <p class="text-green-800">{section.description}</p>
            <ul class="mt-5 grid gap-5 p-4 last-of-type:mb-24 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
              {section.products.map((product) => (
                <ProductCard
                  decoration={product.decoration}
                  href={withBase(product.href)}
                  icon={product.icon}
                  isHive={product.isHive}
                  name={product.name}
                  title={product.title}
                  variant={product.variant}
                />
              ))}
            </ul>
          </>
        ))
      }

      <GotAnIdeaSection class="md:mx-2" />
    </main>

    <SiteFooter />

    <script>
      document.querySelectorAll<HTMLAnchorElement>("[data-contact-link]").forEach((link) => {
        link.addEventListener("click", (event) => {
          const crisp = (globalThis as typeof globalThis & {
            $crisp?: { push(args: unknown[]): void };
          }).$crisp;
          if (crisp) {
            crisp.push(["do", "chat:open"]);
            event.preventDefault();
          }
        });
      });

      const navLinks = document.querySelectorAll<HTMLAnchorElement>(".ecosystem-nav-link");
      navLinks.forEach((link) => {
        link.addEventListener("keydown", (event) => {
          if (event.key === "ArrowLeft") {
            const previousElement = link.previousElementSibling as HTMLElement | null;
            previousElement?.focus();
          } else if (event.key === "ArrowRight") {
            const nextElement = link.nextElementSibling as HTMLElement | null;
            nextElement?.focus();
          }
        });
      });
    </script>
