---
import NewsletterFormCard from "../../components/blog/NewsletterFormCard.astro";
import PostsByTag from "../../components/blog/PostsByTag.astro";
import BlogPageLayout from "../../layouts/BlogPageLayout.astro";
import { getBlogPosts } from "../../lib/get-blog-posts";

const posts = await getBlogPosts();
---

<BlogPageLayout description="Articles, product updates, and case studies from Hive Console." title="Hive Blog">
  <PostsByTag posts={posts}>
    <NewsletterFormCard />
  </PostsByTag>
</BlogPageLayout>
