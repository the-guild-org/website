---
import { guildMark } from './product-logos';

const projects = [
  ['Hive Console', 'https://the-guild.dev/graphql/hive'],
  ['Hive Router', 'https://github.com/graphql-hive/router'],
  ['Hive Gateway', 'https://the-guild.dev/graphql/hive/gateway'],
  ['Stellate', 'https://stellate.co'],
  ['Yoga', 'https://the-guild.dev/graphql/yoga-server'],
  ['Mesh', 'https://the-guild.dev/graphql/mesh'],
  ['GraphQL Codegen', 'https://the-guild.dev/graphql/codegen'],
  ['GraphQL Inspector', 'https://the-guild.dev/graphql/inspector'],
  ['SOFA', 'https://the-guild.dev/graphql/sofa-api'],
];

const socialLinks = [
  ['X', 'https://x.com/TheGuildDev'],
  ['Discord', 'https://discord.com/invite/xud7bH9'],
  ['LinkedIn', 'https://www.linkedin.com/company/the-guild-software/'],
  ['GitHub', 'https://github.com/the-guild-org'],
  [
    'YouTube',
    'https://www.youtube.com/watch?v=d_GBgH-L5c4&list=PLhCf3AUOg4PgQoY_A6xWDQ70yaNtPYtZd',
  ],
  ['GraphQL Weekly Newsletter', 'https://www.graphqlweekly.com'],
  ['Press Kit', '/logos'],
];
---

<footer class="mx-auto w-[calc(100%-24px)] max-w-shell pb-[60px] pt-12 sm:w-[calc(100%-40px)]">
  <div
    class="grid gap-10 border-b border-[var(--line)] pb-12 md:grid-cols-[minmax(220px,.7fr)_1.3fr]"
  >
    <div>
      <a
        href="/"
        class="inline-flex items-center gap-2 font-mono text-sm font-bold text-[var(--strong)]"
        ><svg
          aria-hidden="true"
          class="size-[18px] shrink-0"
          fill="currentColor"
          viewBox={guildMark.viewBox}
          xmlns="http://www.w3.org/2000/svg"
          set:html={guildMark.markup}
        />the-guild</a
      >
      <p class="mt-3 max-w-[300px] text-sm text-[var(--muted)]">
        Open-source GraphQL infrastructure, maintained for the long run.
      </p>
      <nav class="mt-6" aria-label="The Guild social media">
        <ul class="flex max-w-[300px] flex-wrap gap-x-4 gap-y-2">
          {
            socialLinks.map(([name, href]) => (
              <li>
                <a
                  class="font-mono text-[11px] text-[var(--muted)] underline-offset-4 transition-colors hover:text-[var(--strong)] hover:underline"
                  href={href}
                >
                  {name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
    <nav aria-label="The Guild projects">
      <div class="mb-4 font-mono text-[11px] tracking-[.075em] text-[var(--faint)]">~/projects</div>
      <ul class="grid grid-cols-2 gap-x-6 sm:grid-cols-3">
        {
          projects.map(([name, href]) => (
            <li class="border-t border-[var(--line)]">
              <a
                class="group flex items-center justify-between gap-3 py-3 font-mono text-xs text-[var(--muted)] transition-colors hover:text-[var(--strong)]"
                href={href}
              >
                {name}
                <span
                  aria-hidden="true"
                  class="text-[var(--faint)] transition-transform group-hover:translate-x-0.5"
                >
                  ↗
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div
    class="flex flex-wrap justify-between gap-[18px] pt-[30px] font-mono text-[11px] tracking-[.01em] text-[var(--faint)]"
  >
    <span class="inline-flex items-center gap-1.5"
      ><svg
        aria-hidden="true"
        class="size-3.5 shrink-0"
        fill="currentColor"
        viewBox={guildMark.viewBox}
        xmlns="http://www.w3.org/2000/svg"
        set:html={guildMark.markup}
      />© 2026 The Guild</span
    >
    <span>GraphQL infrastructure · since 2015</span>
  </div>
</footer>
